# 階段 3：幀間連結
# ==========================================================================

def angdiff180(a, b):
    """朝向差，考慮 180° 週期性。179° 和 1° 的差是 2°，不是 178°。"""
    d = np.abs(a - b) % 180.0
    return np.minimum(d, 180.0 - d)


class Tracker:
    """等速度預測 + 匈牙利全域最佳指派 + 斷鏈記憶。

    【為什麼不用貪婪最近鄰】
    顆粒 A 位移 d、鄰居 B 在距離 L 處。最壞情況 A 往 B 的舊位置移動，
    要讓最近鄰不配錯需要 d < L − d，即 d/L < 0.5。
    實測 56_1.mp4：最大幀間位移 14.5 px、間距 36 px → d/L = 0.40，貼近失效邊緣。
    （這個比值和解析度無關，只看 fps。240 fps 會降到 0.20。）
    全域最佳指派利用「所有顆粒一起移動」的連貫性來消除歧義，比貪婪穩健得多。

    【等速度預測】
    用 r̂(t+1) = r(t) + v(t)·Δt 當配對目標，有效位移從「真實位移」降到
    「加速度造成的殘差」，通常小一個數量級。對間歇流動特別有效。
    """

    def __init__(self, geom):
        self.geom = geom
        self.radius = SEARCH_RADIUS_RATIO * geom.b_px
        self.tracks = {}      # id -> dict(x, y, vx, vy, theta, missing, last_frame)
        self.next_id = 0
        self.rows = []

    def _predict(self, tr):
        if USE_PREDICTION:
            return tr["x"] + tr["vx"], tr["y"] + tr["vy"]
        return tr["x"], tr["y"]

    def step(self, frame_idx, dets):
        ids = list(self.tracks.keys())

        if ids and dets:
            pred = np.array([self._predict(self.tracks[i]) for i in ids])
            obs = np.array([[d["x"], d["y"]] for d in dets])
            # 代價 = 預測位置到觀測位置的平方距離
            cost = ((pred[:, None, :] - obs[None, :, :]) ** 2).sum(axis=2)

            if THETA_COST_WEIGHT > 0 and not self.geom.is_disc:
                th_t = np.array([self.tracks[i]["theta"] for i in ids])
                th_o = np.array([d["theta"] for d in dets])
                cost = cost + THETA_COST_WEIGHT * angdiff180(th_t[:, None], th_o[None, :]) ** 2

            BIG = 1e9
            cost = np.where(cost > self.radius ** 2, BIG, cost)
            ri, ci = linear_sum_assignment(cost)
            pairs = [(ids[a], b) for a, b in zip(ri, ci) if cost[a, b] < BIG]
        else:
            pairs = []

        matched_tracks = {p[0] for p in pairs}
        matched_dets = {p[1] for p in pairs}

        # --- 配對成功：更新 ---
        for tid, di in pairs:
            d, tr = dets[di], self.tracks[tid]
            nvx, nvy = d["x"] - tr["x"], d["y"] - tr["y"]
            # 速度用一點平滑，避免單幀雜訊污染下一幀的預測
            tr["vx"] = 0.5 * tr["vx"] + 0.5 * nvx
            tr["vy"] = 0.5 * tr["vy"] + 0.5 * nvy
            tr.update(x=d["x"], y=d["y"], theta=d["theta"], missing=0)
            self._emit(frame_idx, tid, d, interpolated=False)

        # --- 沒配到的軌跡：外推、計次，超過 MEMORY_FRAMES 就結束 ---
        for tid in ids:
            if tid in matched_tracks:
                continue
            tr = self.tracks[tid]
            tr["missing"] += 1
            if tr["missing"] > MEMORY_FRAMES:
                del self.tracks[tid]
            else:
                tr["x"], tr["y"] = self._predict(tr)

        # --- 沒配到的偵測：開新軌跡 ---
        for di, d in enumerate(dets):
            if di in matched_dets:
                continue
            tid = self.next_id
            self.next_id += 1
            self.tracks[tid] = dict(x=d["x"], y=d["y"], vx=0.0, vy=0.0,
                                    theta=d["theta"], missing=0)
            self._emit(frame_idx, tid, d, interpolated=False)

    def _emit(self, frame_idx, tid, d, interpolated):
        self.rows.append(dict(
            frame=frame_idx, id=tid,
            x_px=d["x"], y_px=d["y"],
            major_px=d["major"], minor_px=d["minor"],
            theta_deg=d["theta"], area_px=d["area"],
            label=d.get("label", -1),        # 分水嶺標籤：接觸網路要靠它對應回 id
            fill=d.get("fill", np.nan),
            # 匹配濾波響應：這顆的位置「擺得下一顆已知大小的顆粒」的程度，
            # 範圍 [−1, 1]。孤立顆粒 ≈1、堆積中 0.4-0.6、兩顆的腰部 ≈0.2。
            # 固定形狀路徑下，它取代 aspect_ratio 擔任形狀判準。
            mf_response=d.get("mf_response", np.nan),
            # 自由擬合量到的真實長寬比（只在 DETECT_USE_FREE_AR 時有值）。
            # 主線的 aspect_ratio 被鎖成 α，有資訊量的是這一欄。
            aspect_ratio_free=d.get("aspect_ratio_free", np.nan),
            # 自由擬合量到的朝向。主線（固定形狀）的 theta 在 α=1 時恆為 0，
            # 品質報告的「系統性變形檢查」只能用這一欄。
            theta_free_deg=d.get("theta_free", np.nan),
            # 期望可見面積 = 模型橢圓 ∩ 筒倉遮罩（px²）。
            # 完全在筒倉內的顆粒等於理論面積；貼壁的會小一些。
            area_expected_px=d.get("area_expected", np.nan),
            # area_ratio_corrected = 實際面積 / 期望可見面積。
            # 這一欄才是篩選真正用的判準值；底下的 area_ratio 是對「理論面積」
            # 的比值，留著當標定診斷（偏離 1.0 代表比例尺或 B_MM 不對）。
            area_ratio_corrected=d.get("area_ratio_corrected", np.nan),
            fit_residual=d.get("fit_residual", np.nan),
            refined=d.get("refined", False),
            interpolated=interpolated,
        ))


