def get_channel(bgr, which):
    if which == "gray":
        return cv2.cvtColor(bgr, cv2.COLOR_BGR2GRAY)
    if which == "lab_a":
        return cv2.cvtColor(bgr, cv2.COLOR_BGR2LAB)[:, :, 1]
    if which == "lab_b":
        return cv2.cvtColor(bgr, cv2.COLOR_BGR2LAB)[:, :, 2]
    if which == "hsv_v":
        return cv2.cvtColor(bgr, cv2.COLOR_BGR2HSV)[:, :, 2]
    raise ValueError(f"未知通道 {which}")


def binarize(ch, forced_threshold=None, mask=None):
    """回傳 (二值影像, 使用的閾值)。forced_threshold=None 時用 Otsu 自動決定。
    mask 限定「只看筒倉內部」，None = 整張都看。

    【Otsu 在做什麼】
    掃過每個可能的閾值 t，把像素分成暗群和亮群，計算類間變異數
        σ²_B(t) = ω₀(t)·ω₁(t)·[μ₀(t) − μ₁(t)]²
    取讓它最大的 t，也就是直方圖兩個峰之間的谷底。

    【為什麼不鎖定閾值】
    曾經考慮「第一幀決定後鎖死」，理由是 ω₀ω₁ 這一項會讓閾值隨前景面積漂移。
    但實測（56_1.mp4）推翻了這個做法：洩料過程中照明本身也在變，鎖定會在後段
    整個崩掉（量到的直徑變動 44%），自動 Otsu 反而只變動 3.3%。
    折衷做法是對閾值做時間中位數平滑，見 smooth_thresholds()。

    【為什麼 Otsu 只能拿筒倉內部的像素去算】
    不能把整張 ROI 丟給 Otsu，否則筒倉外面那一大片（黑背景板、反光）會主導門檻。
    也不要用「把外部塗成某個值」的取巧做法 —— 那在筒倉裝滿時剛好能用，一旦
    筒倉快排空、內部像素以背景為主，塗出來的值會落在背景那一側，Otsu 就會把
    「外部 vs 內部全部」切開，於是整個筒倉內部都被判成前景。這是只在特定填充率
    下才現形的失效，不會報錯，只會安靜地吐出 0 顆。
    """
    blur = cv2.GaussianBlur(ch, (5, 5), 0)
    if forced_threshold is None:
        vals = blur[mask > 0] if mask is not None else blur.ravel()
        if vals.size < 100:
            return np.zeros_like(blur), float(np.median(blur))
        t, _ = cv2.threshold(vals.reshape(-1, 1), 0, 255,
                             cv2.THRESH_BINARY + cv2.THRESH_OTSU)
    else:
        t = float(forced_threshold)
    bw = np.zeros_like(blur)
    bw[blur > t] = 255
    if mask is not None:
        bw[mask == 0] = 0
    return bw, float(t)


def segment(bw, geom, templates=None):
    """二值影像 → 分水嶺標籤圖。回傳 (labels, dist, cleaned, extra)。

    【2026-10-27 的改動】分水嶺本身沒有動，只換掉餵給它的「種子」。
    原本的種子來自距離變換上的 h-maxima，它判斷的是「邊界形狀有沒有一個夠深
    的凹陷」，而兩顆黏在一起時那個凹陷的深度是由壓縮雜訊決定的。新的種子來自
    匹配濾波，判斷的是「這裡擺不擺得下一顆已知大小的顆粒」，判據從經驗參數
    換成設計值。extra 裡會帶回響應圖與朝向圖，供 fit_fixed_shape() 使用。

    【為什麼用 h-maxima 而不是固定門檻】
    圓盤的距離轉換是單峰錐形，峰值 = 短半軸；
    橢圓的距離轉換是沿長軸的「脊線」，峰值一樣 = 短半軸但沿長軸是平的。
    固定門檻 ρ×R 對這兩種地形需要完全不同的 ρ；h-maxima 只看「相對隆起高度」，
    對兩者一視同仁 —— 這是能同時通吃 α = 1.0 到 3.5 的關鍵。
    同一顆橢圓的脊線若離散化後斷成兩段，中間鞍點很淺，會被 h-maxima 自動合併。
    """
    k = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (MORPH_KERNEL, MORPH_KERNEL))
    cleaned = cv2.morphologyEx(bw, cv2.MORPH_OPEN, k, iterations=1)
    dist = cv2.distanceTransform(cleaned, cv2.DIST_L2, 5)

    if SEED_METHOD == "matched":
        # 新路徑：種子由匹配濾波決定（見設定區的長篇說明）。
        # 分水嶺本身留著不動 —— 它從來不是問題所在，問題出在餵給它的種子。
        # 換掉種子之後，同一個分水嶺就會切在正確的位置，而且下游的
        # build_contacts(labels) 完全不用改。
        pk, resp, ang = matched_filter_seeds(cleaned, geom, templates)
        seed_img = np.zeros(cleaned.shape, np.uint8)
        for (sy, sx) in pk:
            seed_img[int(sy), int(sx)] = 1
        _, markers = cv2.connectedComponents(seed_img)
        extra = dict(peaks=pk, response=resp, angle=ang)
    else:
        # 舊路徑：h-maxima。保留只為了 A/B 對照。
        seeds = h_maxima(dist, H_MAXIMA_RATIO * geom.rb)
        _, markers = cv2.connectedComponents(seeds.astype(np.uint8))
        extra = dict(peaks=None, response=None, angle=None)

    labels = watershed(-dist, markers, mask=(cleaned > 0))
    return labels, dist, cleaned, extra


