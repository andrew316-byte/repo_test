# -*- coding: utf-8 -*-
"""
程式一：顆粒偵測 + 追蹤 + 接觸網路 + 筒倉幾何
==========================================================================
以 particle_tracking.py 為底，加上力鏈分析所需的筒倉幾何。
力鏈（鏈與拱）的搜尋在程式二 silo_chains.py，這支只負責把資料備齊。

輸入：筒倉洩料影片
輸出：
  detections.csv     每顆顆粒在每一幀的位置、形狀、朝向、速度、觸壁判定
  contacts.csv       接觸網路（以追蹤 id 表示，程式二直接吃）
  angles_phi.csv     接觸三元組的 θ / φ
  frames.csv         每幀的狀態：流動 / 靜止 / 偵測失效、是否可用、筒倉內顆粒數
  avalanches.csv     每次 avalanche 的流出顆粒數 s，以及 P_c = 1/<s>
  qc_shape.csv       品保通道：自由 fitEllipse 量到的真實形狀（不進分析）
  tracks_summary.csv / frame_quality.csv    原有的軌跡與品質統計
  geometry.json      壁線標定與自動校正結果
  calib_check_*.png  標定檢查圖（務必看一眼）
  tracking_overlay.mp4   追蹤疊圖影片

階段
  階段 0  幾何標定    滑鼠點四個點定出左右壁與出口；之後重跑會直接讀 geometry.json
  階段 1  逐幀偵測    LAB-b → Otsu（時間平滑）→ 開運算 → 距離轉換 → h-maxima
                      → 分水嶺 → fitEllipse，全程限制在筒倉內部遮罩裡
  階段 2  次像素精化  灰階模型擬合（預設關閉，實測只改善 18% 但慢 100 倍）
  階段 3  幀間連結    等速度預測 + 匈牙利全域最佳指派 + 斷鏈記憶
  階段 4  後處理      朝向 unwrap、Savitzky-Golay 速度
  階段 5  筒倉幾何    壁線自動校正 → 壁接觸判定 → 物理座標（原點在出口中點）
  階段 6  流動狀態    流動/靜止分類、偵測失效幀排除、avalanche 真偽判定
  階段 7  輸出        CSV、標定檢查圖、疊圖影片

用法
  python silo_tracking.py                      # 用下面的設定跑
  python silo_tracking.py --preview            # 只跑前 60 幀
  python silo_tracking.py --video other.mp4
  python silo_tracking.py --recalib            # 強制重新標定壁線
"""

import argparse
import json
import os
import sys
import time

import cv2
import numpy as np
import pandas as pd
from scipy.optimize import linear_sum_assignment, least_squares
from scipy.spatial import cKDTree

try:
    from skimage.morphology import h_maxima
    from skimage.segmentation import watershed
except ImportError:
    sys.exit("需要 scikit-image：pip install scikit-image")


# ==========================================================================
# 設定：所有要調的東西都在這一區
# ==========================================================================

VIDEO_PATH = "IMG_9756.MP4"
OUT_DIR = "silo_out"

# ---------- 物理量：程式的所有像素參數都從這三個數字推導 ----------
B_MM = 9.4           # 顆粒短軸（mm）。α=1 的圓盤就是直徑。
                     # 2026-10-28 卡尺重量：平均 9.4（個別分布在 9.2–10 之間）。
                     # 【這是整個程式唯一的長度基準】所有像素尺寸都從它推導：
                     #   b_px = B_MM × px_per_mm      短軸（px）
                     #   a_px = ALPHA × b_px          長軸（px）
                     #   area = π·a_px·b_px/4         理論面積（px²）
                     # 牽動到：匹配濾波模板大小、最小種子間距、面積判準的分母、
                     # 固定形狀擬合鎖死的 a/b、追蹤搜尋半徑、壁接觸的支撐函數、
                     # 分析窗高度。改錯這一個，上面全部跟著錯。
                     # 【多分散性】實際顆粒 9.2–10 mm（±4% 直徑 = ±8% 面積），
                     # 但一律當成 9.4 處理（2026-10-28 定案）。±8% 落在面積判準
                     # 的 ±25% 窗內，不會誤篩。
ALPHA = 1.0          # 長寬比 α = 長軸/短軸
PX_PER_MM = None     # 比例尺（px/mm）。None = 用兩顆螺絲量（建議，見下面的
                     # 「比例尺標定：兩顆螺絲」設定區）。
                     # 填數字就直接用那個值，完全跳過螺絲標定。
                     # 【2026-10-28 改動】舊版的 None 是「用距離變換 99 百分位
                     # 自動估」，那個方法數學上必然低估 10%，已整段刪除。

FPS = None           # 拍攝幀率。None = 從容器 metadata 讀。
                     # 【慢動作影片要手動填】例如 120 fps 拍、輸出成 30 fps 播放的
                     # 4x 慢動作，容器會寫 30，但速度換算必須用 120。
                     # 這個數字錯了，所有速度會系統性差一個倍率且不會報錯。
                     # iPhone 原生 120fps 檔的容器就寫 120，填 None 即可。
FPS_VERIFIED = False # 未經自由落下測試驗證 → 輸出的 mm/s 會標註為未驗證

# ---------- 筒倉幾何 ----------------------------------------------------
# 【這一區是力鏈分析的命脈】
# 壁接觸是一個硬門檻（圓盤約 1.15 × 半徑）。壁線只要偏半個顆粒半徑，貼著壁的
# 顆粒就會整片被判成「不觸壁」，程式二一條鏈都找不到 —— 而且全程不會有任何
# 錯誤訊息，只會安靜地輸出空結果。所以一定要看 calib_check_*.png。
OUTLET_WIDTH_MM = 32.6     # 用尺量到的出口淨寬。只用來核對標定，不參與計算。
WALL_HALF_ANGLE_DEG = 30.0 # 筒倉半角（全開口角 60° 的一半）。
                           # 力鏈的邊界角 θ0 = +此值、θn = −此值（程式二用）。

DETECT_HEIGHT_FACTOR = None   # 偵測範圍的高度上限：出口上方幾個顆粒直徑以內。
                              # None = 不設上限，整個 ROI 高度都偵測（建議）。
                              # 【2026-10-28 從 8.0 改成 None 的原因】
                              # A12 要用「ROI 內的顆粒數減少量」當流出顆粒數，
                              # 那就必須數到所有顆粒。舊的 8.0 會把出口上方
                              # 8 d_eq（約 75 mm）以外的顆粒全部排除在偵測之外，
                              # 顆粒數就不是總數了，減少量也不等於流出數。
                              # 要恢復舊行為就填一個數字。
ANALYSIS_HEIGHT_FACTOR = 4.0  # 分析窗：Zhang 的 4d 區域（只打標記，不影響偵測）

MASK_MARGIN_RATIO = 0.60   # 筒倉內部遮罩往壁外放寬幾個顆粒直徑。
                           # 遮罩若正好切在壁線上，貼著壁的顆粒會被削掉一半，
                           # 面積變小、形狀變怪而被篩選丟掉 —— 而那正是找鏈最
                           # 需要的那些顆粒。壁外是深色壓克力，放寬不會引入雜訊。
OUTLET_MARGIN_RATIO = 0.60 # 出口線以下也放寬幾個顆粒直徑。
                           # 同理：質心在 y≈0 的顆粒會被切掉下半邊。
                           # 實測不放寬時出口上方 0–0.5 d 的顆粒少了約 40%，
                           # 而拱就在那裡。質心仍在 y<0 的顆粒後面會被濾掉。

# ---------- 壁線自動校正 ------------------------------------------------
# 原理：貼著壁的顆粒，質心到壁的垂直距離應該剛好等於它的支撐函數值。
# 對每顆算殘差 r =（量到的距離）−（理論值），殘差分布的下緣就是壁線的誤差。
# 這等於「拿顆粒當尺去量壁在哪裡」，會自動把透視與鏡頭畸變一起吸收掉。
AUTO_REFINE_WALLS   = True
REFINE_N_BANDS      = 12   # 高度切成幾層分別估，組成校正剖面
                           # 【為什麼是剖面不是直線】壁在影像上不是直線：相機
                           # 不正對筒倉平面、前後兩片壓克力投影位置不同、加上
                           # 鏡頭畸變。實測偏離直線 RMS 1.1 mm，用直線硬擬合會
                           # 變成有些高度偏內、有些偏外，觸壁顆粒數隨高度交替塌陷。
REFINE_MIN_PER_BAND = 200  # 每層至少要有幾顆才採用
REFINE_QUANTILE     = 0.02 # 取殘差的第幾分位當「下緣」（不用最小值，避免雜訊）
REFINE_MIN_TAIL     = 3    # 分位數至少取到第幾小的值，避免小樣本退化成取最小值
REFINE_OUTLIER_MM   = 2.0  # 某層偏離鄰近各層趨勢超過這麼多就剔除。
                           # 這個方法的前提是「每層都有顆粒真的貼著壁」。某個
                           # 高度若因為幾何台階或堆積構型而碰不到壁，估出來的
                           # 壁會偏外很多。實測曾有一層同時跳出 +8.5/+9.5 mm，
                           # 而上下相鄰層都在 ±1 mm 內。壁可以彎，但不會在一個
                           # 顆粒直徑的高度內凹進去又凸回來。

WALL_CONTACT_FACTOR = 1.15 # 觸壁門檻 = 此值 × 支撐函數。略大於 1 是為了容忍
                           # 質心量測誤差。
WALL_CONTACT_MODE   = "support"   # "support" = 支撐函數（對橢圓才正確）
                                  # "radius"  = 固定半徑，只供敏感度對照
WALL_RADIUS_MM      = None        # "radius" 模式用；None = 取等效半徑

# ---------- 流動 / 靜止 / avalanche -------------------------------------
# 【指標】流動程度的量化方式，兩種：
#   "motion"（建議）= 分析窗內「逐幀位移 > MOTION_PX 的顆粒數」佔該窗顆粒數的
#                     比例，直接從追蹤結果算。不碰像素，所以對壓縮雜訊免疫。
#   "pixdiff"（舊） = 分析窗內逐幀灰階平均絕對差。
# 【為什麼要換】9756 實測舊指標：static 幀最大 1.997、flow 幀最小 2.009，兩群
# 在門檻 2.0 處完全貼住沒有間隙，628/912 幀（69%）擠在 1.0-4.0 之間。結果是
# 狀態翻轉 59 次、其中 15 次是孤立單幀 —— 壓縮雜訊抖過門檻就翻一次。
FLOW_METRIC = "motion"
MOTION_PX = 1.0            # "motion" 指標裡「這顆算有在動」的位移門檻（px）
                           # 取 1.0 的理由：靜止幀的質心雜訊 σ_c ≈ 0.09 px，
                           # 1.0 px 是 11 σ，純雜訊不可能跨過。
MOTION_MIN_TRACK = 20      # 流動指標只統計軌跡長度 ≥ 此值（幀）的顆粒。
                           # 【為什麼】手伸進畫面是突然出現又消失，軌跡很短，
                           # 會被當成「在動的顆粒」而誤觸發 flow。真顆粒的軌跡
                           # 很長（實測 97.3% 的量測來自 ≥100 幀的軌跡），
                           # 所以用長度就能把手篩掉。螺絲是靜止的，不影響。

# 【遲滯（hysteresis）】單門檻在門檻附近必定抖動，這是門檻法的通病，不是資料的
# 問題。改成雙門檻：高於 HI 才進 flow、低於 LO 才回 static、中間維持原狀。
# 這樣一個單幀的雜訊尖峰不會造成 flow→static→flow 的來回翻轉。
# 【注意這是操作型判定準則，不是物理定律】「流動 vs 靜止」在物理上是連續的，
# 下面這兩個數字沒有物理意義，只是把連續量切成兩類的操作定義。
FLOW_HI = 0.08             # "motion": 超過 8% 的顆粒在動 → 進入 flow
FLOW_LO = 0.03             # "motion": 低於 3% 的顆粒在動 → 回到 static
FLOW_DIFF_THRESHOLD = 2.0  # "pixdiff" 專用的單門檻（舊行為，保留供 A/B 對照）
FLOW_DIFF_HI = 2.5         # "pixdiff" 的遲滯上門檻
FLOW_DIFF_LO = 1.5         # "pixdiff" 的遲滯下門檻
BURST_TRIM_FRAMES   = 2    # 每段流動的頭尾各丟幾幀（剛啟動時速度未進入穩態）
BURST_MIN_FRAMES    = 3    # 修剪後短於此長度的流動段丟棄
COUNT_RISE_WARN = 3        # ROI 內的顆粒數比先前的最低點高出這麼多顆 → 警告。
                           # 顆粒數理應只減不增（顆粒只會從出口流走）。上升
                           # 只可能是中途補料，或 ROI 上緣框太低讓框外的顆粒
                           # 掉進畫面。兩種情況下 A12 的「減少量 = 流出數」
                           # 都不成立。取 3 是留給偵測雜訊的餘裕
                           # （實測顆數幀間跳動中位 0 顆、95 百分位 2 顆）。
MIN_DISCHARGE_PARTICLES = 3.0  # 一段流動要真的流出這麼多顆才算一次 avalanche
                           # 【為什麼需要】逐幀差分只看得到「畫面有沒有在動」，
                           # 分不出「顆粒真的流出去」和「料堆沉降 / 有人碰到筒倉 /
                           # 拿棒子戳拱」。實測 IMG_9756 差分抓到 6 段流動，實際
                           # 只有 1 段流出 32 顆，其餘五段是 −0.7 ~ +1.4 顆（等於沒流），
                           # 和使用者「只破了一次拱」的說法一致。
OCCLUSION_MIN_RATIO = 0.40 # 某幀顆粒數低於全片中位數的此倍數 → 判定偵測失效
                           # 原因可能是手遮鏡頭、動態模糊糊成一片、或筒倉排空，
                           # 程式分不出是哪一種，會印出區間請你回去看影片。
OCCLUSION_DILATE    = 2    # 失效幀前後各再多排除幾幀

# ---------- 比例尺標定：兩顆螺絲 -----------------------------------------
# 【為什麼改用螺絲】
# 舊做法是取「距離變換在前景像素上的 99 百分位」當短半軸。這在數學上必然低估：
# 對半徑 R 的圓盤，距離變換值 ≥ r 的像素佔比是 ((R−r)/R)²，令它等於 1% 解得
# r = 0.9R —— 99 百分位只有真實半徑的九成，所以比例尺固定低估 10%。
# 實測 9756：舊法 7.527 px/mm，三個獨立交叉檢查（顆粒面積、接觸距離、螺絲間距）
# 都指向 8.2–8.5，低估 9–12%。而且這個誤差會安靜地傳到壁接觸判定，讓鏈抓不到。
#
# 【螺絲法為什麼好】
# 兩顆螺絲是剛性固定的已知距離。用「兩點間距」而不是「單一物件的大小」，
# 相機微震和壓縮雜訊是共模的，相減就抵銷掉。
# 實測 9756：兩顆螺絲各自的位置幀間抖動 1.2–1.4 px，但「間距」只抖 0.45 px，
# 對應比例尺不確定度 ±0.11%。推回去的出口寬度 32.47 mm，你卡尺量 32.6 mm，
# 吻合到 0.4%。
SCREW_DISTANCE_MM = 49.4   # 兩顆螺絲十字中心的實際距離（卡尺量的）
                           # 【螺絲被移動時要改這裡】右螺絲裝在可動壁的長孔上，
                           # 如果調整了出口寬度 D，這個距離就會變，要重量並
                           # 同時把 SCREW_RECLICK 設成 True 跑一次。
SCREW_RECLICK = False      # True = 強制重新點螺絲位置（會覆寫 geometry.json）
SCREW_TEMPLATE_HALF = 45   # 以你點的位置為中心，切 (2×此值)² px 的模板
                           # 45 → 90×90 px，比螺絲頭（約 67 px）略大，
                           # 讓模板含一點周圍背景，互相關才有鑑別力
SCREW_SEARCH_WIN = 90      # 每幀在初始位置 ±此值 的範圍內重新定位（px）
SCREW_N_SAMPLE = 30        # 取樣幾幀來量間距，取中位數
                           # 中位數免疫單幀失誤；30 幀已經遠超過需要
SCREW_DRIFT_WARN = 0.01    # 某幀的間距偏離中位數超過此比例 → 警告
                           # 代表相機被碰到或螺絲鬆了

# ---------- ROI：分析範圍 -------------------------------------------------
# 【為什麼改成手動框】
# 舊做法由筒倉幾何自動推導，結果畫面被縮得太小。而且 A12 要用「ROI 內的顆粒數」
# 當流出顆粒數，那就必須由你親自確認「所有顆粒都在框內」—— 程式沒辦法替你判斷
# 料堆最高的時候到哪裡。
#
# 【你框的時候要注意】
#   上緣：要高過料堆最高時的自由表面（看影片最開頭那一幀決定）
#   下緣：切在出口線，或略低一點點。出口以下完全不看 → 手和螺絲自動排除
#   左右：比筒倉壁寬一些，不要切到壁
# 框好會存進 geometry.json，之後重跑直接讀檔。
ROI = None                 # None = 跳視窗讓你框（建議）
                           # 也可以直接填 (x0, y0, x1, y1) 寫死
ROI_RESELECT = False       # True = 強制重新框 ROI

# ---------- 偵測 ----------
CHANNEL = "lab_b"        # "lab_b" | "gray" | "lab_a" | "hsv_v"
                         # 實測 LAB-b 最佳（dist/r=1.10，不會過度分割）
MORPH_KERNEL = 3         # 開運算核大小。要小，3 最好，9 會把顆粒間的縫填掉。
H_MAXIMA_RATIO = 0.25    # 舊的 h-maxima 種子法的參數，現在只在
                         # SEED_METHOD = "hmax" 時才用得到。見下面的種子區。
AREA_MIN_RATIO = 0.40    # 面積下限 = 比例 × 理論面積
AREA_MAX_RATIO = 2.00
FILL_RATIO_MIN = None    # 【2026-10-27 停用】實際面積 / 擬合橢圓面積 的下限。
                         # 停用理由：分母的橢圓是「擬合給這塊區域的」，區域變形
                         # 橢圓就跟著變形，兩者永遠貼在一起。實測橢圓面積/輪廓
                         # 面積 = 0.982（10-90 百分位 0.979-1.053），幾乎是定值。
                         # 月牙碎片的 fill 中位數 0.922、正常顆粒 1.019，兩組的
                         # 最小值 0.649 / 0.629 完全重疊，分不開。原本設 0.60 的
                         # 結果是擋掉 0 筆（全體最小 0.629），等於沒作用。
                         # fill 仍然照常輸出到 CSV 當診斷欄位，只是不再拿來擋。
                         # 設成 None = 不篩選；要恢復舊行為就填一個數字。
OTSU_SMOOTH_FRAMES = 31  # Otsu 閾值的時間中位數平滑視窗（奇數，0 = 不平滑）
                         # 保留真實照明漂移，壓掉幀間抖動

# ---------- 偵測的篩選判準（取代 fill）----------------------------------
# 兩個判準抓的是不同的失敗，必須並用：
#   area_ratio   = 區域面積 / 理論面積（π·a·b/4）。分母是設計值常數，不隨偵測
#                  結果浮動，所以抓得到「兩顆沒切開」（~1.8）和「一顆切成兩半」
#                  （~0.5）。這是 fill 做不到的。
#   aspect_ratio = 自由擬合的長軸/短軸。抓得到「月牙碎片」（~1.96）和
#                  「切成一大一小的那塊大的」（~1.5），但抓不到合併。
# 實測在 9756 上：area_ratio 判準抓 8506 筆、aspect_ratio 判準抓 10286 筆、
# 聯集 14206 筆 / 59685（23.8%）—— 聯集遠大於任一個，證實兩者抓的是不同子集。
DETECT_AREA_LO = 0.75      # area_ratio 下限
DETECT_AREA_HI = 1.25      # area_ratio 上限
DETECT_AR_DEV  = 0.25      # |aspect_ratio − α| 的上限。取 0.25 的理由同
                           # AR_DEV_THRESHOLD：實驗的 α 間距是 0.5，偏差超過
                           # 半個間距就等於會被誤分到隔壁的 α。
AREA_RATIO_WARN = 0.05     # area_ratio（區域面積 ÷ 理論面積）的中位數偏離 1.0
                           # 超過此比例就警告。這是標定出錯的第一道防線：
                           # 分母是「B_MM × 比例尺」算出來的外部常數，所以
                           # 偏離 1.0 代表那兩個數字有一個不對。
DETECT_AREA_FLOOR = 0.20   # 絕對面積下限 = 此值 × 理論面積。低於此值一律丟掉。
                           # 擋的是退化的碎屑（實測看過只有理論面積 0–1% 的
                           # 區域）。0.20 代表顆粒至少要有五分之一露在遮罩內，
                           # 不然它的質心位置本來就不可信。
DETECT_USE_FREE_AR = True  # 每一幀都額外跑一次「自由」fitEllipse，拿它的
                           # aspect_ratio 當篩選判準。
                           # 【為什麼要額外跑】主線把 a、b 鎖成設計值，所以主線
                           # 的 aspect_ratio 恆等於 α、不能拿來篩。要保留形狀
                           # 判準就得另外量一次真實形狀。
                           # 【成本】自由擬合是跑在「已經切好的分割區域」上，
                           # 只是多一次 findContours + fitEllipse，每顆幾十微秒，
                           # 每幀約 2-3 ms。設 False 可以省掉，改成只有品保幀才
                           # 量，但那樣就只剩 area_ratio 一個判準。

# ---------- 種子偵測：匹配濾波（matched filter）-------------------------
# 【為什麼換掉 h-maxima】
# h-maxima 是在距離變換上問「這個邊界形狀有沒有一個夠深的凹陷」。兩顆黏在一起
# 的啞鈴形，中間是一道淺鞍部，鞍部深度取決於那一幀閾值外擴了幾個 pixel，而那
# 取決於壓縮雜訊 —— 所以種子的存在與否是由雜訊決定的，不是由物理決定的。
# 實測後果（9756）：area_ratio<0.7 的碎片 3776 筆、1.3-2.0 的合併 4730 筆，
# 而這兩組的質心逐幀位移 p95 是 16-17 px，正常組只有 2.8 px。
#
# 【匹配濾波在做什麼】
# 訊號處理的古典結果：要在雜訊中找一個「形狀已知」的訊號，最佳線性偵測器就是
# 拿已知形狀當模板跟資料做相關：
#     R(x) = Σ_u K(u) · I(x + u)
#   x = 影像位置，u = 模板內的相對座標，K = 模板，I = 影像（這裡用二值遮罩）
# 模板做成「內圈正、外環負、總和為零」：
#     K = +1/A_in   橢圓內
#         −1/A_out  外環（半軸放大 β 倍的橢圓，扣掉內圈）
#         0         其餘
# 零均值這個性質是關鍵：
#   · 正好蓋住一顆     → 內圈全前景、外環大多背景 → R 大
#   · 落在兩顆的腰部   → 內圈前景、外環也大多前景 → 正負抵銷 → R 小
#   · 落在大片均勻前景 → R ≈ 0
# 因為用二值遮罩當輸入，R 的物理意義就是
#     R = (內圈的前景佔比) − (外環的前景佔比)，範圍 [−1, 1]
# 孤立顆粒 R ≈ 1；堆積中接觸鄰居的顆粒 R 約 0.4-0.6；腰部 R 約 0.2。
#
# 【判據的性質變了】
# h-maxima 的 h = 0.25 × 短半軸是我拍的「經驗法則」，沒有物理依據。
# 匹配濾波的模板半軸是「量得到的設計值」。把靠經驗參數決定的判據換成靠物理量
# 決定的判據，故障模式就從「隨雜訊浮動」變成「由設計值鎖定」—— 這才是這個
# 改動真正的價值，不是演算法比較新。
SEED_METHOD = "matched"    # "matched" = 匹配濾波（建議）｜"hmax" = 舊的 h-maxima
                           # 保留 "hmax" 只為了讓你能 A/B 對照，不建議常用。
MF_ANNULUS_RATIO = 1.30    # 外環的外半軸 = 此值 × 顆粒半軸（β）
                           # 太小（<1.15）外環太窄沒有鑑別力；
                           # 太大（>1.5）外環會涵蓋到鄰居的中心，反而壓低真峰。
MF_MIN_RESPONSE = 0.12     # 響應下限。低於此值不視為種子。
                           # 這是個寬鬆的防呆下界，真正起作用的是下面的最小間距。
MF_MIN_SEP_RATIO = 0.85    # 最小種子間距 = 此值 × 等效直徑 d_eq
                           # 【這是物理約束，不是經驗參數】單分散剛體的兩個質心
                           # 不可能靠得比 d 更近（9756 實測接觸距離中位數
                           # 1.094 d）。取 0.85 是留 15% 餘裕給量測誤差。
                           # 這一條直接消滅「一顆被切成兩塊」的故障模式；
                           # 零均值模板消滅「兩顆合併成一塊」。兩個方向都堵住。
MF_ANGLE_STEP_DEG = 10.0   # α > 1 時模板庫的朝向間隔（度）。α = 1 只用 1 個模板。
                           # 18 個模板用 FFT 相關大約每幀多 150 ms；如果嫌慢，
                           # 放寬到 15 或 20 度，次像素精化會把角度補回來。
MF_SUBPIXEL = True         # 對響應峰做拋物線內插取得次像素位置與朝向。
                           # 見 fit_fixed_shape() 的說明。

# ---------- 固定形狀擬合 ------------------------------------------------
# 【為什麼不再用自由的 cv2.fitEllipse】
# fitEllipse 有 5 個自由度 (x, y, a, b, θ)，但 a 和 b 是你訂製顆粒時的「設計值」，
# 是已知的，不是待量的。多出來的兩個自由度沒有帶來資訊，只帶來故障：
# 擬合橢圓的面積被輪廓面積綁死（a·b 幾乎固定），但 a 與 b 之間怎麼分配是自由的，
# 於是分割一失敗，a 被拉長、b 被壓扁，乘積不變。把 log a、log b 拆成
#     尺寸模態 u = (log a + log b)/2，形狀模態 v = log a − log b
# 實測 Var(v) = 0.04432 是 Var(u) = 0.00856 的 5.2 倍 —— 誤差幾乎全在形狀模態。
# 鎖住 a、b 就是把 v 這個自由度直接拿掉，分割的面積誤差沒有管道轉成形狀誤差。
#
# 【那還怎麼檢查加工精度和分割成敗】
# 靠下面的品保通道（QC）。主線鎖形狀、品保線放形狀，兩邊都有。
FIXED_SHAPE = True         # True = 主線用固定 a,b 的擬合（α=1 時只有 x,y 兩個
                           #        自由度；α>1 時是 x,y,θ 三個）
                           # False = 退回舊的自由 fitEllipse（A/B 對照用）

# ---------- 品保通道（QC）----------------------------------------------
# 每隔 QC_INTERVAL 幀，對同一批分割區域「另外」跑一次自由 fitEllipse，把量到的
# 長短軸與長寬比存進 qc_shape.csv。這條線不進任何分析，純粹是體溫計。
#
# 【QC_INTERVAL = 20 是怎麼定出來的】三個限制從不同方向夾住它：
#  (1) 下界｜去相關時間：兩幀之間顆粒若幾乎沒動，第二幀量的是同一批顆粒在同一
#      位置，分割成敗高度相關，等於白跑。9756 實測 flow 幀速度 p75 = 4.88
#      px/frame、p95 = 14.93 px/frame，移動一顆直徑（71.5 px）分別要 15 幀和
#      4.8 幀 → 取樣間隔要 ≥ 15 幀才算獨立樣本。
#  (2) 下界｜每個時間分箱的樣本數：要讓長寬比中位數有 ±0.5% 精度，
#          SE_median ≈ 1.25 · MAD / √N ≤ 0.005
#      MAD 實測 0.033 → N ≥ (1.25×0.033/0.005)² ≈ 68 顆 ≈ 2 幀（每幀 65 顆）。
#      要 1 秒（120 幀）的時間分辨率、留 3 倍餘裕 → 間隔 ≤ 20 幀。
#  (3) 上界｜成本：自由 fitEllipse 跑在既有的分割區域上，每顆只多幾十微秒，
#      每 20 幀一次的額外成本 < 1%。
#  三者在 15-20 之間只剩一個窄窗，20 同時滿足：每秒 6 個取樣點、彼此獨立
#  （20 > 15）、每秒 390 筆量測（遠超過需要的 68）。
#  改幀率或影片長度時，照上面三條重算。
QC_INTERVAL = 20           # 0 = 關閉品保通道

# ---------- 次像素精化（預設關閉）----------
SUBPIXEL = False         # 實測在真實影片上只把 σ_c 從 0.114 降到 0.093 px（18%），
                         # 但每顆每幀要跑一次最佳化，慢約 100 倍。
                         # 要降雜訊，優先提高 px/mm 和用 SG 平滑微分。
SUBPIX_PATCH = 26        # 擬合用的鄰域半徑（px）
SUBPIX_MAX_SHIFT = 4.0   # 擬合結果偏離初始猜測超過這個距離就捨棄，退回 fitEllipse

# ---------- 幀間連結 ----------
SEARCH_RADIUS_RATIO = 0.60   # 搜尋半徑 = 比例 × 短軸(px)
                             # 【判準】最大幀間位移 / 顆粒間距 必須 < 0.5，
                             # 否則最近鄰一定會配錯。實測這支影片是 0.40（120fps），
                             # 偏高但有等速度預測撐著；240 fps 會降到 0.20。
USE_PREDICTION = True        # 用上一幀的速度預測位置再配對。
                             # 間歇流動（堵塞期 v=0、雪崩期 v 連貫）特別有效。
THETA_COST_WEIGHT = 0.0      # 朝向差進入代價函數的權重（px² per deg²）
                             # α=1 時朝向無意義，設 0。α>1 時建議 0.02 起調。
MEMORY_FRAMES = 3            # 顆粒暫時偵測不到時，保留幾幀仍參與配對
MIN_TRACK_LENGTH = 5         # 短於這個長度的軌跡視為雜訊，輸出時標記

# ---------- 後處理 ----------
VELOCITY_METHOD = "theilsen"   # "theilsen"（建議）｜"sg"（舊的 Savitzky-Golay）
# 【為什麼從 Savitzky-Golay 換成 Theil-Sen】
# SG 是最小平方擬合後取導數，而最小平方對離群點的權重是平方級的。9756 實測
# 靜止幀的逐幀質心位移中位數 0.214 px（正常），但 p95 是 3.65 px、最大 35.3 px
# （= 4.7 mm，半顆顆粒），542 條軌跡裡有 476 條出現過 >10 px 的跳動。這不是
# 高斯雜訊（高斯的 p95 只會是中位數的 3 倍，不是 17 倍），是分割失敗造成的
# 離群點。一個 20 px 的跳動會污染整個 SG 視窗 —— 品質報告裡「SG 速度最大值
# 58.34 px/frame > 實際連結位移 27.81 px/frame」就是這個過衝。
# 而且它會系統性高估 P(v) 的尾巴，直接污染 Zhang 分解式
#     P_c = p_chain · ∫ p_a/c(v) · P(v) dv
# 裡的第三條路徑（P(v) 分布本身的位移）。
#
# Theil-Sen 的斜率是「所有點對的斜率取中位數」：
#     slope = median_{i<j} (y_j − y_i) / (t_j − t_i)
# 中位數的崩潰點是 50%（要污染它得有一半以上的點是壞的），最小平方是 0%
# （一個壞點就夠）。視窗 5 點 = 10 個點對，取中位數，單一離群點影響為零。
VEL_WINDOW = 5           # 速度視窗（奇數幀），兩種方法共用。
                         # δt = 0.018 s × FPS 幀；視窗要明顯小於 δt 才不會抹掉
                         # 訊號。120 fps → δt = 2.2 幀（視窗 5 已經偏大）
                         # 240 fps → δt = 4.3 幀（視窗 5 剛好）
VEL_ONLY_CLEAN = True    # 只用品質旗標乾淨的幀算速度（壞幀的位置先設成 NaN，
                         # 由 Theil-Sen 的點對自動略過），避免拿失敗的質心算速度。
SG_WINDOW = VEL_WINDOW   # 舊名保留，供 VELOCITY_METHOD = "sg" 使用
SG_ORDER = 2
AR_CIRCLE_THRESHOLD = 1.15   # 量到的長寬比低於此值 → 視為圓盤，朝向輸出 NaN

# ---------- 品質指標 ----------
# 形狀異常的判準：|量到的長寬比 − α| ≥ 這個值
# 取 0.25 的理由：實驗的 α 間距是 0.5（1.0, 1.5, 2.0, …），偏差超過半個間距
# 就等於這顆會被誤分到隔壁的 α，是有物理意義的門檻。
# 這個寫法自動適用所有 α：α=2.0 時 AR=2.0 是正確的，不會像固定門檻 1.5 那樣全部誤判。
AR_DEV_THRESHOLD = 0.25

AR_FIXED_THRESHOLD = 1.5   # 另外固定報告 AR > 此值的筆數（對 α=1 的圓盤才有意義）

# 【注意】以下兩個是「診斷用的分箱邊界」，和上面偵測階段的 AREA_MIN_RATIO /
# AREA_MAX_RATIO 是完全不同的東西，之前命名太像造成混淆，改名如下：
#   AREA_MIN_RATIO / AREA_MAX_RATIO (0.40 / 2.00) = 偵測「篩選」門檻。
#       超出範圍的區域會被「丟掉」，不會進入結果。
#   AREA_BIN_SMALL / AREA_BIN_LARGE (0.70 / 1.30) = 事後「分類」邊界。
#       只是把已經通過篩選的顆粒分成三組來統計，不丟掉任何東西。
# 兩者的區間不同是刻意的：篩選放寬（0.40-2.00）以免漏抓，分類收緊（0.70-1.30）
# 以便看出「勉強通過篩選」的那些是不是都有問題。
AREA_BIN_SMALL = 0.70      # 面積 / 理論面積 低於此值 → 偏小（多半是邊緣碎片）
AREA_BIN_LARGE = 1.30      # 高於此值 → 偏大（多半是兩顆沒切開）

# 壞幀判定門檻。壞幀只會被「標記」，不會被刪除，資料全部保留。
BAD_MIN_PARTICLES = 20     # 顆粒數低於此值 → 該幀直接判為不可用。
                           # 理由：顆粒太少時，所有相對型指標（面積守恆比、形狀
                           # 異常比例、顆數跳動率）的分母都太小，數值必然爆掉。
                           # 實測：顆粒數 ≤20 的 115 幀，面積守恆比中位數 17.5
                           # （正常幀是 1.1）。把這類幀獨立標記，才不會讓人誤以為
                           # 是演算法壞掉——實際上只是料放完了。
BAD_COUNT_DROP = 0.30      # 顆數低於滾動中位數的此倍數
BAD_COUNT_JUMP = 0.15      # |Δ顆數| / 顆數 超過此值
BAD_AREA_CONS_LO = 0.80    # 面積守恆比的容許範圍
BAD_AREA_CONS_HI = 1.50
BAD_AR_DEV_FRAC = 0.15     # 形狀異常的比例超過此值
BAD_DIST_OVER_R = 2.50     # dist/r 超過此值 = 前景黏死

MAKE_PLOTS = False         # 預設不畫圖。用 --plots 開啟。

# ---------- 軌跡 XY 圖 ----------
TRAJ_MIN_LENGTH = 20       # 只畫長度 >= 此值的軌跡（短軌跡多半是雜訊，畫出來只是糊成一片）
TRAJ_MAX_TRACKS = 400      # 最多畫幾條，超過就取最長的那些
TRAJ_FRAME_RANGE = None    # (起, 迄) 只畫這段幀；None = 全片
TRAJ_QUIVER_BINS = 22      # 速度場的空間分箱數（每個方向）
TRAJ_N_HIGHLIGHT = 6       # 右下子圖要單獨畫幾條最長的軌跡

# ---------- 接觸網路與角度 θ / φ ----------
COMPUTE_CONTACTS = True      # 計算接觸網路、每條接觸邊的 θ、每個接觸三元組的 φ
CONTACT_STRIDE = 1           # 每隔幾幀算一次。資料量大時調高（例如 5 或 10）。
                             # 參考：96 顆/幀 × 約 5 個 φ/顆 × 987 幀 ≈ 50 萬列

# 接觸判定（方案 A：分水嶺標籤相鄰）
# 兩個分水嶺區域若在影像上共享邊界，就判定為接觸。
# 這個方法「不需要知道顆粒形狀」，所以 α = 1.0 到 3.5 都一樣用 ——
# 這正是質心距離門檻做不到的（橢圓的接觸距離隨兩顆的相對朝向差好幾倍）。
# 實測（第 500 幀，96 顆）：本法 181 對，質心距離 1.15d 法 182 對，交集 178 對，
# 一致度 98%；平均配位數 3.77，對 2D 有摩擦堆積是合理值。
CONTACT_MIN_BOUNDARY_PX = 3  # 共享邊界至少這麼多像素，才算真的接觸
                             # （防止兩顆不相鄰的顆粒，其分水嶺盆地在第三顆後方碰到）
CONTACT_MAX_DIST_RATIO = 1.60  # 質心距離上限 = 此值 × (兩顆等效直徑的平均)
                               # 只當作防呆的寬鬆上界，不是主要判準

# θ 的符號慣例（project 待討論 #2，已定案）
#   θ = atan2(y1 − y2, x2 − x1)
# 影像的 y 軸朝下，所以要把 y 反號，否則所有角度會上下顛倒。
# 配合「三元組一律由左到右排序」，拱型（上凸）的 θ 會從正值遞減到負值。
#
# 邊界角 θ0 = +30°、θn = −30°（本版未使用，力鏈識別時才需要）：
#   把筒倉壁當成虛擬的第 0 顆顆粒，θ0 是接觸點到第 1 顆質心的連線角度。
#   對光滑壁，該連線沿著壁的內法線。左壁（半角 30°，從鉛垂量起）的方向向量
#   是 (−sin30°, cos30°)，內法線是 (cos30°, sin30°) → +30°。右壁對稱 → −30°。
#   註：此為自行推導，非出自 Zhang 論文。θ0 是幾何量，摩擦不影響。
WALL_HALF_ANGLE_DEG = 30.0   # 筒倉半角（全開口角 60° 的一半）

ROI_HEIGHT_PX = [1]          # 執行時由 main() 填入，供物理座標翻轉使用

