def make_templates(geom):
    """建立匹配濾波的模板庫，回傳 [(朝向角度 deg, 模板陣列), ...]。

    【這個函式在做什麼】
    把「一顆顆粒長什麼樣」做成一個卷積核。核的形狀是：
        內圈（半軸 ra × rb 的橢圓）給正權重，總和 +1
        外環（半軸放大 β 倍的橢圓，扣掉內圈）給負權重，總和 −1
    所以整個核的總和是 0。這個零均值的性質，就是它能分開「黏在一起的兩顆」
    的原因 —— 詳見設定區 MF_ANNULUS_RATIO 上方的說明。

    【參數】
      geom : Geom 物件，提供 ra（長半軸 px）、rb（短半軸 px）、is_disc
    【用到的設定】
      MF_ANNULUS_RATIO  : 外環外半軸的放大倍率 β
      MF_ANGLE_STEP_DEG : α > 1 時模板庫的朝向間隔

    【角度慣例】和 cv2.fitEllipse 一致：從 +x 軸量起，往 +y（影像上是向下）
    轉為正。這樣算出來的朝向可以直接塞進既有的 theta_raw_deg 欄位。
    """
    ra, rb = geom.ra, geom.rb          # 長半軸、短半軸（像素）
    beta = MF_ANNULUS_RATIO
    R = int(np.ceil(beta * ra)) + 1    # 模板半邊長：要裝得下外環
    yy, xx = np.mgrid[-R:R + 1, -R:R + 1].astype(np.float32)

    # α = 1 的圓盤旋轉對稱，只要一個模板；α > 1 要一整圈（0-180°，橢圓有
    # 180° 週期性，轉 180° 和原來一樣）。
    angles = ([0.0] if geom.is_disc
              else list(np.arange(0.0, 180.0, MF_ANGLE_STEP_DEG)))

    out = []
    for th in angles:
        t = np.deg2rad(th)
        # 把影像座標 (xx, yy) 轉到以顆粒長軸為基準的座標 (u, v)
        u = xx * np.cos(t) + yy * np.sin(t)     # 沿長軸方向
        v = -xx * np.sin(t) + yy * np.cos(t)    # 沿短軸方向
        inside = (u / ra) ** 2 + (v / rb) ** 2 <= 1.0
        outer = (((u / (beta * ra)) ** 2 + (v / (beta * rb)) ** 2 <= 1.0)
                 & (~inside))
        K = np.zeros_like(xx)
        K[inside] = 1.0 / max(int(inside.sum()), 1)    # 正權重總和 = +1
        K[outer] = -1.0 / max(int(outer.sum()), 1)     # 負權重總和 = −1
        out.append((float(th), K))
    return out


def matched_filter_seeds(cleaned, geom, templates):
    """用匹配濾波找種子。回傳 (峰值座標陣列 [(y,x),...], 響應圖, 朝向圖)。

    【流程】
      1. 把二值遮罩正規化成 0/1，這樣響應 R 的意義就是
             R = (內圈的前景佔比) − (外環的前景佔比)，範圍 [−1, 1]
         孤立顆粒 R ≈ 1；堆積中接觸鄰居的 R 約 0.4-0.6；兩顆的腰部 R 約 0.2。
      2. 對模板庫裡每個朝向各做一次相關，逐點取最大值：
             R_max(x) = max_k R_θk(x)      → 拿來找種子位置
             θ_hat(x) = argmax_k R_θk(x)   → 朝向的初估值，餵給次像素精化
      3. 非極大值抑制找局部極大值，並強制最小間距（物理約束）。

    【為什麼用 FFT 做相關】
    模板邊長約 2βra ≈ 93 px（α=1）。直接做 cv2.filter2D 是
    影像面積 × 模板面積 ≈ 800×600×9000 次乘加，太慢。
    scipy 的 fftconvolve 是 O(N log N)，同樣的圖約 10 ms。
    模板是中心對稱的（K(−u) = K(u)），所以「相關」和「卷積」結果相同，
    不需要先把核翻轉。

    【參數】
      cleaned   : 形態學開運算後的二值影像（0 / 255）
      geom      : Geom 物件
      templates : make_templates() 的輸出
    """
    from scipy.signal import fftconvolve
    from skimage.feature import peak_local_max

    img = (cleaned > 0).astype(np.float32)
    if img.sum() < 1:
        z = np.zeros(img.shape, np.float32)
        return np.empty((0, 2), int), z, z

    best = None
    best_ang = None
    for th, K in templates:
        R = fftconvolve(img, K, mode="same").astype(np.float32)
        if best is None:
            best = R
            best_ang = np.full(R.shape, th, np.float32)
        else:
            m = R > best
            best[m] = R[m]
            best_ang[m] = th

    # ---- 非極大值抑制 + 最小間距 ----
    # sep 是物理約束：單分散剛體的兩個質心不可能靠得比 0.85 d_eq 更近。
    sep = MF_MIN_SEP_RATIO * geom.d_eq_px
    # peak_local_max 的 min_distance 用的是方形鄰域（Chebyshev 距離），對角線
    # 方向會比較寬鬆，所以先取一個略小的值把候選抓齊，再用真正的歐氏距離
    # 做一次貪婪篩選（由響應高的往低的挑，挑中就把附近的候選全部排除）。
    cand = peak_local_max(best, min_distance=max(1, int(0.7 * sep)),
                          threshold_abs=MF_MIN_RESPONSE, exclude_border=False)
    if len(cand) == 0:
        return np.empty((0, 2), int), best, best_ang
    vals = best[cand[:, 0], cand[:, 1]]
    order = np.argsort(-vals)              # 響應由大到小
    cand = cand[order]
    taken = np.zeros(len(cand), bool)
    keep = []
    for i in range(len(cand)):
        if taken[i]:
            continue
        keep.append(i)
        d2 = ((cand[:, 0] - cand[i, 0]) ** 2 +
              (cand[:, 1] - cand[i, 1]) ** 2)
        taken |= d2 < sep * sep            # 把 sep 以內的候選全部排除
        taken[i] = True
    return cand[keep], best, best_ang


def _parabolic_peak(fm1, f0, fp1):
    """對三個等間距取樣點做拋物線內插，回傳峰值相對中央點的偏移量（−0.5~+0.5）。

    三點 (−1, fm1)、(0, f0)、(+1, fp1) 決定一條拋物線，其頂點位於
        δ = (f(−1) − f(+1)) / (2·[f(−1) − 2f(0) + f(+1)])
    分母是二階差分；若它 ≥ 0（代表這裡不是極大值，數值上不穩）就回傳 0。
    """
    den = fm1 - 2.0 * f0 + fp1
    if den >= -1e-12:
        return 0.0
    d = 0.5 * (fm1 - fp1) / den
    return float(np.clip(d, -0.5, 0.5))


def expected_visible_area(x, y, theta_deg, geom, silo_mask):
    """「這顆理論上應該被看到多少像素」= 模型橢圓 ∩ 筒倉遮罩 的面積（px²）。

    【為什麼需要這個量】
    面積判準是「實際區域面積 ÷ 應該有的面積」。對完全在筒倉內的顆粒，應該有的
    面積就是理論面積 π·a·b/4。但貼著筒倉壁的顆粒，它的區域被遮罩切掉一塊，
    實際面積天生就偏小 —— 拿理論面積當分母會把它誤判成「分割失敗」刪掉。
    而鏈的定義要求「兩端接觸筒倉壁」，刪掉觸壁顆粒等於消滅所有的鏈。

    【為什麼不用上一版的 edge_clipped 豁免】
    上一版的做法是「區域碰到前景外緣就跳過面積判準」。但這個筒倉只有 3–4 顆
    顆粒寬，幾乎每一顆都貼著某個邊界，實測 99.3% 的偵測被豁免 —— 篩選器等於
    被自己關掉了。改成算出「被切掉多少」，判準就對所有顆粒一致生效，不需要
    任何豁免規則。

    【參數】
      x, y       : 顆粒中心（ROI 座標，px）
      theta_deg  : 長軸朝向（度，α=1 時無意義但不影響結果）
      geom       : Geom 物件，提供 ra（長半軸）、rb（短半軸）
      silo_mask  : 筒倉內部遮罩（與 ROI 同大小，>0 代表在筒倉內）
    【回傳】交集的像素數。遮罩是 None 時直接回傳理論面積。
    """
    if silo_mask is None:
        return float(geom.area)
    H, W = silo_mask.shape
    # 只在顆粒的外接框內計算，不掃整張圖
    r = int(np.ceil(geom.ra)) + 2
    xi, yi = int(round(x)), int(round(y))
    x0, x1 = max(0, xi - r), min(W, xi + r + 1)
    y0, y1 = max(0, yi - r), min(H, yi + r + 1)
    if x1 <= x0 or y1 <= y0:
        return 0.0
    yy, xx = np.mgrid[y0:y1, x0:x1]
    t = np.deg2rad(theta_deg)
    dx, dy = xx - x, yy - y
    u = dx * np.cos(t) + dy * np.sin(t)      # 沿長軸
    v = -dx * np.sin(t) + dy * np.cos(t)     # 沿短軸
    inside = (u / geom.ra) ** 2 + (v / geom.rb) ** 2 <= 1.0
    return float(np.count_nonzero(inside & (silo_mask[y0:y1, x0:x1] > 0)))


def fit_fixed_shape(peaks, resp, ang, labels, geom, silo_mask=None):
    """固定長短軸、只擬合位置（與朝向）的顆粒擬合。

    【它在最佳化什麼】
    目標函數就是匹配濾波的響應
        J(x, y, θ) = (模型橢圓內的前景佔比) − (外環的前景佔比)
    自由度只有位置 (x, y)，以及 α > 1 時的朝向 θ —— a 和 b 被鎖成設計值。
    響應圖 resp 已經是 J 在整數網格上的取樣，所以這裡不需要再跑一次最佳化，
    只要對峰值附近做拋物線內插，就能得到次像素的極大值位置。這在數學上
    等價於「對 J 做二階展開後求極值」，也就是固定形狀擬合的解。

    【為什麼不用迭代最佳化】
    每顆每幀跑一次迭代最佳化，3 分鐘影片 21600 幀 × 65 顆 = 140 萬次，
    太慢。拋物線內插只要幾次四則運算，精度在 0.05 px 等級，對 φ 的影響
    （鄰居間距 78 px）只有 0.04°，遠小於 δθ = 20°，綽綽有餘。

    【參數】
      peaks  : matched_filter_seeds() 回傳的峰值座標 [(y, x), ...]
      resp   : 響應圖（與影像同大小）
      ang    : 朝向圖（逐點的最佳模板角度）
      labels : 分水嶺標籤圖，用來取得每顆的區域面積（area_ratio 要用）
      geom   : Geom 物件
    【回傳】顆粒 dict 的清單，欄位和舊的 fit_particles() 一致，方便下游沿用。
    """
    H, W = resp.shape
    out = []
    for (py, px) in peaks:
        py, px = int(py), int(px)
        x, y = float(px), float(py)

        if MF_SUBPIXEL and 0 < px < W - 1 and 0 < py < H - 1:
            # 沿 x 與 y 各做一次一維拋物線內插
            x += _parabolic_peak(resp[py, px - 1], resp[py, px],
                                 resp[py, px + 1])
            y += _parabolic_peak(resp[py - 1, px], resp[py, px],
                                 resp[py + 1, px])

        theta = float(ang[py, px]) % 180.0

        # 這一顆屬於哪個分水嶺區域：用來拿區域面積算 area_ratio。
        lab = int(labels[py, px])
        if lab <= 0:
            continue
        # area 先留空，等迴圈跑完用 bincount 一次補齊（比逐顆掃整張圖快很多）
        out.append(dict(label=lab, x=x, y=y,
                        major=geom.a_px, minor=geom.b_px,   # ← 鎖成設計值
                        theta=theta, area=None,
                        mf_response=float(resp[py, px]),
                        fill=np.nan))
    # 區域面積一次算完比逐顆掃整張圖快得多（np.bincount 掃一遍就好）
    if out:
        counts = np.bincount(labels.ravel())
        for d in out:
            lab = d["label"]
            d["area"] = int(counts[lab]) if lab < len(counts) else 0
            # 【期望可見面積】取代 2026-10-27 那版的 edge_clipped 豁免。
            # 把鎖定大小的模型橢圓畫在擬合出來的位置上，和筒倉遮罩取交集，
            # 算交集有幾個像素 —— 那就是「這顆理論上應該被看到多少」。
            # 貼著壁的顆粒會被遮罩切掉一塊，分母自動縮小，判準照樣成立。
            d["area_expected"] = expected_visible_area(
                d["x"], d["y"], d["theta"], geom, silo_mask)
    # 同一個分水嶺區域若對到兩個種子，代表最小間距沒擋住的重複，保留響應高的
    seen = {}
    for d in out:
        k = d["label"]
        if k not in seen or d["mf_response"] > seen[k]["mf_response"]:
            seen[k] = d
    return list(seen.values())


def filter_particles(dets, geom, free_ar=None):
    """篩掉偵測失敗的區域。兩個判準並用，各自抓不同的失敗。

    【判準一：面積】
        area_ratio = 這一顆的區域面積（px²） / 期望可見面積（px²）
    其中「期望可見面積」= 模型橢圓 ∩ 筒倉遮罩 的像素數，由
    expected_visible_area() 算出。完全在筒倉內的顆粒，它就等於理論面積
        理論面積 = π · a_px · b_px / 4,   b_px = B_MM × px_per_mm,  a_px = α·b_px
    貼著壁的顆粒會被遮罩切掉一塊，分母自動縮小，所以判準對它一樣成立。

    通過條件：DETECT_AREA_LO ≤ area_ratio ≤ DETECT_AREA_HI（預設 0.75–1.25）
    抓得到：兩顆沒切開（≈2.0）、一顆被切成兩半（≈0.5）、退化的碎屑。

    【為什麼分母是「期望面積」而不是「本幀中位數」】
    2026-10-27 那版曾經改成除以本幀所有區域面積的中位數，理由是量到
    area_ratio ≈ 1.21，誤判成「門檻外擴讓每顆胖了 21%」。後來查出那 1.21 其實
    是比例尺低估 9.3% 的平方（1.093² = 1.195）—— 比例尺修好之後是 1.012，
    根本沒有偏差要吸收。而且拿「被判斷的資料自己」當分母，會讓「全體一起錯」
    這種故障完全看不出來（中位數跟著一起跑），等於把警報器拆掉。
    改回外部已知常數當分母，area_ratio 偏離 1.0 就是標定出錯的第一道警訊。

    【判準二：形狀】「這塊區域像不像一顆顆粒」
      · 自由擬合路徑：用 aspect_ratio（月牙碎片約 1.96）
      · 固定形狀路徑：aspect_ratio 被鎖成 α、恆為常數沒有資訊量，改用自由
        擬合另外量到的 aspect_ratio_free（由 free_ar 傳進來）
    通過條件：|aspect_ratio_free − α| ≤ DETECT_AR_DEV（預設 0.25）

    【兩個判準抓的是不同子集】實測 9756：面積判準抓 8506 筆、形狀判準抓
    10286 筆、聯集 14206 筆 / 59685 —— 聯集遠大於任一個，所以必須並用。

    【參數】
      dets    : 顆粒 dict 清單，每個要有 area 和 area_expected
      geom    : Geom 物件
      free_ar : {label: 自由擬合的 aspect_ratio}；None = 不用形狀判準
    """
    out = []
    floor = DETECT_AREA_FLOOR * geom.area       # 絕對下限，擋退化的碎屑
    for d in dets:
        if d.get("area") is None or d["area"] < floor:
            continue
        exp = d.get("area_expected") or geom.area
        if exp < floor:
            # 幾乎整顆都在筒倉遮罩外面，判準失去意義，直接丟
            continue
        ar_area = d["area"] / exp
        d["area_ratio_corrected"] = ar_area
        if not (DETECT_AREA_LO <= ar_area <= DETECT_AREA_HI):
            continue
        if free_ar is not None:
            ar = free_ar.get(d["label"])
            if ar is not None and abs(ar - geom.alpha) > DETECT_AR_DEV:
                continue
            d["aspect_ratio_free"] = ar
        out.append(d)
    return out


def qc_free_fit(labels, geom, valid_labels=None):
    """品保通道：對分割區域跑「自由」的 cv2.fitEllipse，量真實形狀。

    【和主線的差別】主線把 a、b 鎖成設計值，所以主線的 aspect_ratio 恆等於 α，
    沒有資訊量。這條線放開 5 個自由度，量到的才是真的形狀，用途有兩個：
      · aspect_ratio_free 偏離 α 多少 → 顆粒加工精度 + 影像幾何變形
      · area_ratio 偏離 1.0 多少       → 分割有沒有成功
    這條線的輸出寫進 qc_shape.csv，不進任何分析。

    【參數】
      labels       : 分水嶺標籤圖
      geom         : Geom 物件
      valid_labels : 只量這些標籤；None = 全部
    """
    from scipy import ndimage as _ndi
    rows = []
    for idx, sl in enumerate(_ndi.find_objects(labels)):
        if sl is None:
            continue
        lab = idx + 1
        if valid_labels is not None and lab not in valid_labels:
            continue
        sub = (labels[sl] == lab).astype(np.uint8)
        area = int(sub.sum())
        cnts, _ = cv2.findContours(sub, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_NONE)
        if not cnts:
            continue
        cnt = max(cnts, key=cv2.contourArea)
        if len(cnt) < 5:        # fitEllipse 需要至少 5 個點（二次曲線 5 個自由度）
            continue
        (cx, cy), (w, h), a_ = cv2.fitEllipse(cnt)
        major, minor = (h, w) if h >= w else (w, h)
        theta = ((a_ + 90.0) if h >= w else a_) % 180.0
        rows.append(dict(label=lab,
                         x=cx + sl[1].start, y=cy + sl[0].start,
                         major_px=major, minor_px=minor, theta_deg=theta,
                         area_px=area,
                         aspect_ratio_free=major / max(minor, 1e-9),
                         area_ratio=area / geom.area,
                         fill=area / max(np.pi * major * minor / 4.0, 1e-9)))
    return rows


def fit_particles(labels, geom):
    """對每個分水嶺區域擬合橢圓，回傳通過篩選的顆粒清單。

    【加速】原本每個標籤都對整張圖做一次 (labels == lab)，成本是
    標籤數 × 影像面積。改用 find_objects 先取外接框，只在小框內比對，
    結果完全相同但快一個數量級。

    【多加一道填充率篩選】
    真顆粒是實心橢圓，「實際面積 / 擬合橢圓面積」接近 1.0。
    watershed 偶爾會在顆粒之間的縫隙切出「新月形」的彎曲碎片：它的面積落在
    正常範圍內（面積篩選擋不掉），但 fitEllipse 會沿著那段弧擬合出一個巨大的
    橢圓 —— 實測有長軸被算成 3208 mm 的。這種碎片的填充率很低，一條就濾乾淨。
    """
    from scipy import ndimage as _ndi
    amin = AREA_MIN_RATIO * geom.area
    amax = AREA_MAX_RATIO * geom.area
    out = []
    for idx, sl in enumerate(_ndi.find_objects(labels)):
        if sl is None:
            continue
        lab = idx + 1
        sub = (labels[sl] == lab).astype(np.uint8)
        area = int(sub.sum())
        if not (amin <= area <= amax):
            continue
        cnts, _ = cv2.findContours(sub, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_NONE)
        if not cnts:
            continue
        cnt = max(cnts, key=cv2.contourArea)
        if len(cnt) < 5:          # fitEllipse 需要至少 5 點（二次曲線 5 個自由度）
            continue
        (cx, cy), (w, h), ang = cv2.fitEllipse(cnt)
        cx += sl[1].start         # 子圖座標還原成 ROI 座標
        cy += sl[0].start

        # 【角度慣例】OpenCV 回傳的 ang 是第一個軸 w 的方向，而且不保證 w 是長軸。
        # 若長軸其實是 h，方向要再轉 90°。對圓盤看不出差別，α≥2 會有一半朝向錯 90°。
        if h >= w:
            major, minor, theta = h, w, (ang + 90.0) % 180.0
        else:
            major, minor, theta = w, h, ang % 180.0

        fill = area / max(np.pi * major * minor / 4.0, 1e-9)
        if FILL_RATIO_MIN is not None and fill < FILL_RATIO_MIN:
            continue

        out.append(dict(label=lab, x=cx, y=cy, major=major, minor=minor,
                        theta=theta, area=area, fill=fill))
    return out


