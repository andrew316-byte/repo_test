# 接觸網路與角度 θ / φ
# ==========================================================================

def watershed_adjacency(labels, valid_labels):
    """找出哪些分水嶺區域彼此相鄰，並回傳共享邊界的長度（像素數）。

    做法：把標籤圖往四個方向各位移一格，和原圖比對。相鄰位置上兩個不同的
    非零標籤，就代表那裡是兩個區域的交界。累加次數即共享邊界長度。

    【為什麼這個方法對任何形狀都成立】
    它問的是「這兩塊影像有沒有貼在一起」，完全不涉及幾何模型。
    質心距離門檻則必須先知道「這兩顆在這個相對朝向下，接觸時質心該差多遠」——
    對圓盤是定值 d，對 α=3.5 的橢圓則在 b 到 a 之間變動 3.5 倍。

    【真實空隙不會被誤判】
    watershed 只在 mask（前景）內指派標籤，背景是 0。兩顆之間若有看得見的
    空隙，那些像素是背景，兩個區域就不會相鄰。
    """
    H, W = labels.shape
    counts = {}
    for dy, dx in ((0, 1), (1, 0), (1, 1), (1, -1)):
        a = labels[max(0, -dy):H - max(0, dy), max(0, -dx):W - max(0, dx)]
        b = labels[max(0, dy):H - max(0, -dy), max(0, dx):W - max(0, -dx)]
        m = (a > 0) & (b > 0) & (a != b)
        if not m.any():
            continue
        pa, pb = a[m].ravel(), b[m].ravel()
        lo = np.minimum(pa, pb)
        hi = np.maximum(pa, pb)
        key = lo.astype(np.int64) * (labels.max() + 1) + hi.astype(np.int64)
        u, c = np.unique(key, return_counts=True)
        for k, n in zip(u.tolist(), c.tolist()):
            i, j = divmod(k, labels.max() + 1)
            if i in valid_labels and j in valid_labels:
                counts[(i, j)] = counts.get((i, j), 0) + n
    return counts


def link_angle(p_left, p_right):
    """兩顆質心連線相對水平的角度，單位 deg，範圍 (−180, 180]。

    θ = atan2(y_left − y_right, x_right − x_left)

    y 要反號，因為影像座標的 y 軸朝下。不反號的話所有角度會上下顛倒 ——
    這是最容易寫錯又最難察覺的地方（數值看起來都很合理，只是符號全反）。
    傳入的兩點必須已經按 x 由小到大排好。
    """
    return np.degrees(np.arctan2(p_left[1] - p_right[1], p_right[0] - p_left[0]))


def build_contacts(frame_idx, parts, labels, geom):
    """單幀的接觸網路 + θ + φ。

    回傳 (接觸邊清單, 角度三元組清單)。

    φ 的定義與排序
    ---------------
        φ_center = 180° + θ(center→right) − θ(left→center)
    三元組一律按 x 由小到大排成 (left, center, right)。

    為什麼順序重要：交換 left 和 right 會得到 360° − φ（同一個頂點的另一側夾角）。
    固定由左到右之後，水平直線的 φ = 180°，上凸的拱 φ < 180°，
    和 Zhang 的拱型條件 φ_i < 180° + δθ 一致。
    """
    by_label = {p["label"]: p for p in parts}
    adj = watershed_adjacency(labels, set(by_label))

    edges = []
    nbr = {k: [] for k in by_label}
    for (i, j), blen in adj.items():
        if blen < CONTACT_MIN_BOUNDARY_PX:
            continue
        pi, pj = by_label[i], by_label[j]
        d = np.hypot(pi["x"] - pj["x"], pi["y"] - pj["y"])
        deq = (np.sqrt(pi["major"] * pi["minor"]) + np.sqrt(pj["major"] * pj["minor"])) / 2
        if d > CONTACT_MAX_DIST_RATIO * deq:
            continue
        # 由左到右（x 相同時用 y 決定，避免順序不定）
        a, b = (pi, pj) if (pi["x"], pi["y"]) <= (pj["x"], pj["y"]) else (pj, pi)
        th = link_angle((a["x"], a["y"]), (b["x"], b["y"]))
        edges.append(dict(frame=frame_idx, label_left=a["label"], label_right=b["label"],
                          x_left=a["x"], y_left=a["y"], x_right=b["x"], y_right=b["y"],
                          theta_deg=th, dist_px=d, boundary_px=blen))
        nbr[i].append(j)
        nbr[j].append(i)

    # --- 三元組：以每顆為中心，枚舉它所有鄰居的兩兩組合 ---
    tri = []
    for c, ns in nbr.items():
        pc = by_label[c]
        for ii in range(len(ns)):
            for jj in range(ii + 1, len(ns)):
                pa, pb = by_label[ns[ii]], by_label[ns[jj]]
                # 左右由 x 決定
                left, right = (pa, pb) if (pa["x"], pa["y"]) <= (pb["x"], pb["y"]) else (pb, pa)
                th_in = link_angle((left["x"], left["y"]), (pc["x"], pc["y"]))
                th_out = link_angle((pc["x"], pc["y"]), (right["x"], right["y"]))
                phi = 180.0 + (th_out - th_in)
                # φ 落在 (0, 360)
                phi = phi % 360.0
                tri.append(dict(frame=frame_idx,
                                label_left=left["label"], label_center=c,
                                label_right=right["label"],
                                x_center=pc["x"], y_center=pc["y"],
                                theta_in_deg=th_in, theta_out_deg=th_out,
                                phi_deg=phi))
    return edges, tri


def summarise_angles(ed, tr, geom):
    """θ / φ 的統計摘要。回傳 (標題, 內容) 清單。"""
    out = []
    lines = []
    n_frames = ed["frame"].nunique()
    n_part = ed[["frame", "label_left"]].drop_duplicates().shape[0]
    lines.append(f"分析幀數          : {n_frames}")
    lines.append(f"接觸邊總數        : {len(ed)}  "
                 f"(平均每幀 {len(ed)/max(n_frames,1):.1f} 對)")
    lines.append(f"角度三元組總數    : {len(tr)}  "
                 f"(平均每幀 {len(tr)/max(n_frames,1):.1f} 個)")
    # 配位數
    cn = (pd.concat([ed.groupby(["frame", "label_left"]).size(),
                     ed.groupby(["frame", "label_right"]).size()])
            .groupby(level=[0, 1]).sum())
    lines.append(f"平均配位數        : {cn.mean():.2f}  (中位數 {cn.median():.0f})")
    lines.append("  參考：2D 無摩擦等靜定堆積 z = 4，有摩擦會低於 4。")
    lines.append(f"接觸距離          : 中位數 {ed.dist_px.median()/geom.s:.3f} mm "
                 f"(顆粒直徑 {geom.b_mm:.1f} mm，比值 "
                 f"{ed.dist_px.median()/geom.b_px:.3f})")
    out.append(("接觸網路", "\n".join(lines)))

    lines = []
    th = ed["theta_deg"]
    lines.append("θ = 兩顆質心連線相對水平的角度，單位 deg。")
    lines.append("定義域 (−90, 90]（因為已按 x 由左到右排序）。")
    lines.append("")
    lines.append(f"中位數 {th.median():+.2f}°   平均 {th.mean():+.2f}°   "
                 f"標準差 {th.std():.2f}°")
    lines.append("百分位:")
    for p in (5, 25, 50, 75, 95):
        lines.append(f"  {p:3d}% : {th.quantile(p/100):+7.2f}°")
    lines.append("")
    # --- 晶格序參數：單分散圓盤會結晶，這會徹底改變 P(θ) 和 P(φ) ---
    thr = np.deg2rad(th.values)
    psi6 = abs(np.mean(np.exp(6j * thr)))
    psi4 = abs(np.mean(np.exp(4j * thr)))
    lines.append("")
    lines.append(f"六角序參數 ψ₆ = |⟨exp(6iθ)⟩| = {psi6:.3f}"
                 f"   (1 = 完美三角晶格, 0 = 隨機)")
    lines.append(f"四角序參數 ψ₄ = |⟨exp(4iθ)⟩| = {psi4:.3f}")
    lines.append("")
    if psi6 > 0.4:
        lines.append("⚠ ψ₆ 明顯偏高 ——【堆積已經結晶成三角晶格】")
        lines.append("  θ 會鎖在 0°、±60°，φ 會鎖在 60° 的倍數，而不是連續分布。")
        lines.append("  成因：單分散（所有顆粒一樣大）的圓盤在 2D 必定結晶。")
        lines.append("  後果：P(θ)、P(φ) 變成一組 delta 峰，Zhang 模型假設的連續分布不成立。")
        lines.append("  這不是程式的問題，是物理的問題，要從實驗設計面處理。")
    else:
        lines.append("ψ₆ 偏低，堆積是無序的，P(θ)、P(φ) 可以當連續分布處理。")
    lines.append("")
    lines.append("【怎麼看】無序堆積的 θ 在 (−90, 90] 上大致均勻、中位數接近 0；")
    lines.append("結晶堆積的 θ 會出現 0°、±60° 的尖峰（三角晶格）。")
    lines.append("若出現其他方向的偏態，才是剪切帶、壁效應或影像幾何變形。")
    out.append(("θ 分布（接觸邊）", "\n".join(lines)))

    lines = []
    ph = tr["phi_deg"]
    lines.append("φ_center = 180° + θ(center→right) − θ(left→center)，單位 deg。")
    lines.append("180° = 三顆完全共線；< 180° 上凸；> 180° 下凹。")
    lines.append("")
    lines.append(f"中位數 {ph.median():.2f}°   平均 {ph.mean():.2f}°   "
                 f"標準差 {ph.std():.2f}°")
    lines.append("百分位:")
    for p in (5, 25, 50, 75, 95):
        lines.append(f"  {p:3d}% : {ph.quantile(p/100):7.2f}°")
    lines.append("")
    inr = ph.between(100, 200)
    lines.append(f"落在 Zhang 對圓盤採用的 [100°, 200°] 內: "
                 f"{inr.sum()} / {len(ph)} ({100*inr.mean():.1f}%)")
    lines.append("")
    lines.append("【重要：這個母體不等於 Zhang 的母體】")
    lines.append("這裡統計的是「所有接觸三元組」，Zhang 統計的是「力鏈中的三元組」。")
    lines.append("力鏈是通過 δθ 規則篩選、且兩端觸壁的子集合，分布會明顯不同")
    lines.append("（力鏈偏向接近共線，所以 Zhang 的 P(φ) 會比這裡更集中在 180° 附近）。")
    lines.append("要和論文比較，必須先做完力鏈識別。這一版的輸出是那一步的輸入。")
    out.append(("φ 分布（所有接觸三元組）", "\n".join(lines)))
    return out



