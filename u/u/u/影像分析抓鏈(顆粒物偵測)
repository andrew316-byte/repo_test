class Geom:
    """把物理設定換算成像素量。全部集中在這裡，程式其他地方不出現魔術數字。"""

    def __init__(self, b_mm, alpha, px_per_mm):
        self.b_mm = b_mm
        self.alpha = alpha
        self.s = px_per_mm
        self.b_px = b_mm * px_per_mm           # 短軸全長
        self.a_px = alpha * self.b_px          # 長軸全長
        self.rb = self.b_px / 2.0              # 短半軸
        self.ra = self.a_px / 2.0              # 長半軸
        self.area = np.pi * self.ra * self.rb  # 理論面積
        self.is_disc = alpha < 1.05

    def __str__(self):
        return (f"短軸 {self.b_mm} mm = {self.b_px:.1f} px | "
                f"長軸 {self.b_mm*self.alpha:.1f} mm = {self.a_px:.1f} px | "
                f"理論面積 {self.area:.0f} px² | 比例尺 {self.s:.3f} px/mm")

    @property
    def d_eq_px(self):
        """等效直徑（像素）= 與橢圓同面積的圓的直徑。長度一律用它無因次化。"""
        return 2.0 * np.sqrt(self.ra * self.rb)

    @property
    def d_eq_mm(self):
        return self.d_eq_px / self.s


# ==========================================================================
# 筒倉幾何
# ==========================================================================
# 座標慣例（整支程式只在這裡換算，別處一律不自己換）
#   影像座標：原點左上，y 向下 —— OpenCV 給的就是這個
#   物理座標：原點在「出口中點」，x 向右，y 向上 —— 所有 mm 單位的輸出都用這個
# 兩者 y 方向相反，是最容易寫錯又最難察覺的地方：錯了的話所有角度會上下顛倒，
# 但數值看起來都還算合理。

ROI_OFFSET = [0, 0]        # 執行時由 main() 填入 (x0, y0)，把 ROI 座標還原成全圖座標

CALIB_HELP = ("依序點：1 左壁上 → 2 左壁下(出口左緣) → 3 右壁下(出口右緣) → 4 右壁上"
              "   |  u=退一步  r=全部重來  Enter=存檔")


def pick_screws(frame):
    """跳出視窗讓你點兩顆螺絲的十字中心，回傳 [(x, y), (x, y)]（全圖座標）。

    【為什麼要你手點而不是自動找】
    自動找試過兩種（亮度+飽和度門檻、匹配濾波），兩次都被壓克力邊緣和調整
    長孔的反光搶走峰值。你點兩下，可靠度從「要祈禱」變成「保證」。
    點完之後每幀的重新定位是自動的（正規化互相關），所以只點這一次。

    【畫面是整張未裁切的原始影格】比例尺必須在裁 ROI 之前量，這樣 ROI 怎麼
    設都不影響標定。
    """
    pts = []
    scale = min(1.0, 900.0 / frame.shape[0])
    win = "screw calibration (scale)"

    def on_mouse(event, x, y, flags, param):
        if event == cv2.EVENT_LBUTTONDOWN and len(pts) < 2:
            pts.append((x / scale, y / scale))

    cv2.namedWindow(win)
    cv2.setMouseCallback(win, on_mouse)
    help1 = "Click the CROSS CENTRE of the two screws.  u=undo  r=reset  Enter=OK  Esc=quit"
    help2 = f"They are {SCREW_DISTANCE_MM} mm apart (SCREW_DISTANCE_MM)"
    while True:
        vis = cv2.resize(frame, None, fx=scale, fy=scale)
        for i, (px_, py_) in enumerate(pts):
            q = (int(px_ * scale), int(py_ * scale))
            cv2.drawMarker(vis, q, (0, 0, 255), cv2.MARKER_CROSS, 18, 2)
            cv2.circle(vis, q, int(SCREW_TEMPLATE_HALF * scale), (0, 0, 255), 1)
            cv2.putText(vis, f"screw {i+1}", (q[0] + 10, q[1] - 10),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 0, 255), 1)
        if len(pts) == 2:
            cv2.line(vis, tuple(np.int32(np.array(pts[0]) * scale)),
                     tuple(np.int32(np.array(pts[1]) * scale)), (0, 255, 255), 2)
        cv2.putText(vis, help1, (10, 20), cv2.FONT_HERSHEY_SIMPLEX,
                    0.45, (255, 255, 255), 1)
        cv2.putText(vis, help2, (10, 40), cv2.FONT_HERSHEY_SIMPLEX,
                    0.45, (255, 255, 255), 1)
        cv2.imshow(win, vis)
        k = cv2.waitKey(20) & 0xFF
        if k in (13, 10) and len(pts) == 2:
            break
        if k == ord('u') and pts:
            pts.pop()
        if k == ord('r'):
            pts = []
        if k == 27:
            cv2.destroyWindow(win)
            sys.exit("使用者取消螺絲標定")
    cv2.destroyWindow(win)
    return sorted(pts)                 # 一律由左到右，點反了也沒關係


def _locate_template(gray, tpl, cx, cy, win):
    """在 (cx, cy) 附近 ±win 的範圍內用正規化互相關找回模板的位置。

    【為什麼用 TM_CCOEFF_NORMED】它先把模板和影像各自減去平均值再做相關，
    所以對整體亮度變化免疫（洩料過程中照明會漂移）。回傳值 1.0 = 完美吻合。

    【次像素】對相關圖的峰值做 3 點拋物線內插，精度約 0.1 px。

    回傳 (x, y, 相關係數)，座標是全圖座標。
    """
    H, W = gray.shape
    h = tpl.shape[0] // 2
    x0 = int(max(0, min(W - 2 * win, cx - win)))
    y0 = int(max(0, min(H - 2 * win, cy - win)))
    sub = gray[y0:y0 + 2 * win, x0:x0 + 2 * win]
    if sub.shape[0] < tpl.shape[0] or sub.shape[1] < tpl.shape[1]:
        return float(cx), float(cy), 0.0
    r = cv2.matchTemplate(sub, tpl, cv2.TM_CCOEFF_NORMED)
    _, mx, _, ml = cv2.minMaxLoc(r)
    i, j = ml
    dx = dy = 0.0
    if 0 < i < r.shape[1] - 1 and 0 < j < r.shape[0] - 1:
        den_x = r[j, i - 1] - 2 * r[j, i] + r[j, i + 1]
        den_y = r[j - 1, i] - 2 * r[j, i] + r[j + 1, i]
        if abs(den_x) > 1e-12:
            dx = float(np.clip(0.5 * (r[j, i - 1] - r[j, i + 1]) / den_x, -.5, .5))
        if abs(den_y) > 1e-12:
            dy = float(np.clip(0.5 * (r[j - 1, i] - r[j + 1, i]) / den_y, -.5, .5))
    return x0 + i + h + dx, y0 + j + h + dy, float(mx)


def measure_screw_scale(video, n_total, screw_pts, emit=print):
    """用兩顆螺絲量比例尺。回傳 (px_per_mm, 診斷 dict)。

    【流程】
      1. 以你點的位置為中心，從一張參考幀切出兩塊模板
      2. 在 SCREW_N_SAMPLE 個均勻取樣的幀上，各自用互相關重新定位
      3. 算每幀的兩心間距，取「中位數」（免疫單幀失誤）
      4. px_per_mm = 間距中位數 / SCREW_DISTANCE_MM

    【為什麼量間距而不是量單一物件】
    相機微震、壓縮雜訊讓兩顆螺絲「一起」抖，相減就抵銷掉。實測 9756：
    單顆位置的幀間標準差 1.2–1.4 px，但間距只有 0.45 px。

    【只量一次，不每幀量】螺絲是固定的，比例尺是常數。整支影片共用一個值。
    """
    cap = cv2.VideoCapture(video)
    mid = max(0, n_total // 2)
    cap.set(cv2.CAP_PROP_POS_FRAMES, mid)
    ok, ref = cap.read()
    if not ok:
        cap.release()
        sys.exit("讀不到參考幀，無法切螺絲模板")
    g0 = cv2.cvtColor(ref, cv2.COLOR_BGR2GRAY)
    Hh = SCREW_TEMPLATE_HALF
    tpls, starts = [], []
    for (sx, sy) in screw_pts:
        xi, yi = int(round(sx)), int(round(sy))
        t = g0[yi - Hh:yi + Hh, xi - Hh:xi + Hh]
        if t.shape != (2 * Hh, 2 * Hh):
            cap.release()
            sys.exit(f"螺絲點 ({sx:.0f},{sy:.0f}) 太靠近影像邊緣，切不出模板")
        tpls.append(t.copy())
        starts.append((xi, yi))

    dists, corrs, pos = [], [], []
    for fi in np.linspace(0, n_total - 1, SCREW_N_SAMPLE).astype(int):
        cap.set(cv2.CAP_PROP_POS_FRAMES, int(fi))
        okf, fr = cap.read()
        if not okf:
            continue
        g = cv2.cvtColor(fr, cv2.COLOR_BGR2GRAY)
        found = [_locate_template(g, tpls[k], starts[k][0], starts[k][1],
                                  SCREW_SEARCH_WIN) for k in (0, 1)]
        d = float(np.hypot(found[1][0] - found[0][0], found[1][1] - found[0][1]))
        dists.append(d)
        corrs.append((found[0][2], found[1][2]))
        pos.append((found[0][0], found[0][1], found[1][0], found[1][1]))
    cap.release()

    if len(dists) < 5:
        sys.exit("螺絲取樣幀太少，量不出比例尺")
    d = np.array(dists, float)
    med = float(np.median(d))
    px_per_mm = med / SCREW_DISTANCE_MM
    cm = np.array(corrs, float)
    pos = np.array(pos, float)
    drift = np.abs(d - med) / med
    diag = dict(n_sample=len(d), dist_median_px=med, dist_sd_px=float(d.std()),
                dist_min_px=float(d.min()), dist_max_px=float(d.max()),
                corr_left=float(np.median(cm[:, 0])),
                corr_right=float(np.median(cm[:, 1])),
                rel_sd_pct=float(100 * d.std() / med),
                n_drift=int((drift > SCREW_DRIFT_WARN).sum()),
                left_xy=[float(pos[:, 0].mean()), float(pos[:, 1].mean())],
                right_xy=[float(pos[:, 2].mean()), float(pos[:, 3].mean())])

    emit(f"    螺絲標定：取樣 {diag['n_sample']} 幀，"
         f"互相關中位 左 {diag['corr_left']:.3f} / 右 {diag['corr_right']:.3f}")
    emit(f"      左螺絲 ({diag['left_xy'][0]:.1f}, {diag['left_xy'][1]:.1f})"
         f"   右螺絲 ({diag['right_xy'][0]:.1f}, {diag['right_xy'][1]:.1f})")
    emit(f"      間距中位 {med:.2f} px  標準差 {d.std():.3f} px"
         f"（±{diag['rel_sd_pct']:.2f}%）  範圍 {d.min():.2f}–{d.max():.2f}")
    emit(f"      → px_per_mm = {med:.2f} / {SCREW_DISTANCE_MM} = {px_per_mm:.4f}")
    if min(diag['corr_left'], diag['corr_right']) < 0.7:
        emit("      ⚠ 互相關偏低（< 0.7），螺絲可能沒點準或被遮住，"
             "請加 --recalib 重點")
    if diag['n_drift']:
        emit(f"      ⚠ 有 {diag['n_drift']} 幀的間距偏離中位數超過 "
             f"{100*SCREW_DRIFT_WARN:.0f}% —— 相機可能被碰到，或螺絲鬆了")
    return px_per_mm, diag


def pick_roi(frame):
    """跳出視窗讓你拖一個矩形當分析範圍，回傳 (x0, y0, x1, y1)（全圖座標）。

    【畫面是整張未裁切的原始影格】你要親自確認「所有顆粒都在框內」。

    【框的時候】
      上緣：高過料堆最高時的自由表面（看影片最開頭那一幀決定）
      下緣：切在出口線，或略低一點點 → 出口以下不看，手和螺絲自動排除
      左右：比筒倉壁寬一些，不要切到壁

    【為什麼上緣很重要】A12 用「ROI 內的顆粒數減少量」當流出顆粒數。如果有
    顆粒在框外，它後來掉進畫面會被當成憑空多出來的顆粒，顆粒數反而上升。
    """
    scale = min(1.0, 900.0 / frame.shape[0])
    vis = cv2.resize(frame, None, fx=scale, fy=scale)
    cv2.putText(vis, "Drag the analysis ROI, then Enter.  (c=cancel)",
                (10, 20), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (255, 255, 255), 1)
    cv2.putText(vis, "Top edge ABOVE the highest free surface; bottom edge at the OUTLET",
                (10, 40), cv2.FONT_HERSHEY_SIMPLEX, 0.45, (0, 255, 255), 1)
    r = cv2.selectROI("ROI selection", vis, showCrosshair=True, fromCenter=False)
    cv2.destroyWindow("ROI selection")
    if r[2] < 5 or r[3] < 5:
        sys.exit("ROI 太小或被取消")
    x0 = int(round(r[0] / scale)); y0 = int(round(r[1] / scale))
    x1 = int(round((r[0] + r[2]) / scale)); y1 = int(round((r[1] + r[3]) / scale))
    return x0, y0, x1, y1


def pick_geometry(frame):
    """跳出視窗讓使用者點四個點定出筒倉，回傳 [(x, y)] × 4（全圖座標）。"""
    pts = []
    scale = min(1.0, 900.0 / frame.shape[0])

    def on_mouse(event, x, y, flags, param):
        if event == cv2.EVENT_LBUTTONDOWN and len(pts) < 4:
            pts.append((x / scale, y / scale))

    win = "silo calibration"
    cv2.namedWindow(win)
    cv2.setMouseCallback(win, on_mouse)
    labels = ["1 left-top", "2 left-bottom", "3 right-bottom", "4 right-top"]
    while True:
        vis = cv2.resize(frame, None, fx=scale, fy=scale)
        for i, (px_, py_) in enumerate(pts):
            q = (int(px_ * scale), int(py_ * scale))
            cv2.circle(vis, q, 5, (0, 0, 255), -1)
            cv2.putText(vis, labels[i], (q[0] + 8, q[1] - 8),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 0, 255), 1)
        if len(pts) >= 2:
            cv2.line(vis, tuple(np.int32(np.array(pts[0]) * scale)),
                     tuple(np.int32(np.array(pts[1]) * scale)), (0, 255, 0), 2)
        if len(pts) >= 4:
            cv2.line(vis, tuple(np.int32(np.array(pts[3]) * scale)),
                     tuple(np.int32(np.array(pts[2]) * scale)), (0, 255, 0), 2)
            cv2.line(vis, tuple(np.int32(np.array(pts[1]) * scale)),
                     tuple(np.int32(np.array(pts[2]) * scale)), (255, 128, 0), 2)
        cv2.putText(vis, CALIB_HELP, (10, 20), cv2.FONT_HERSHEY_SIMPLEX,
                    0.45, (255, 255, 255), 1)
        cv2.imshow(win, vis)
        k = cv2.waitKey(20) & 0xFF
        if k in (13, 10) and len(pts) == 4:
            break
        if k == ord('u') and pts:
            pts.pop()
        if k == ord('r'):
            pts = []
        if k == 27:
            cv2.destroyWindow(win)
            sys.exit("使用者取消標定")
    cv2.destroyWindow(win)
    return pts


class SiloGeometry:
    """四個標定點 → 壁線、出口線、法向量、物理座標、筒倉內部遮罩。

    全部用「全圖座標」。顆粒座標是 ROI 座標，呼叫前請加上 ROI_OFFSET。
    """

    def __init__(self, pts, geom):
        self.g = geom
        self.lt = np.array(pts[0], float)    # 左壁上
        self.lb = np.array(pts[1], float)    # 左壁下 = 出口左緣
        self.rb = np.array(pts[2], float)    # 右壁下 = 出口右緣
        self.rt = np.array(pts[3], float)    # 右壁上

        self.outlet_mid = (self.lb + self.rb) / 2.0
        self.outlet_y_px = float(self.outlet_mid[1])
        self.outlet_width_px = float(np.linalg.norm(self.rb - self.lb))

        self.n_left = self._inward_normal(self.lt, self.lb)
        self.n_right = self._inward_normal(self.rt, self.rb)

        # 壁線校正量，存成「逐高度剖面」(高度陣列, 校正量陣列)，中間線性內插。
        # 見 refine_walls_from_particles()。
        self.wall_shift = {"left": (np.array([0.0, 1.0]), np.array([0.0, 0.0])),
                           "right": (np.array([0.0, 1.0]), np.array([0.0, 0.0]))}

    # ---- 基本幾何 --------------------------------------------------------
    def _inward_normal(self, p_up, p_dn):
        u = p_dn - p_up
        u = u / np.linalg.norm(u)
        n = np.array([-u[1], u[0]])
        if np.dot(self.outlet_mid - p_up, n) < 0:
            n = -n
        return n

    def height_above_outlet_px(self, pt):
        """質心在出口線以上的高度（像素，向上為正）。"""
        return float(self.outlet_y_px - pt[1])

    def dist_to_wall(self, pt, side):
        """質心到某面壁的垂直距離（像素），已套用校正剖面。"""
        p0, n = ((self.lt, self.n_left) if side == "left"
                 else (self.rt, self.n_right))
        d = float(abs(np.dot(np.array(pt, float) - p0, n)))
        hs, vs = self.wall_shift[side]
        # np.interp 兩端自動維持常數，剛好是保守行為：超出有樣本的高度範圍時
        # 沿用最近那一層的校正量，不做外推。
        return d - float(np.interp(self.height_above_outlet_px(pt), hs, vs))

    def wall_normal_angle_phys(self, side):
        """壁法向量的方向角（物理座標，deg）。影像 y 向下，所以 y 分量反號。"""
        n = self.n_left if side == "left" else self.n_right
        return float(np.degrees(np.arctan2(-n[1], n[0])))

    def support_mm(self, angle_major_deg, side):
        """橢圓接觸直線壁時，質心到壁的垂直距離（mm）—— 支撐函數。

            h(n) = sqrt(A² n₁² + B² n₂²)

          A : 長半軸（mm）   B : 短半軸（mm）
          n : 壁的單位法向量，表示在「以該顆長軸為 x 軸」的座標系裡
              → 夾角 ψ =（壁法向量方向角）−（該顆長軸方向角），
                n₁ = cos ψ、n₂ = sin ψ
        檢驗：n 沿長軸時 h = A；沿短軸時 h = B。

        【為什麼不能直接用長軸半徑當門檻】
        用長軸半徑 A 的話，最糟情況是顆粒短軸朝向壁（長軸平行於壁），此時表面
        離質心只有 B，壁與顆粒表面之間還剩 A − B 的空隙。以 d_eq = 9.5 mm、
        α = 3.5 計，A − B = 6.35 mm，而另一顆的最窄處（短軸）只有 5.08 mm ——
        塞得下一整顆，也就是會把「和壁之間還夾著一顆」的顆粒判成接觸壁。
        這個誤差隨 α 單調放大（α = 1 時為 0），正好會污染我們要量的 α 效應。
        """
        A = self.g.ra / self.g.s
        B = self.g.rb / self.g.s
        if WALL_CONTACT_MODE != "support":
            return WALL_RADIUS_MM if WALL_RADIUS_MM else self.g.d_eq_mm / 2.0
        if np.isnan(angle_major_deg):
            # 圓盤的朝向是 NaN（postprocess 會清掉），此時 A = B，取哪個都一樣
            return self.g.d_eq_mm / 2.0
        psi = np.radians(self.wall_normal_angle_phys(side) - angle_major_deg)
        return float(np.hypot(A * np.cos(psi), B * np.sin(psi)))

    def wall_contact(self, pt, angle_major_deg):
        """回傳 "left" / "right" / "none"。pt 是全圖座標。"""
        best, best_gap = "none", np.inf
        for side in ("left", "right"):
            d_mm = self.dist_to_wall(pt, side) / self.g.s
            gap = d_mm - WALL_CONTACT_FACTOR * self.support_mm(angle_major_deg, side)
            if gap <= 0 and gap < best_gap:
                best, best_gap = side, gap
        return best

    def to_physical_mm(self, pt):
        """全圖影像座標 → 物理座標 (x_mm, y_mm)，原點在出口中點、y 向上。"""
        return (float((pt[0] - self.outlet_mid[0]) / self.g.s),
                float((self.outlet_y_px - pt[1]) / self.g.s))

    def wall_x_at(self, side, h_px):
        """某面壁在某高度處的影像 x 座標（用來判斷它有沒有跑出畫面）。"""
        p_up, p_dn = ((self.lt, self.lb) if side == "left" else (self.rt, self.rb))
        y = self.outlet_y_px - h_px
        dy = p_dn[1] - p_up[1]
        if abs(dy) < 1e-6:
            return float(p_up[0])
        t = (y - p_up[1]) / dy
        return float(p_up[0] + t * (p_dn[0] - p_up[0]))

    def inside_mask(self, shape, top_px, full_height=False):
        """筒倉內部的遮罩（全圖座標、uint8 0/255）。

        這一步非常重要：它把出口以下已經掉出去的顆粒、以及壁外面的反光和人影
        全部排除掉。沒有它，掉落中的顆粒會被當成筒倉內的顆粒。
        四個邊界都往外放寬一點，免得貼著邊的顆粒被削掉一半（見 MASK_MARGIN_RATIO）。
        """
        h, w = shape[:2]
        yy, xx = np.mgrid[0:h, 0:w]
        pts = np.stack([xx, yy], axis=-1).astype(np.float32)
        mar = MASK_MARGIN_RATIO * self.g.d_eq_px
        out_mar = OUTLET_MARGIN_RATIO * self.g.d_eq_px
        m = np.ones((h, w), bool)
        for p0, n in ((self.lt, self.n_left), (self.rt, self.n_right)):
            m &= ((pts - p0) @ n) >= -mar
        m &= yy <= self.outlet_y_px + out_mar
        if not full_height:
            m &= yy >= (self.outlet_y_px - top_px - mar)
        return m.astype(np.uint8) * 255

    def outlet_width_mm_corrected(self):
        return (self.outlet_width_px
                - float(np.interp(0.0, *self.wall_shift["left"]))
                - float(np.interp(0.0, *self.wall_shift["right"]))) / self.g.s

    def to_dict(self):
        return {
            "left_top": self.lt.tolist(), "left_bottom": self.lb.tolist(),
            "right_bottom": self.rb.tolist(), "right_top": self.rt.tolist(),
            "px_per_mm": self.g.s,
            "b_mm": self.g.b_mm, "alpha": self.g.alpha,
            "d_eq_mm": self.g.d_eq_mm,
            "outlet_width_px": self.outlet_width_px,
            "outlet_width_mm_raw": self.outlet_width_px / self.g.s,
            "outlet_width_mm_corrected": self.outlet_width_mm_corrected(),
            "wall_half_angle_deg": WALL_HALF_ANGLE_DEG,
            "wall_shift_px": {k: [v[0].tolist(), v[1].tolist()]
                              for k, v in self.wall_shift.items()},
        }


def refine_walls_from_particles(df, silo, emit=print):
    """用「全片所有顆粒」自動校正壁線。回傳 {"left": (高度, 校正量), "right": ...}。

    原理
    ----
    貼著壁的那些顆粒，質心到壁的垂直距離應該剛好等於自己的支撐函數 h。
    對每顆算殘差 r =（實際距離 − 理論 h），殘差分布的「下緣」就是壁線的誤差：
      下緣 > 0  →  壁線點得太外面，要往筒倉內部移
      下緣 < 0  →  壁線點得太裡面，要往外移

    【為什麼用主迴圈跑完的全部顆粒，而不是另外抽樣幾十幀】
    壁接觸只是輸出的一個欄位，偵測、追蹤、接觸網路都不依賴它，所以可以等到
    最後再算。這樣樣本從「抽樣 30 幀」變成「全片所有幀」，而且完全免費。
    實測抽樣時最低的兩層各只有 60 顆、低於門檻而被跳過，於是出口附近的校正量
    只能從上面外推 —— 而那裡正是拱所在的位置。

    【為什麼按高度分層成剖面，而不是擬合一條直線】
    見 REFINE_N_BANDS 的說明。
    """
    gm = silo.g
    P = df[["x_px_full", "y_px_full"]].values.astype(float)
    hgt = silo.outlet_y_px - P[:, 1]
    ang = df["theta_for_wall_deg"].values

    resid = {}
    for side in ("left", "right"):
        p0 = silo.lt if side == "left" else silo.rt
        nvec = silo.n_left if side == "left" else silo.n_right
        d_px = np.abs((P - p0) @ nvec)        # 刻意用「未校正」的距離
        h_mm = np.array([silo.support_mm(a, side) for a in ang])
        resid[side] = np.column_stack([hgt, d_px - h_mm * gm.s])

    # 壁線校正只在出口上方這個高度範圍內分層（楔形段）。DETECT_HEIGHT_FACTOR
    # 設成 None 時改用實際資料的高度上限，不然 linspace 會算不出來。
    if DETECT_HEIGHT_FACTOR is None:
        _all_h = np.concatenate([resid["left"][:, 0], resid["right"][:, 0]])
        top_px = float(np.percentile(_all_h, 95)) if len(_all_h) else gm.d_eq_px
    else:
        top_px = DETECT_HEIGHT_FACTOR * gm.d_eq_px
    edges = np.linspace(0, max(top_px, 1.0), REFINE_N_BANDS + 1)
    W_img = int(df["img_w"].iloc[0]) if "img_w" in df.columns else 10 ** 6
    shifts = {}
    for side in ("left", "right"):
        arr = resid[side]
        hs, rs, ns = [], [], []
        emit(f"  {side:5s} 壁：各高度分層的殘差下緣（理想值是 0）")
        for k in range(REFINE_N_BANDS):
            m = (arr[:, 0] >= edges[k]) & (arr[:, 0] < edges[k + 1])
            band = (f"{edges[k] / gm.d_eq_px:.1f}-"
                    f"{edges[k + 1] / gm.d_eq_px:.1f} d")
            if m.sum() < REFINE_MIN_PER_BAND:
                emit(f"        {band:>12s}  n={int(m.sum()):6d}  樣本太少，跳過")
                continue
            # 【防呆】這個高度的壁若已經跑出畫面，「離壁最近的顆粒」其實是被
            # 畫面邊緣擋住的，不是真的貼著壁，殘差會失真。
            wx = silo.wall_x_at(side, 0.5 * (edges[k] + edges[k + 1]))
            if wx < -2 or wx > W_img + 2:
                emit(f"        {band:>12s}  n={int(m.sum()):6d}  "
                     f"壁在這個高度已經出畫面（x={wx:.0f}），跳過")
                continue
            # 下緣：取第 k 小的值。直接用分位數的話，小樣本會退化成取最小值。
            vals = np.sort(arr[m, 1])
            kk = min(len(vals) - 1,
                     max(REFINE_MIN_TAIL, int(round(REFINE_QUANTILE * len(vals)))))
            r_mm = float(vals[kk]) / gm.s
            emit(f"        {band:>12s}  n={int(m.sum()):6d}  {r_mm:+6.2f} mm")
            hs.append(0.5 * (edges[k] + edges[k + 1]))
            rs.append(r_mm * gm.s)
            ns.append(int(m.sum()))

        if len(hs) < 2:
            shifts[side] = (np.array([0.0, 1.0]), np.array([0.0, 0.0]))
            emit("        有效分層不足，不校正")
            continue

        hs_a, rs_a = np.array(hs, float), np.array(rs, float)
        # ---- 剔除離群層（見 REFINE_OUTLIER_MM）----
        if len(rs_a) >= 3:
            trend = np.array([np.median(rs_a[max(0, k - 1):k + 2])
                              for k in range(len(rs_a))])
            dev_mm = np.abs(rs_a - trend) / gm.s
            keep = dev_mm <= REFINE_OUTLIER_MM
            for k in np.where(~keep)[0]:
                emit(f"        ↳ 剔除 {hs_a[k] / gm.d_eq_px:.1f} d 這層："
                     f"偏離鄰近趨勢 {dev_mm[k]:.1f} mm，"
                     f"該高度多半沒有顆粒真的貼著壁")
            if keep.sum() >= 2:
                hs_a, rs_a = hs_a[keep], rs_a[keep]
        # ---- 輕度平滑：壓掉單層的統計雜訊，但不像直線擬合那樣抹掉真實彎曲 ----
        if len(rs_a) >= 3:
            sm = rs_a.copy()
            for k in range(1, len(rs_a) - 1):
                sm[k] = (rs_a[k - 1] + 2 * rs_a[k] + rs_a[k + 1]) / 4.0
            rs_a = sm
        shifts[side] = (hs_a, rs_a)

        lin = np.polyfit(hs_a, rs_a, 1)
        dev = rs_a - np.polyval(lin, hs_a)
        rms_mm = float(np.sqrt((dev ** 2).mean()) / gm.s)
        emit(f"        → 剖面：出口側 {rs_a[0] / gm.s:+.2f} mm，"
             f"最高層 {rs_a[-1] / gm.s:+.2f} mm（{len(hs_a)} 層）")
        emit(f"           偏離直線 RMS {rms_mm:.2f} mm "
             f"{'← 壁確實是彎的，直線擬合會出錯' if rms_mm > 0.4 else '（接近直線）'}")
    return shifts


