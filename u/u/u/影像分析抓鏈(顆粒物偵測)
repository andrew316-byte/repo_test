# 階段 2：次像素精化（預設關閉）
# ==========================================================================

def refine_subpixel(gray, labels, particles, geom):
    """用灰階模型擬合精化質心。

    模型（自行推導，非參考論文）：
        I(x,y) = I_bg + (I_fg − I_bg) · S( −d(x,y; xc,yc,θ) / w )
    其中 d 是到「中心 (xc,yc)、朝向 θ、半軸鎖死為 (ra, rb) 的橢圓」的帶號距離，
    S 是 sigmoid，w 是邊緣寬度（鏡頭 PSF + 壓縮造成的模糊，約 1–2 px）。

    次像素資訊來自邊緣像素的灰階值：被顆粒蓋住 30% 的像素，讀數就是
    I_bg + 0.30·(I_fg − I_bg)。二值化會把這個資訊丟掉。

    尺寸 (ra, rb) 鎖死，因為顆粒單分散且尺寸已知。好處是擬合能「看穿」
    分水嶺的切線 —— 接觸處被直線切掉的那塊，模型知道本來該有顆粒。

    【實測效果】在 56_1.mp4 的靜止段上，σ_c 從 0.114 px 降到 0.093 px，
    只改善 18%，但慢約 100 倍。真實誤差主因是模型抓不到的東西（顆粒不是
    完美圓、壓縮假影、分水嶺切線游移），不是二值化丟掉灰階。
    預設關閉。要降雜訊請優先提高 px/mm。
    """
    g = gray.astype(float)
    H, W = g.shape
    P = SUBPIX_PATCH
    for p in particles:
        x0, y0 = int(round(p["x"])), int(round(p["y"]))
        ys, ye = max(0, y0 - P), min(H, y0 + P)
        xs, xe = max(0, x0 - P), min(W, x0 + P)
        sub, sl = g[ys:ye, xs:xe], labels[ys:ye, xs:xe]
        sm = (sl == p["label"]).astype(np.uint8)
        # 用本標籤 + 外擴一圈（含邊緣灰階），但排除被鄰居佔走的像素
        use = (cv2.dilate(sm, np.ones((7, 7), np.uint8)) > 0) & ((sl == p["label"]) | (sl <= 0))
        if use.sum() < 200:
            p["refined"] = False
            continue
        yy, xx = np.mgrid[ys:ye, xs:xe]
        X, Y, I = xx[use].astype(float), yy[use].astype(float), sub[use]
        ra, rb, th0 = geom.ra, geom.rb, np.deg2rad(p["theta"])

        def residual(q):
            xc, yc, ifg, ibg, w, th = q
            dx, dy = X - xc, Y - yc
            ct, st = np.cos(th), np.sin(th)
            u, v = dx * ct + dy * st, -dx * st + dy * ct
            # 橢圓的近似帶號距離
            r = np.hypot(u / ra, v / rb)
            d = (r - 1.0) * rb
            return ibg + (ifg - ibg) / (1 + np.exp(np.clip(d / max(w, 0.3), -50, 50))) - I

        try:
            sol = least_squares(residual,
                                [p["x"], p["y"], I.max(), I.min(), 1.2, th0],
                                method="lm", xtol=1e-8, max_nfev=200)
            shift = np.hypot(sol.x[0] - p["x"], sol.x[1] - p["y"])
            if shift < SUBPIX_MAX_SHIFT:
                p["x"], p["y"] = float(sol.x[0]), float(sol.x[1])
                if not geom.is_disc:
                    p["theta"] = float(np.rad2deg(sol.x[5]) % 180.0)
                p["fit_residual"] = float(np.sqrt(np.mean(sol.fun ** 2)))
                p["refined"] = True
            else:
                p["refined"] = False
        except Exception:
            p["refined"] = False
    return particles


