def auto_roi(frame):
    """自動偵測 pillarbox 黑邊。直幅影片被塞進橫幅容器時左右會有大片純黑。"""
    g = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
    cols = np.where(g.max(axis=0) > 20)[0]
    rows = np.where(g.max(axis=1) > 20)[0]
    if len(cols) == 0 or len(rows) == 0:
        return None
    return int(cols.min()), int(rows.min()), int(cols.max()) + 1, int(rows.max()) + 1


def smooth_thresholds(ts, window):
    """對每幀的 Otsu 閾值做時間中位數平滑。"""
    if window <= 1:
        return ts
    half = window // 2
    out = np.empty_like(ts)
    for i in range(len(ts)):
        lo, hi = max(0, i - half), min(len(ts), i + half + 1)
        out[i] = np.median(ts[lo:hi])
    return out


def main():
    # 【Windows 編碼相容】
    # 繁體中文 Windows 的預設編碼是 cp950，寫不了某些 Unicode 字元
    # （例如 U+2212 數學減號「−」，和鍵盤上的連字號「-」是不同字元）。
    # 檔案一律用 encoding="utf-8-sig" 寫；終端機輸出這裡也一併轉成 UTF-8，
    # 失敗就退回預設（舊版 Python 沒有 reconfigure）。
    try:
        sys.stdout.reconfigure(encoding="utf-8", errors="replace")
        sys.stderr.reconfigure(encoding="utf-8", errors="replace")
    except Exception:
        pass

    ap = argparse.ArgumentParser()
    ap.add_argument("--video", default=VIDEO_PATH)
    ap.add_argument("--outdir", default=OUT_DIR)
    ap.add_argument("--preview", action="store_true", help="只跑前 60 幀")
    ap.add_argument("--subpixel", action="store_true", help="開啟次像素精化")
    ap.add_argument("--max-frames", type=int, default=MAX_FRAMES)
    ap.add_argument("--no-video", action="store_true")
    ap.add_argument("--plots", action="store_true", help="輸出品質診斷圖")
    ap.add_argument("--no-contacts", action="store_true", help="不算接觸網路與 θ/φ")
    ap.add_argument("--contact-stride", type=int, default=CONTACT_STRIDE)
    ap.add_argument("--recalib", action="store_true", help="強制重新標定壁線")
    args = ap.parse_args()

    global SUBPIXEL
    if args.subpixel:
        SUBPIXEL = True

    os.makedirs(args.outdir, exist_ok=True)

    print("=" * 70)
    print("程式一：顆粒偵測 + 追蹤 + 接觸網路 + 筒倉幾何")
    print("=" * 70)
    print(f"次像素 : {'開' if SUBPIXEL else '關'}")

    cap = cv2.VideoCapture(args.video)
    if not cap.isOpened():
        sys.exit(f"讀不到影片：{args.video}")
    n_total = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))
    container_fps = cap.get(cv2.CAP_PROP_FPS)
    fps = float(FPS) if FPS else float(container_fps)
    print(f"容器   : {n_total} 幀, metadata fps = {container_fps:.3f}")
    print(f"拍攝幀率: {fps:.3f} fps  ←── 速度換算用這個"
          + ("" if FPS_VERIFIED else "   ⚠ 未經自由落下測試驗證"))
    if abs(container_fps - fps) > 1:
        print(f"  ※ 和容器 metadata 不符 → 這是慢動作輸出（{fps/container_fps:.1f}x）。"
              f"若不是，請改 FPS 設定。")
    else:
        print(f"  ※ 和容器一致 → 原生高幀率檔，沒有慢動作換算。")
    print(f"影片真實長度: {n_total / fps:.2f} s")
    print(f"δt     : 0.018 s × {fps:.0f} = {0.018*fps:.2f} 幀"
          f"   (SG 微分視窗 {SG_WINDOW} 幀)")
    if SG_WINDOW > 0.018 * fps * 1.5:
        print(f"  ⚠ SG 視窗 ({SG_WINDOW}) 大於 δt ({0.018*fps:.1f} 幀)，"
              f"可能抹掉真實訊號")

    ok, first = cap.read()
    if not ok:
        sys.exit("讀不到第一幀")
    H, W = first.shape[:2]

    # ====================================================================
    # 階段 0：幾何標定
    # ====================================================================
    geom_json = os.path.join(args.outdir, "geometry.json")
    pts = None
    screw_pts = None
    roi_saved = None
    if os.path.exists(geom_json) and not args.recalib:
        try:
            with open(geom_json, "r", encoding="utf-8-sig") as fh:
                _g = json.load(fh)
            pts = [_g["left_top"], _g["left_bottom"],
                   _g["right_bottom"], _g["right_top"]]
            screw_pts = _g.get("screw_pts")
            roi_saved = _g.get("roi")
            print(f"\n[0] 已讀取既有的標定：{geom_json}")
            print(f"    壁角 4 點 ✓   螺絲 {'✓' if screw_pts else '✗（要重點）'}"
                  f"   ROI {'✓' if roi_saved else '✗（要重框）'}")
            print("    要全部重新標定：加 --recalib，或把這個檔刪掉")
        except Exception as e:
            print(f"\n[0] 標定檔讀不出來（{e}），重新標定")
            pts = None
    if pts is None:
        print("\n[0] 請在跳出的視窗點四個點定出筒倉……")
        cap_c = cv2.VideoCapture(args.video)
        cap_c.set(cv2.CAP_PROP_POS_FRAMES, max(0, n_total - 20))
        okc, calib_frame = cap_c.read()
        cap_c.release()
        if not okc:
            calib_frame = first
        pts = pick_geometry(calib_frame)
    print(f"    左壁上 {np.round(pts[0], 1)}   左壁下 {np.round(pts[1], 1)}")
    print(f"    右壁上 {np.round(pts[3], 1)}   右壁下 {np.round(pts[2], 1)}")

    # ---------- 比例尺：兩顆螺絲 ----------
    # 【為什麼在這裡、在裁 ROI 之前】比例尺必須用整張未裁切的原始影格量，
    # 這樣 ROI 怎麼設都不影響標定。螺絲在出口附近、筒倉壁外側，ROI 切在出口
    # 之後就不在畫面裡了，所以更要先量。
    screw_diag = None
    if PX_PER_MM is not None:
        px_per_mm = float(PX_PER_MM)
        print(f"    比例尺：設定檔直接指定 {px_per_mm:.4f} px/mm（跳過螺絲標定）")
    else:
        if screw_pts is None or SCREW_RECLICK or args.recalib:
            print("\n[0b] 請在跳出的視窗點兩顆螺絲的十字中心……")
            screw_pts = pick_screws(first)
            print(f"     你點的位置：左 {np.round(screw_pts[0], 1)}"
                  f"   右 {np.round(screw_pts[1], 1)}")
        px_per_mm, screw_diag = measure_screw_scale(args.video, n_total,
                                                    screw_pts)

    geom = Geom(B_MM, ALPHA, px_per_mm)
    silo = SiloGeometry(pts, geom)
    print(f"    幾何   : {geom}")
    print(f"    等效直徑 d_eq = {geom.d_eq_px:.1f} px = {geom.d_eq_mm:.2f} mm")
    print(f"    出口寬度 : {silo.outlet_width_px:.1f} px = "
          f"{silo.outlet_width_px / px_per_mm:.1f} mm"
          f"   （你量到的是 {OUTLET_WIDTH_MM} mm）")
    _dev = abs(silo.outlet_width_px / px_per_mm - OUTLET_WIDTH_MM)
    if _dev > 0.15 * OUTLET_WIDTH_MM:
        print(f"    ⚠ 和你量到的差 {_dev:.1f} mm —— 壁線多半點歪了，"
              f"請加 --recalib 重點")
    print(f"    搜尋半徑: {SEARCH_RADIUS_RATIO * geom.b_px:.1f} px")

    # ---------- ROI：手動框（整張原始影格）----------
    # 【為什麼改成手動】舊版由筒倉幾何自動推導，畫面被縮得太小。而且 A12 要用
    # 「ROI 內的顆粒數減少量」當流出顆粒數，那就必須由你親自確認「所有顆粒都在
    # 框內」—— 程式沒辦法替你判斷料堆最高時到哪裡。
    # DETECT_HEIGHT_FACTOR = None → 不設高度上限，整個 ROI 都偵測（A12 要用）
    if DETECT_HEIGHT_FACTOR is None:
        mask_full = silo.inside_mask(first.shape, 0, full_height=True)
        print("    偵測高度：不設上限（整個 ROI）")
    else:
        mask_full = silo.inside_mask(first.shape,
                                     DETECT_HEIGHT_FACTOR * geom.d_eq_px)
        print(f"    偵測高度：出口上方 {DETECT_HEIGHT_FACTOR:.0f} d_eq 以內")
    ys_, xs_ = np.where(mask_full > 0)
    if len(ys_) == 0:
        sys.exit("筒倉遮罩是空的 —— 標定點可能點錯了。")
    if ROI is not None:
        x0, y0, x1, y1 = ROI
        src = "設定檔寫死"
    elif roi_saved is not None and not (ROI_RESELECT or args.recalib):
        x0, y0, x1, y1 = roi_saved
        src = "讀自 geometry.json"
    else:
        print("\n[0c] 請在跳出的視窗拖一個矩形當分析範圍……")
        print("     上緣要高過料堆最高時的自由表面；下緣切在出口；左右比壁寬一些")
        x0, y0, x1, y1 = pick_roi(first)
        src = "你剛框的"
    if not (0 <= x0 < x1 <= W and 0 <= y0 < y1 <= H):
        sys.exit(f"ROI ({x0},{y0},{x1},{y1}) 超出影像範圍 ({W}×{H})")
    print(f"    ROI（{src}）: ({x0},{y0},{x1},{y1}) → {x1-x0}×{y1-y0}"
          f"（整張的 {100*(x1-x0)*(y1-y0)/(W*H):.1f}%）")
    # 檢查 ROI 有沒有把筒倉切掉
    _cut = []
    if xs_.min() < x0: _cut.append("左")
    if xs_.max() >= x1: _cut.append("右")
    if ys_.max() >= y1: _cut.append("下")
    if _cut:
        print(f"    ⚠ ROI 把筒倉的{'、'.join(_cut)}側切掉了 —— "
              f"那一側的壁接觸會判不到，鏈會抓不出來")
    ROI_HEIGHT_PX[0] = y1 - y0
    ROI_OFFSET[0], ROI_OFFSET[1] = x0, y0
    SILO_MASK_ROI = mask_full[y0:y1, x0:x1]
    SILO_MASK_FULL_H = silo.inside_mask(first.shape, 0, full_height=True)

    limit = 60 if args.preview else (args.max_frames or n_total)

    # ---------- 第一遍：只收集每幀的 Otsu 閾值（不存影像，省記憶體）----------
    print(f"\n[1/3] 掃描 Otsu 閾值（{limit} 幀）…")
    cap.set(cv2.CAP_PROP_POS_FRAMES, 0)
    thresholds = []
    t_start = time.time()
    for idx in range(limit):
        ok, frame = cap.read()
        if not ok:
            break
        ch = get_channel(frame[y0:y1, x0:x1], CHANNEL)
        _, t = binarize(ch, mask=SILO_MASK_ROI)
        thresholds.append(t)
        if idx % 200 == 0:
            print(f"    {idx}/{limit}", end="\r")
    cap.release()
    n_frames = len(thresholds)

    thr_s = smooth_thresholds(np.array(thresholds), OTSU_SMOOTH_FRAMES)
    print(f"    Otsu 閾值 {min(thresholds):.0f}–{max(thresholds):.0f}"
          f"（平滑後 {thr_s.min():.0f}–{thr_s.max():.0f}）")

    # ---------- 第二遍：重新讀檔，用平滑後的閾值分割 + 追蹤 ----------
    print(f"\n[2/3] 分割與連結…")
    cap = cv2.VideoCapture(args.video)
    tracker = Tracker(geom)
    diag = []
    # 分析窗（出口上方 4 d_eq）的外接框，差分指標只看這一塊
    _am = silo.inside_mask(first.shape, ANALYSIS_HEIGHT_FACTOR * geom.d_eq_px) > 0
    _ay, _ax = np.where(_am)
    AY0, AY1 = int(_ay.min()), int(_ay.max()) + 1
    AX0, AX1 = int(_ax.min()), int(_ax.max()) + 1
    diffs_list, fill_list, prev_small = [], [], None
    qc_rows = []
    templates = make_templates(geom) if SEED_METHOD == "matched" else None
    if templates is not None:
        print(f"    匹配濾波模板：{len(templates)} 個朝向，"
              f"核大小 {templates[0][1].shape[0]}×{templates[0][1].shape[1]} px")
    do_contacts = COMPUTE_CONTACTS and not args.no_contacts
    contact_edges, contact_tris = [], []
    for idx in range(n_frames):
        ok, frame = cap.read()
        if not ok:
            break
        ch = get_channel(frame[y0:y1, x0:x1], CHANNEL)
        bw, _ = binarize(ch, forced_threshold=thr_s[idx], mask=SILO_MASK_ROI)
        labels, dist, cleaned, extra = segment(bw, geom, templates)
        is_qc = bool(QC_INTERVAL) and idx % QC_INTERVAL == 0
        if SEED_METHOD == "matched" and FIXED_SHAPE:
            # 主線：種子來自匹配濾波，形狀鎖成設計值，只擬合位置（與朝向）
            dets = fit_fixed_shape(extra["peaks"], extra["response"],
                                   extra["angle"], labels, geom,
                                   silo_mask=SILO_MASK_ROI)
            # 自由擬合：給篩選用的形狀判準，順便供品保通道取樣
            free_rows = (qc_free_fit(labels, geom)
                         if (DETECT_USE_FREE_AR or is_qc) else [])
            free_ar = {r["label"]: r["aspect_ratio_free"] for r in free_rows}
            # 自由擬合量到的朝向也帶過去：主線的 theta 在 α=1 時恆為 0，
            # 品質報告的「系統性變形檢查」只能用這一欄。
            free_th = {r["label"]: r["theta_deg"] for r in free_rows}
            for _d in dets:
                _d["theta_free"] = free_th.get(_d["label"], np.nan)
            dets = filter_particles(dets, geom,
                                    free_ar if DETECT_USE_FREE_AR else None)
        else:
            # 退路：舊的自由 fitEllipse（SEED_METHOD="hmax" 或 FIXED_SHAPE=False）
            dets = fit_particles(labels, geom)
            free_rows = (qc_free_fit(labels, geom) if is_qc else [])
        if SUBPIXEL:
            dets = refine_subpixel(ch, labels, dets, geom)
        tracker.step(idx, dets)

        # ---- 品保通道：每隔 QC_INTERVAL 幀記錄一次「真實形狀」----
        # 主線鎖了 a、b，所以主線的 aspect_ratio 恆等於 α、沒有資訊量。
        # 這裡記的是放開 5 個自由度量到的形狀，用途有二：
        #   aspect_ratio_free 偏離 α 多少 → 顆粒加工精度 + 影像幾何變形
        #   area_ratio 偏離 1.0 多少      → 分割有沒有成功
        # 這條線不進任何分析，只寫進 qc_shape.csv。
        if is_qc and free_rows:
            # 【一定要記錄「全部」區域，不能只記錄通過篩選的】
            # 篩選條件就是 |aspect_ratio_free − α| ≤ DETECT_AR_DEV，如果只把
            # 通過的記下來，那 qc_shape.csv 裡的形狀偏差必然全部合格 ——
            # 這是定義造成的恆真，不是品質變好。體溫計量的是「篩選之前」。
            # kept 欄位標記這一列有沒有進到主線，兩種統計都看得到。
            keep = {d["label"] for d in dets}
            for r in free_rows:
                r["frame"] = idx
                r["kept"] = r["label"] in keep
                qc_rows.append(r)
        if do_contacts and idx % args.contact_stride == 0 and dets:
            e, t = build_contacts(idx, dets, labels, geom)
            contact_edges.extend(e)
            contact_tris.extend(t)
        # ---- 順便量兩件事，後面判斷流動狀態與 avalanche 要用 ----
        # (a) 分析窗內的逐幀灰階差分：看畫面有沒有在動
        # (b) 整個筒倉內的前景面積 ÷ 一顆的面積：看顆粒有沒有真的流出去
        gsmall = cv2.cvtColor(frame[AY0:AY1, AX0:AX1],
                              cv2.COLOR_BGR2GRAY).astype(np.float32)
        diffs_list.append(0.0 if prev_small is None
                          else float(np.abs(gsmall - prev_small).mean()))
        prev_small = gsmall
        fill_list.append(float((get_channel(frame, CHANNEL)[SILO_MASK_FULL_H > 0]
                                > thr_s[idx]).sum()) / geom.area)

        diag.append(dict(frame=idx, otsu=thr_s[idx], n_seeds=int(labels.max()),
                         n_detected=len(dets),
                         fg_fraction=float((cleaned > 0).mean()),
                         roi_area_px=int(cleaned.size),
                         dist_over_r=float(dist.max() / geom.rb)))
        if idx % 50 == 0:
            print(f"    {idx}/{n_frames}  顆粒 {len(dets):3d}  "
                  f"活躍軌跡 {len(tracker.tracks):3d}", end="\r")
    cap.release()
    elapsed = time.time() - t_start
    print(f"    完成，耗時 {elapsed:.1f} s（{n_frames/max(elapsed,1e-9):.1f} 幀/秒）")
    limit = n_frames

    # ---------- 第三遍：後處理與輸出 ----------
    print(f"\n[3/3] 後處理與輸出…")
    df = pd.DataFrame(tracker.rows)
    if df.empty:
        sys.exit("沒有偵測到任何顆粒。請檢查 ROI、CHANNEL、PX_PER_MM 設定。")
    df = postprocess(df, geom, fps)
    df["img_w"] = W

    # ---- 品質指標 ----
    q = per_frame_quality(df, geom, diag)
    df = df.merge(q[["frame", "bad_frame", "bad_reason", "n_bad_flags"]],
                  on="frame", how="left")
    df["bad_frame"] = df["bad_frame"].fillna(False)

    # ====================================================================
    # 階段 5：筒倉幾何 —— 壁線校正 → 壁接觸 → 物理座標
    # ====================================================================
    # 這一段放在追蹤之後，是刻意的：壁接觸只是輸出的一個欄位，偵測、追蹤、
    # 接觸網路都不依賴它，所以可以等到最後再算，而且可以用「全片所有顆粒」
    # 當校正樣本，不必另外抽樣。
    print("\n[階段 5] 筒倉幾何")
    if AUTO_REFINE_WALLS and len(df):
        print(f"  自動校正壁線（用全片 {len(df):,} 顆顆粒）")
        silo.wall_shift = refine_walls_from_particles(df, silo)
        print(f"  校正後的出口寬度：{silo.outlet_width_mm_corrected():.1f} mm"
              f"   (D / d_eq = {silo.outlet_width_mm_corrected()/geom.d_eq_mm:.2f})")
        print(f"  你量到的是 {OUTLET_WIDTH_MM} mm"
              f"（差 {abs(silo.outlet_width_mm_corrected()-OUTLET_WIDTH_MM):.1f} mm）")

    # 把三組標定一起存起來：壁角 4 點、螺絲 2 點、ROI 矩形。
    # 之後重跑同一支影片就直接讀檔，三個點擊步驟都跳過。
    _gd = silo.to_dict()
    if screw_pts is not None:
        _gd["screw_pts"] = [[float(q) for q in p] for p in screw_pts]
        _gd["screw_distance_mm"] = SCREW_DISTANCE_MM
    if screw_diag is not None:
        _gd["screw_diag"] = screw_diag
    _gd["roi"] = [int(x0), int(y0), int(x1), int(y1)]
    _gd["px_per_mm"] = float(geom.s)
    _gd["b_mm"] = float(B_MM)
    with open(geom_json, "w", encoding="utf-8-sig") as fh:
        json.dump(_gd, fh, ensure_ascii=False, indent=2)

    # 物理座標（原點在出口中點、y 向上）與壁接觸
    pxy = df[["x_px_full", "y_px_full"]].values
    df["x_out_mm"] = (pxy[:, 0] - silo.outlet_mid[0]) / geom.s
    df["y_out_mm"] = (silo.outlet_y_px - pxy[:, 1]) / geom.s
    df["dist_wall_mm"] = [min(silo.dist_to_wall(p, "left"),
                              silo.dist_to_wall(p, "right")) / geom.s
                          for p in pxy]
    df["wall"] = [silo.wall_contact(p, a)
                  for p, a in zip(pxy, df["theta_for_wall_deg"].values)]
    df["in_window"] = (df["y_out_mm"] >= 0) & \
                      (df["y_out_mm"] <= ANALYSIS_HEIGHT_FACTOR * geom.d_eq_mm)
    print(f"  分析窗（出口上方 {ANALYSIS_HEIGHT_FACTOR:.0f} d_eq = "
          f"{ANALYSIS_HEIGHT_FACTOR*geom.d_eq_mm:.0f} mm）內："
          f"觸左壁 {(df['wall'][df['in_window']]=='left').sum()} 次，"
          f"觸右壁 {(df['wall'][df['in_window']]=='right').sum()} 次")
    _both = df[df["in_window"]].groupby("frame")["wall"].apply(
        lambda s: ((s == "left").any() and (s == "right").any()))
    print(f"  左右兩側同時有觸壁顆粒的幀：{int(_both.sum())} / {len(_both)}")
    if len(_both) and _both.mean() < 0.5:
        print("  ⚠ 這個比例偏低，程式二會找不到鏈。"
              "請看 calib_check_*.png 確認壁線，必要時 --recalib。")

    # ====================================================================
    # 階段 6：流動 / 靜止 / 偵測失效 / avalanche
    # ====================================================================
    print("\n[階段 6] 流動狀態")
    n_run = len(diag)
    diffs = np.array(diffs_list[:n_run], float)
    if len(diffs) > 1:
        diffs[0] = diffs[1]
    fill_n = np.array(fill_list[:n_run], float)
    n_det = np.array([d["n_detected"] for d in diag], float)

    # ---- 偵測失效幀 ----
    # 原因可能是手遮鏡頭、動態模糊糊成一片、或筒倉排空；程式分不出是哪一種。
    med_n = float(np.median(n_det))
    occluded = n_det < OCCLUSION_MIN_RATIO * med_n
    if OCCLUSION_DILATE > 0 and occluded.any():
        from scipy import ndimage as _nd
        occluded = _nd.binary_dilation(
            occluded, np.ones(2 * OCCLUSION_DILATE + 1, bool))
    print(f"  每幀顆粒數中位數 {med_n:.0f}，失效門檻 "
          f"{OCCLUSION_MIN_RATIO*med_n:.0f} 顆")
    print(f"  判定為偵測失效的幀：{int(occluded.sum())} / {n_run} "
          f"({100*occluded.mean():.1f}%)")
    if occluded.any():
        _s = None
        for _i in range(n_run + 1):
            _o = occluded[_i] if _i < n_run else False
            if _o and _s is None:
                _s = _i
            if not _o and _s is not None:
                print(f"    失效區間：幀 {_s}-{_i-1}"
                      f"（真實時間 {_s/fps:.2f}-{_i/fps:.2f} s）")
                _s = None
        print("    ※ 請回去看影片確認原因：(a) 有人/手進入畫面 "
              "(b) 流太快糊成一片 (c) 筒倉排空")

    # ---- A13：顆粒數「上升」的檢查 ----
    # ROI 內的顆粒數只應該往下掉（顆粒從出口流走）。如果某一段往上升，只可能是
    #   (a) 錄影中途從漏斗補料
    #   (b) ROI 上緣框太低，原本在框外的顆粒掉進畫面
    # 兩種情況下「顆粒數減少量 = 流出顆粒數」都不成立，所以要標出來。
    _roll = pd.Series(n_det).rolling(21, center=True, min_periods=5).median()
    _rise = (_roll - _roll.cummin()).fillna(0).values
    _bad_rise = _rise > COUNT_RISE_WARN
    if _bad_rise.any():
        print(f"\n  ⚠ 有 {int(_bad_rise.sum())} 幀的顆粒數比先前的最低點高出 "
              f"{COUNT_RISE_WARN} 顆以上（最多 +{_rise.max():.0f} 顆）")
        print("    ROI 內的顆粒數理應只減不增。可能原因：")
        print("      (a) 錄影中途補料 —— 那一段的 avalanche size 不可信")
        print("      (b) ROI 上緣框太低，框外的顆粒掉進畫面 —— 請重框，"
              "加 --recalib 或把 ROI_RESELECT 設成 True")
        _s = None
        for _i in range(n_run + 1):
            _o = _bad_rise[_i] if _i < n_run else False
            if _o and _s is None:
                _s = _i
            if not _o and _s is not None:
                print(f"      區間：幀 {_s}-{_i-1}")
                _s = None
    else:
        print(f"\n  顆粒數單調遞減 ✓（沒有補料，ROI 上緣夠高）")

    # ---- 流動段 ----
    # ---- 流動程度指標 ----
    # "motion"：分析窗內「逐幀位移 > MOTION_PX 的顆粒數」佔該窗顆粒數的比例。
    #           直接從追蹤結果算，不碰像素，所以對壓縮雜訊免疫。
    # "pixdiff"：舊的逐幀灰階平均絕對差（保留供 A/B 對照）。
    if FLOW_METRIC == "motion" and "in_window" in df.columns:
        # 【只採用長軌跡】手伸進畫面是突然出現又消失，軌跡很短；真顆粒的軌跡
        # 很長（實測 97.3% 的量測來自 ≥100 幀的軌跡）。用軌跡長度篩掉短的，
        # 手就不會被算成「在動的顆粒」而誤觸發 flow。螺絲是靜止的，本來就不
        # 影響這個指標。
        # 這件事很重要，因為 flow/static 會一路決定 avalanche、P_c、拱、
        # P(v) 和 p_chain(n) 的分母。
        _w = df[df["in_window"].fillna(False).astype(bool)
                & (~df["interpolated"].astype(bool))
                & (df["track_length"] >= MOTION_MIN_TRACK)]
        print(f"  流動指標只採用軌跡長度 ≥ {MOTION_MIN_TRACK} 幀的顆粒"
              f"（{len(_w):,} / {int(df['in_window'].fillna(False).sum()):,} 筆）")
        _mv = np.hypot(_w["dx_raw"].values, _w["dy_raw"].values)
        _tmp = pd.DataFrame({"frame": _w["frame"].values,
                             "moving": _mv > MOTION_PX,
                             "valid": ~np.isnan(_mv)})
        _agg = _tmp.groupby("frame").agg(nmove=("moving", "sum"),
                                         nval=("valid", "sum"))
        motion = np.zeros(n_run, float)
        for _f, _r in _agg.iterrows():
            if 0 <= int(_f) < n_run and _r["nval"] >= 5:
                motion[int(_f)] = _r["nmove"] / _r["nval"]
        metric, hi_th, lo_th = motion, FLOW_HI, FLOW_LO
        print(f"  流動指標：motion（位移 > {MOTION_PX} px 的顆粒佔比）"
              f"，門檻 {lo_th}/{hi_th}")
    else:
        metric, hi_th, lo_th = diffs, FLOW_DIFF_HI, FLOW_DIFF_LO
        print(f"  流動指標：pixdiff（逐幀灰階平均絕對差），門檻 {lo_th}/{hi_th}")

    # ---- 遲滯（hysteresis）判定 ----
    # 【這是操作型判定準則，不是物理定律】「流動 vs 靜止」在物理上是連續的，
    # 兩個門檻只是把連續量切成兩類的操作定義。
    # 單門檻在門檻附近必定抖動：9756 實測舊指標的 static 幀最大 1.997、flow 幀
    # 最小 2.009，兩群在 2.0 處完全貼住，628/912 幀擠在門檻兩側 → 狀態翻轉
    # 59 次，其中 15 次是孤立單幀。雙門檻讓單幀的雜訊尖峰無法造成來回翻轉：
    # 高於 hi 才進 flow、低於 lo 才回 static、中間維持前一幀的狀態。
    is_flow = np.zeros(n_run, bool)
    _state = False
    for _i in range(n_run):
        if _state:
            if metric[_i] < lo_th:
                _state = False
        else:
            if metric[_i] > hi_th:
                _state = True
        is_flow[_i] = _state
    _flips = int((is_flow[1:] != is_flow[:-1]).sum())
    _iso = sum(1 for _i in range(1, n_run - 1)
               if is_flow[_i] != is_flow[_i - 1] and is_flow[_i] != is_flow[_i + 1])
    print(f"  狀態翻轉 {_flips} 次，其中孤立單幀 {_iso} 次"
          f"（9756 舊版：59 次 / 15 次）")
    is_flow &= ~occluded
    burst_id = np.full(n_run, -1, np.int32)
    usable = np.zeros(n_run, bool)
    raw_bursts = []
    _i = 0
    while _i < n_run:
        if not is_flow[_i]:
            _i += 1
            continue
        _j = _i
        while _j < n_run and is_flow[_j]:
            _j += 1
        s_, e_ = _i + BURST_TRIM_FRAMES, _j - BURST_TRIM_FRAMES
        if e_ - s_ >= BURST_MIN_FRAMES:
            raw_bursts.append((s_, e_))
        _i = _j

    # ---- avalanche 真偽判定 ----
    # 逐幀差分只看得到「畫面有沒有在動」。料堆沉降、有人碰到筒倉、拿棒子戳拱，
    # 都會產生大的差分，但沒有任何顆粒流出去。
    # 【A12：流出顆粒數改用「ROI 內的顆粒數減少量」】
    #     s = N(流動段開始前) − N(流動段結束後)
    # 舊做法是「筒倉內前景總面積 ÷ 一顆的面積」，那是間接推論，會受二值化門檻
    # 和顆粒重疊影響。直接數顆粒是直接量測，前提是 ROI 要包含所有顆粒
    # （所以 A4 把 ROI 改成由你手動框，並且 DETECT_HEIGHT_FACTOR 設成 None）。
    # 前後各取 PADF 幀的中位數，免疫單幀偵測失誤。
    print(f"\n  每段流動實際流出多少顆（用來分辨真假 avalanche）")
    print(f"    流出顆粒數 = ROI 內顆粒數的減少量（前後各取 {10} 幀中位數）")
    PADF = 10
    aval_rows = []
    kept = 0
    for bi, (s_, e_) in enumerate(raw_bursts):
        before = n_det[max(0, s_ - PADF):s_]
        after = n_det[e_:min(n_run, e_ + PADF)]
        s_out = (float(np.median(before) - np.median(after))
                 if len(before) and len(after) else np.nan)
        ok_ = bool(s_out >= MIN_DISCHARGE_PARTICLES)
        print(f"    第 {bi:2d} 段  幀 {s_}-{e_-1}  "
              f"{(e_-s_)/fps*1000:6.0f} ms   流出 {s_out:+6.1f} 顆   "
              f"{'→ 採用' if ok_ else '→ 丟棄（沒有真的流出）'}")
        if ok_:
            burst_id[s_:e_] = kept
            usable[s_:e_] = True
            aval_rows.append(dict(avalanche_id=kept, start_frame=s_,
                                  end_frame=e_ - 1,
                                  duration_s=(e_ - s_) / fps,
                                  s_particles=s_out))
            kept += 1
    df_aval = pd.DataFrame(aval_rows)
    if len(df_aval):
        mean_s = float(df_aval["s_particles"].mean())
        print(f"\n  真正的 avalanche：{len(df_aval)} 次，"
              f"流出 {', '.join(f'{a:.0f}' for a in df_aval['s_particles'])} 顆")
        print(f"  平均 avalanche size <s> = {mean_s:.1f} 顆")
        print(f"  → P_c = 1 / <s> = {1/mean_s:.4f}")
        if len(df_aval) < 10:
            print(f"  ※ 只有 {len(df_aval)} 次樣本，這個 P_c 僅供參考；"
                  f"要有統計意義至少需要數十次。")
        df_aval["mean_s"] = mean_s
        df_aval["P_c"] = 1.0 / mean_s
    else:
        print("\n  沒有任何一段真的流出顆粒 —— 這支影片沒有可用的 avalanche。")

    state = np.where(occluded, "occluded", np.where(is_flow, "flow", "static"))
    print(f"\n  可用於流動統計的幀：{int(usable.sum())} / {n_run}")

    df_frames = pd.DataFrame(dict(
        frame=np.arange(n_run), t_real_s=np.arange(n_run) / fps,
        # flow_metric = 實際用來判定狀態的指標（motion 或 pixdiff，見階段 6）
        # diff_metric = 舊的灰階差分，一律保留供對照
        flow_metric=metric, diff_metric=diffs,
        # n_detected = ROI 內偵測到的顆粒數。A12 用「它的減少量」當流出顆粒數。
        # n_in_silo  = 前景總面積 ÷ 一顆的面積（舊的間接推論法），保留供對照。
        n_detected=n_det, n_in_silo=fill_n,
        occluded=occluded, state=state, burst_id=burst_id, usable=usable))
    df = df.merge(df_frames[["frame", "state", "usable", "burst_id"]],
                  on="frame", how="left")
    # 速度只在「可用的流動幀」才有物理意義
    _nv = ~df["usable"].fillna(False).astype(bool)
    for c in ("vx_mm_s", "vy_mm_s", "speed_mm_s"):
        df.loc[_nv, c] = np.nan

    cols = ["frame", "t_sec", "id", "x_px", "y_px",
            "x_px_full", "y_px_full", "x_out_mm", "y_out_mm",
            "dist_wall_mm", "wall", "in_window",
            "state", "usable", "burst_id", "fill",
            "x_mm", "y_mm",
            "major_px", "minor_px", "major_mm", "minor_mm",
            "r_eq_px", "r_eq_mm",
            "theta_deg", "theta_unwrapped_deg", "theta_raw_deg",
            # aspect_ratio：固定形狀路徑下恆等於 α，沒有資訊量（保留供相容）
            # aspect_ratio_free：自由擬合量到的真實長寬比，有資訊量的是這欄
            # mf_response：匹配濾波響應，固定形狀路徑下的形狀判準
            "aspect_ratio", "aspect_ratio_free", "theta_free_deg", "mf_response",
            "ar_deviation", "shape_outlier",
            "area_px", "area_ratio", "area_expected_px",
            "area_ratio_corrected",
            "vx_px_per_frame", "vy_px_per_frame", "speed_px_per_frame",
            "vx_mm_s", "vy_mm_s", "speed_mm_s",
            "fit_residual", "interpolated",
            "track_length", "n_measured", "n_gap", "short_track",
            "bad_frame", "bad_reason"]
    det_csv = os.path.join(args.outdir, "detections.csv")
    df[[c for c in cols if c in df.columns]].to_csv(
        det_csv, index=False, encoding="utf-8-sig")

    df_frames.to_csv(os.path.join(args.outdir, "frames.csv"),
                     index=False, encoding="utf-8-sig")

    # ---- 品保通道：真實形狀（自由擬合）----
    # 這份資料「不進任何分析」，只拿來回答兩個問題：
    #   顆粒加工精度 + 影像幾何變形有多大？（看 aspect_ratio_free 偏離 α 多少）
    #   分割有沒有成功？（看 area_ratio 偏離 1.0 多少）
    if qc_rows:
        df_qc = pd.DataFrame(qc_rows)
        df_qc["ar_dev"] = (df_qc["aspect_ratio_free"] - geom.alpha).abs()
        df_qc.to_csv(os.path.join(args.outdir, "qc_shape.csv"),
                     index=False, encoding="utf-8-sig")
        print(f"  品保通道：{len(df_qc)} 筆（每 {QC_INTERVAL} 幀取樣一次，"
              f"含未通過篩選的 {int((~df_qc['kept']).sum())} 筆）")
        for _lab, _sub in (("篩選前（全部）", df_qc),
                           ("篩選後（進主線）", df_qc[df_qc["kept"]])):
            if not len(_sub):
                continue
            _n_out = int((_sub["ar_dev"] >= AR_DEV_THRESHOLD).sum())
            print(f"    {_lab}：{len(_sub):6d} 筆  "
                  f"aspect_ratio_free 中位 {_sub['aspect_ratio_free'].median():.3f}"
                  f"（設計值 {geom.alpha:.2f}）"
                  f"  p95 {_sub['aspect_ratio_free'].quantile(.95):.3f}"
                  f"  形狀異常 {_n_out} 筆 ({100*_n_out/len(_sub):.1f}%)")
        print(f"    area_ratio（對理論）中位 "
              f"{df_qc['area_ratio'].median():.3f}（理想 1.000；"
              f">1 代表二值化門檻外擴，是系統偏差不是失敗）")
    if len(df_aval):
        df_aval.to_csv(os.path.join(args.outdir, "avalanches.csv"),
                       index=False, encoding="utf-8-sig")

    # ---- 接觸網路要帶追蹤 id：先建好 label → id 的對照表 ----
    # build_contacts 回傳的是分水嶺 label，而 label 每幀重新編號、跨幀沒有意義。
    # 實際寫檔在後面的接觸網路區塊。
    lab2id = {}
    for r in df[df["label"].notna()].itertuples():
        lab2id[(int(r.frame), int(r.label))] = int(r.id)

    # ---------- 報告 ----------
    # ---------- 報告 ----------
    report = []

    def emit(line=""):
        report.append(line)
        print(line)

    emit()
    emit("=" * 72)
    emit("結果")
    emit("=" * 72)
    emit(f"偵測總筆數      : {len(df)}  (其中內插補上 {int(df['interpolated'].sum())} 筆)")
    emit(f"軌跡條數        : {df['id'].nunique()}")
    emit(f"每幀顆粒數      : 中位數 {q.n_measured.median():.0f}, "
         f"範圍 {int(q.n_measured.min())}-{int(q.n_measured.max())}")
    emit(f"處理速度        : {n_frames/max(elapsed,1e-9):.1f} 幀/秒")

    for title, body in overall_quality(df, q, geom):
        emit()
        emit("─" * 72)
        emit(f"【{title}】")
        emit("─" * 72)
        emit(body)

    emit()
    emit("─" * 72)
    emit("【速度】")
    emit("─" * 72)
    mv = df["speed_px_per_frame"].dropna()
    raw = np.hypot(df["dx_raw"], df["dy_raw"]).dropna()
    emit(f"速度中位數      : {mv.median():.3f} px/frame = {mv.median()/geom.s*fps:.1f} mm/s")
    emit(f"速度 95 百分位  : {mv.quantile(.95):.3f} px/frame = "
         f"{mv.quantile(.95)/geom.s*fps:.1f} mm/s")
    emit(f"實際連結位移    : 99.9 百分位 {raw.quantile(.999):.2f}, "
         f"最大 {raw.max():.2f} px/frame  (搜尋半徑 {SEARCH_RADIUS_RATIO*geom.b_px:.1f})")
    emit(f"平滑後速度最大值: {mv.max():.2f} px/frame  "
         f"（微分方法：{VELOCITY_METHOD}）")
    if VELOCITY_METHOD == "sg":
        emit("  （> 連結位移屬正常，是最小平方二次擬合在速度突變處的過衝）")
    else:
        emit("  （Theil-Sen 取點對斜率的中位數，不會像最小平方那樣被單一"
             "離群點拉出過衝）")
    ratio = raw.quantile(.999) / geom.b_px
    emit(f"位移/顆粒間距   : {ratio:.2f}  (99.9 百分位)"
         + ("   ✓ < 0.5，連結安全" if ratio < 0.5
            else "   ⚠ ≥ 0.5，連結可能配錯，建議提高 fps"))
    if not FPS_VERIFIED:
        emit("  ⚠ mm/s 的數值建立在未驗證的 FPS 上")

    noise = measure_centroid_noise(df, geom)
    if noise:
        emit()
        emit("─" * 72)
        emit("【質心量測精度（從靜止幀估計）】")
        emit("─" * 72)
        emit(f"靜止幀數        : {noise['n_still_frames']}  (配對 {noise['n_pairs']})")
        emit(f"σ_c (MAD 穩健)  : {noise['sigma_c']:.4f} px"
             f"   [一般標準差會算成 {noise['sd_naive']:.4f}]")
        emit(f"推得 φ̇ 雜訊     : 162 × {noise['sigma_c']:.4f} / {noise['L']:.1f} "
             f"= {noise['phidot_noise']:.3f} deg/frame")
        emit(f"  （Zhang 對圓盤量到 σ(φ̇) = 0.14v + 1.24 deg/frame，"
             f"雜訊佔 {100*noise['phidot_noise']/1.24:.0f}%）")
        if noise["phidot_noise"] > 0.3 * 1.24:
            emit("  ⚠ 雜訊偏高。最有效的改善是提高 px/mm（不要在輸出時縮放影片）。")

    with open(os.path.join(args.outdir, "quality_report.txt"),
              "w", encoding="utf-8-sig") as f:
        f.write("\n".join(report) + "\n")

    emit()
    emit(f"輸出到 {args.outdir}/")
    emit("  detections.csv        每幀每顆一列（含品質欄位與 bad_frame 標記）")
    emit("  tracks_summary.csv    每條軌跡一列")
    emit("  frame_quality.csv     每幀的品質指標")
    emit("  quality_report.txt    上面這份報告")

    # ---------- 接觸網路與角度 ----------
    if do_contacts and contact_edges:
        ed = pd.DataFrame(contact_edges)
        tr = pd.DataFrame(contact_tris)
        for c, src in (("theta_deg", ed), ("phi_deg", tr)):
            pass
        ed["dist_mm"] = ed["dist_px"] / geom.s
        ed["x_left_mm"] = ed["x_left"] / geom.s
        ed["y_left_mm"] = ed["y_left"] / geom.s
        tr["x_center_mm"] = tr["x_center"] / geom.s
        tr["y_center_mm"] = tr["y_center"] / geom.s
        # 標上該幀是不是壞幀，方便事後篩選
        bad_map = q.set_index("frame")["bad_frame"].to_dict()
        ed["bad_frame"] = ed["frame"].map(bad_map).fillna(False)
        tr["bad_frame"] = tr["frame"].map(bad_map).fillna(False)
        # 【接觸網路要帶追蹤 id】build_contacts 是以分水嶺 label 表示的，
        # 而 label 每幀重新編號、跨幀沒有意義。程式二需要的是 id。
        ed["id_i"] = [lab2id.get((int(f), int(a)), -1)
                      for f, a in zip(ed["frame"], ed["label_left"])]
        ed["id_j"] = [lab2id.get((int(f), int(b)), -1)
                      for f, b in zip(ed["frame"], ed["label_right"])]
        n_before = len(ed)
        ed = ed[(ed["id_i"] >= 0) & (ed["id_j"] >= 0)]
        for side in ("left", "center", "right"):
            k = f"label_{side}"
            if k in tr.columns:
                tr[f"id_{side}"] = [lab2id.get((int(f), int(l)), -1)
                                    for f, l in zip(tr["frame"], tr[k])]
        ed.to_csv(os.path.join(args.outdir, "contacts.csv"), index=False,
                  encoding="utf-8-sig")
        tr.to_csv(os.path.join(args.outdir, "angles.csv"), index=False,
                  encoding="utf-8-sig")
        emit(f"  接觸網路對應到追蹤 id：{len(ed):,} / {n_before:,} 組"
             f"（對不到 id 的是被面積或填充率篩掉的區域）")

        emit()
        for title, body in summarise_angles(ed, tr, geom):
            emit("─" * 72)
            emit(f"【{title}】")
            emit("─" * 72)
            emit(body)
            emit()
        with open(os.path.join(args.outdir, "quality_report.txt"),
              "w", encoding="utf-8-sig") as f:
            f.write("\n".join(report) + "\n")
        emit("  contacts.csv          每幀每條接觸邊一列（含 θ）")
        emit("  angles.csv            每幀每個接觸三元組一列（含 φ）")
        if MAKE_PLOTS or args.plots:
            plot_angles(ed, tr, geom, args.outdir)

    if MAKE_PLOTS or args.plots:
        make_plots(df, q, geom, args.outdir, fps)
        plot_trajectories(df, geom, args.outdir, fps)

    # ---------- 驗證影片 ----------
    # ====================================================================
    # 階段 7：標定檢查圖
    # ====================================================================
    # 這是整支程式最該親眼看一次的輸出。壁接觸是一個硬門檻，壁線只要偏半個
    # 顆粒半徑，貼著壁的顆粒就會整片被判成「不觸壁」，程式二一條鏈都找不到，
    # 而且全程不會有任何錯誤訊息。
    write_calib_check(args.video, df, silo, geom, args.outdir, (x0, y0, x1, y1))

    if WRITE_VIDEO and not args.no_video:
        write_overlay(args.video, (x0, y0, x1, y1), df,
                      os.path.join(args.outdir, "tracking_overlay.mp4"),
                      limit, geom, silo=silo, fps_capture=fps)


def write_calib_check(video, df, silo, geom, outdir, roi, n_images=3):
    """輸出標定檢查圖：把校正後的壁線畫在真實畫面上。

    圖上有什麼
      綠色粗折線  校正後的壁（程式真正在用的）
      紅色細直線  你點的那四個點連成的原始直線（對照用）
      橙色水平線  出口上方的高度刻度，單位 d_eq
      紅圈 / 藍圈 判定為接觸左壁 / 右壁的顆粒
      灰圈        其他顆粒

    怎麼看
      1. 綠線要貼著壁的內緣，不能穿進顆粒裡、也不能離壁一大截
      2. 貼著壁的顆粒要被圈成紅色或藍色；整排貼壁卻是灰色 → 壁線偏外
      3. 圖上標的 D 要等於你用尺量的出口寬度
      任何一項不對，就加 --recalib 重新點一次。
    """
    print("\n[階段 7] 標定檢查圖")
    x0, y0, x1, y1 = roi

    def wall_polyline(side):
        p_up, p_dn, nvec = ((silo.lt, silo.lb, silo.n_left) if side == "left"
                            else (silo.rt, silo.rb, silo.n_right))
        hs_, vs_ = silo.wall_shift[side]
        pts = []
        for fr_ in np.linspace(0.0, 1.0, 40):
            base = np.array(p_dn, float) + fr_ * (np.array(p_up, float)
                                                  - np.array(p_dn, float))
            h_ = silo.height_above_outlet_px(base)
            pts.append(base + nvec * float(np.interp(h_, hs_, vs_)))
        return np.array(pts)

    polys = {s: wall_polyline(s) for s in ("left", "right")}
    cnt = df.groupby("frame").size().sort_values(ascending=False)
    picked, gap = [], max(1, len(cnt) // (n_images * 2 + 1))
    for fr_ in cnt.index:
        if any(abs(fr_ - q) < gap for q in picked):
            continue
        picked.append(int(fr_))
        if len(picked) >= n_images:
            break

    cap = cv2.VideoCapture(video)
    D_mm = silo.outlet_width_mm_corrected()
    for fr_ in sorted(picked):
        cap.set(cv2.CAP_PROP_POS_FRAMES, fr_)
        ok, im = cap.read()
        if not ok:
            continue
        vis = im.copy()
        cv2.line(vis, tuple(np.int32(silo.lt)), tuple(np.int32(silo.lb)),
                 (0, 0, 255), 1)
        cv2.line(vis, tuple(np.int32(silo.rt)), tuple(np.int32(silo.rb)),
                 (0, 0, 255), 1)
        for s in ("left", "right"):
            cv2.polylines(vis, [np.int32(polys[s])], False, (0, 255, 0), 3)
        cv2.line(vis, (0, int(silo.outlet_y_px)),
                 (vis.shape[1], int(silo.outlet_y_px)), (0, 255, 0), 3)
        for kd in (0.5, 1, 2, 3, 4, 6, 8):
            yk = int(silo.outlet_y_px - kd * geom.d_eq_px)
            if yk < 0:
                continue
            cv2.line(vis, (0, yk), (vis.shape[1], yk), (0, 190, 255), 1)
            cv2.putText(vis, f"{kd:g} d", (6, yk - 5),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 190, 255), 1)
        for r in df[df["frame"] == fr_].itertuples():
            col = ((0, 0, 255) if r.wall == "left"
                   else (255, 0, 0) if r.wall == "right" else (170, 170, 170))
            cv2.circle(vis, (int(r.x_px_full), int(r.y_px_full)),
                       max(2, int(r.minor_px / 2)), col, 2)
        sub = vis[y0:y1, x0:x1]
        cv2.putText(sub, f"frame {fr_}   D = {D_mm:.1f} mm "
                         f"(ruler {OUTLET_WIDTH_MM} mm)   "
                         f"{geom.s:.2f} px/mm   d_eq = {geom.d_eq_mm:.2f} mm",
                    (8, 26), cv2.FONT_HERSHEY_SIMPLEX, 0.7, (255, 255, 255), 2)
        pth = os.path.join(outdir, f"calib_check_{fr_:05d}.png")
        cv2.imwrite(pth, cv2.resize(sub, None, fx=1.4, fy=1.4))
        print(f"  已輸出 {pth}")
    cap.release()
    print("  綠粗折線 = 程式在用的壁（已校正）   紅細線 = 你點的原始直線")
    print("  橙線 = 高度刻度   紅圈 = 觸左壁   藍圈 = 觸右壁   灰圈 = 不觸壁")
    print("  請確認：(1) 綠線貼著壁內緣 (2) 貼壁的顆粒有被圈成紅/藍 "
          "(3) 圖上的 D 等於你量的")


def pid_color(pid):
    """由 id 決定一個固定的顏色。

    用黃金比例把色相均勻散開，相鄰的 id 顏色差很多 —— 兩顆萬一被配錯，
    顏色對調會非常明顯。
    """
    hue = int((pid * 137.508) % 180)      # OpenCV 的 H 範圍是 0~179
    c = cv2.cvtColor(np.uint8([[[hue, 220, 255]]]), cv2.COLOR_HSV2BGR)[0, 0]
    return int(c[0]), int(c[1]), int(c[2])


def recompress(path, emit=print):
    """有 ffmpeg 的話用 H.264 重壓。

    OpenCV 只能用 mp4v 編碼（H.264 因為授權問題沒有內建），壓縮效率非常差 ——
    實測 987 幀的 960x600 會產生 108 MB，重壓後約 2 MB，畫質看不出差別。
    """
    import shutil
    import subprocess
    if not shutil.which("ffmpeg") or not os.path.exists(path):
        return
    raw_mb = os.path.getsize(path) / 1e6
    tmp = path.replace(".mp4", "_h264.mp4")
    r = subprocess.run(["ffmpeg", "-y", "-v", "error", "-i", path,
                        "-c:v", "libx264", "-crf", "23",
                        "-pix_fmt", "yuv420p", tmp], capture_output=True)
    if r.returncode == 0 and os.path.exists(tmp):
        os.replace(tmp, path)
        emit(f"  已用 ffmpeg 重壓：{raw_mb:.0f} MB → "
             f"{os.path.getsize(path)/1e6:.1f} MB")


def draw_silo(img, silo, geom, to_disp, width=None):
    """把校正後的壁線、出口線、分析窗上緣畫上去。"""
    for side in ("left", "right"):
        p_up, p_dn, nvec = ((silo.lt, silo.lb, silo.n_left) if side == "left"
                            else (silo.rt, silo.rb, silo.n_right))
        hs_, vs_ = silo.wall_shift[side]
        pts = []
        for fr_ in np.linspace(0.0, 1.0, 40):
            base = np.array(p_dn, float) + fr_ * (np.array(p_up, float)
                                                  - np.array(p_dn, float))
            h_ = silo.height_above_outlet_px(base)
            q = base + nvec * float(np.interp(h_, hs_, vs_))
            pts.append(to_disp(q[0], q[1]))
        cv2.polylines(img, [np.int32(pts)], False, (0, 255, 0), 2)
    w = width if width is not None else img.shape[1]
    y_out = to_disp(0, silo.outlet_y_px)[1]
    cv2.line(img, (0, y_out), (w, y_out), (0, 255, 0), 2)
    y_win = to_disp(0, silo.outlet_y_px
                    - ANALYSIS_HEIGHT_FACTOR * geom.d_eq_px)[1]
    for xd in range(0, w, 20):
        cv2.line(img, (xd, y_win), (xd + 10, y_win), (0, 220, 255), 1)


def write_overlay(video, roi, df, out_path, limit, geom, silo=None,
                  fps_capture=120.0, scale=1.0):
    """把 ID、軌跡尾巴、筒倉幾何疊回原片。

    這是唯一能用眼睛確認追蹤沒配錯的方法。怎麼看：
      1. 同一顆的顏色應該從頭到尾不變。顏色一直變 = 追蹤一直斷掉重編號
      2. 尾巴應該平滑。尾巴突然跳到別處 = 配對配錯
      3. 貼著壁的顆粒應該有白框。沒有的話壁線歪了，程式二會找不到鏈
      4. 偵測失效的幀應該標成 occluded 且畫面上沒有橢圓
    """
    print(f"\n輸出追蹤疊圖影片…")
    x0, y0, x1, y1 = roi
    ow = int(round((x1 - x0) * scale))
    oh = int(round((y1 - y0) * scale))
    cap = cv2.VideoCapture(video)
    # 幀率固定 30：120 fps 的疊圖影片看不清楚，而且 OpenCV 的 mp4v 編碼器在
    # 幀率不是整數又大於 65535/1000 時會直接開不起來（119.917 就會失敗）。
    vw = cv2.VideoWriter(out_path, cv2.VideoWriter_fourcc(*"mp4v"),
                         30.0, (ow, oh))
    if not vw.isOpened():
        print(f"  ⚠ VideoWriter 開不起來（{ow}x{oh}），跳過影片輸出")
        cap.release()
        return

    def to_disp(xf, yf):
        return (int(round((xf - x0) * scale)), int(round((yf - y0) * scale)))

    by_frame = {f: g for f, g in df.groupby("frame")}
    tails = {}
    for idx in range(limit):
        ok, frame = cap.read()
        if not ok:
            break
        img = cv2.resize(frame[y0:y1, x0:x1], (ow, oh))
        if silo is not None:
            draw_silo(img, silo, geom, to_disp, width=ow)

        g = by_frame.get(idx)
        seen = set()
        state = "?"
        if g is not None and len(g):
            state = str(g["state"].iloc[0]) if "state" in g.columns else "?"
            for r in g.itertuples():
                tid = int(r.id)
                seen.add(tid)
                c = pid_color(tid)
                ctr = to_disp(r.x_px_full, r.y_px_full)
                axes = (max(1, int(r.minor_px * scale / 2)),
                        max(1, int(r.major_px * scale / 2)))
                ang = 0.0 if np.isnan(r.theta_deg) else float(r.theta_deg)
                cv2.ellipse(img, ctr, axes, ang, 0, 360, c, 2)
                if getattr(r, "wall", "none") in ("left", "right"):
                    cv2.ellipse(img, ctr, axes, ang, 0, 360, (255, 255, 255), 3)
                    cv2.ellipse(img, ctr, axes, ang, 0, 360, c, 1)
                # 軌跡尾巴：只連「幀號連續」的點，否則顆粒消失幾幀又回來
                # 會憑空拉出一條假的長線
                tails.setdefault(tid, []).append((idx, ctr))
                tails[tid] = tails[tid][-VIDEO_TAIL:]
                seg = []
                for (tf, pt) in tails[tid]:
                    if seg and tf != seg[-1][0] + 1:
                        if len(seg) > 1:
                            cv2.polylines(img, [np.int32([p for _, p in seg])],
                                          False, c, 2)
                        seg = []
                    seg.append((tf, pt))
                if len(seg) > 1:
                    cv2.polylines(img, [np.int32([p for _, p in seg])],
                                  False, c, 2)
        for tid in list(tails.keys()):
            if tid not in seen:
                tails[tid] = tails[tid][1:]
                if not tails[tid]:
                    del tails[tid]

        n_here = 0 if g is None else len(g)
        col = {"flow": (0, 255, 0), "static": (200, 200, 200),
               "occluded": (0, 0, 255)}.get(state, (255, 255, 255))
        lines = [f"frame {idx}   t = {idx / fps_capture * 1000:.1f} ms",
                 f"state: {state}", f"particles {n_here}"]
        cv2.rectangle(img, (0, 0), (300, 16 + 20 * len(lines)), (0, 0, 0), -1)
        for li, txt in enumerate(lines):
            cv2.putText(img, txt, (8, 22 + 20 * li), cv2.FONT_HERSHEY_SIMPLEX,
                        0.5, col if li == 1 else (255, 255, 255), 1)
        vw.write(img)
    vw.release()
    cap.release()
    recompress(out_path)
    print(f"  已存成 {out_path}（{ow}x{oh}）")
    print("  綠線 = 壁與出口（已校正）  黃虛線 = 分析窗上緣")
    print("  彩色橢圓 = 顆粒（顏色由 id 決定）  白框 = 接觸筒倉壁")


if __name__ == "__main__":
    main()
