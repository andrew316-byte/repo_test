def plot_trajectories(df, geom, outdir, fps):
    """顆粒軌跡 XY 圖。

    【y 軸必須反轉】
    影像座標的 y 軸朝下（第 0 列在畫面最上方）。直接 plot(x, y) 會讓筒倉上下
    顛倒 —— 漏斗的尖端會出現在圖的上方。所以要 invert_yaxis()。
    這和計算 θ 時把 y 反號是同一個理由。

    【長寬等比例】
    set_aspect("equal") 不能省。不等比例的話，一條 45° 的軌跡會畫成別的角度，
    而這張圖的用途之一就是看軌跡的方向對不對。

    座標原點是 ROI 的左上角（不是原始影像的左上角）。
    """
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    from matplotlib import font_manager
    from matplotlib.collections import LineCollection

    cjk = ["Microsoft JhengHei", "PingFang TC", "Noto Sans CJK TC",
           "Noto Sans CJK SC", "Heiti TC", "SimHei", "Arial Unicode MS"]
    inst = {f.name for f in font_manager.fontManager.ttflist}
    font = next((f for f in cjk if f in inst), None)
    if font:
        plt.rcParams["font.family"] = font
        plt.rcParams["axes.unicode_minus"] = False
    zh = font is not None
    def T(a, b):
        return a if zh else b

    d = df.copy()
    if TRAJ_FRAME_RANGE is not None:
        lo, hi = TRAJ_FRAME_RANGE
        d = d[(d["frame"] >= lo) & (d["frame"] <= hi)]
    lengths = d.groupby("id").size()
    keep = lengths[lengths >= TRAJ_MIN_LENGTH].sort_values(ascending=False)
    keep = keep.head(TRAJ_MAX_TRACKS)
    d = d[d["id"].isin(keep.index)].sort_values(["id", "frame"])
    if d.empty:
        print("  軌跡圖：沒有夠長的軌跡可畫")
        return

    xlab = T("x  [mm]（原點 = ROI 左下角）", "x [mm] (origin = ROI bottom-left)")
    ylab = T("y  [mm]（向上為正，標準物理座標）", "y [mm] (upward positive)")

    fig, ax = plt.subplots(2, 2, figsize=(14, 12))

    # ---- (1) 全部軌跡，依 ID 上色 ----
    a = ax[0, 0]
    rng = np.random.default_rng(0)
    cmap = plt.get_cmap("hsv")
    for k, (tid, g) in enumerate(d.groupby("id", sort=False)):
        a.plot(g["x_up_mm"], g["y_up_mm"], lw=.6, alpha=.75,
               color=cmap(rng.random()))
    a.set_aspect("equal")
    a.set_xlabel(xlab); a.set_ylabel(ylab)
    a.set_title(T(f"全部軌跡（{len(keep)} 條，長度 ≥ {TRAJ_MIN_LENGTH} 幀）\n"
                  f"顏色只用來區分不同顆粒，無物理意義",
                  f"All trajectories ({len(keep)}), colour = ID only"))

    # ---- (2) 依瞬時速率上色 ----
    a = ax[0, 1]
    segs, vals = [], []
    for tid, g in d.groupby("id", sort=False):
        xy = g[["x_up_mm", "y_up_mm"]].values
        if len(xy) < 2:
            continue
        sp = g["speed_mm_s"].values
        segs.extend(list(zip(xy[:-1], xy[1:])))
        vals.extend(((sp[:-1] + sp[1:]) / 2).tolist())
    vals = np.array(vals)
    # 【為什麼用對數色階】
    # 這個系統的流動是間歇的：大部分時間堵塞（速率中位數約 1.5 mm/s），
    # 雪崩時瞬間衝到數百 mm/s。線性色階下，所有在動的軌跡都會飽和成同一個顏色，
    # 看不出「哪裡比較快」。對數色階才能同時顯示三個數量級。
    pos = vals[vals > 0]
    vlo = max(np.nanpercentile(pos, 5), 1e-3) if len(pos) else 1e-3
    vhi = max(np.nanpercentile(pos, 99.5), vlo * 10) if len(pos) else 1.0
    lc = LineCollection(segs, cmap="viridis", linewidths=.8,
                        norm=matplotlib.colors.LogNorm(vlo, vhi))
    lc.set_array(np.clip(vals, vlo, vhi))
    a.add_collection(lc); a.autoscale()
    a.set_aspect("equal")
    a.set_xlabel(xlab); a.set_ylabel(ylab)
    cb = fig.colorbar(lc, ax=a, fraction=.040)
    cb.set_label(T("瞬時速率 [mm/s]（對數）", "speed [mm/s] (log)"))
    a.set_title(T(f"軌跡依速率上色（對數色階 {vlo:.1f}–{vhi:.0f} mm/s）\n"
                  f"流動是間歇的，線性色階會全部飽和",
                  f"Trajectories coloured by speed (log scale)"))

    # ---- (3) 平均速度場（空間分箱後的向量圖）----
    a = ax[1, 0]
    m = d["vx_mm_s"].notna() & d["vy_mm_s"].notna()
    dd = d[m]
    nb = TRAJ_QUIVER_BINS
    xe = np.linspace(dd["x_up_mm"].min(), dd["x_up_mm"].max(), nb + 1)
    ye = np.linspace(dd["y_up_mm"].min(), dd["y_up_mm"].max(), nb + 1)
    ix = np.clip(np.digitize(dd["x_up_mm"], xe) - 1, 0, nb - 1)
    iy = np.clip(np.digitize(dd["y_up_mm"], ye) - 1, 0, nb - 1)
    cnt = np.zeros((nb, nb)); sx = np.zeros((nb, nb)); sy = np.zeros((nb, nb))
    np.add.at(cnt, (iy, ix), 1)
    np.add.at(sx, (iy, ix), dd["vx_mm_s"].values)
    # vy_mm_s 是影像座標（y 朝下）的速度，物理座標 y 朝上，所以要反號
    np.add.at(sy, (iy, ix), -dd["vy_mm_s"].values)
    ok = cnt >= 20
    xc = (xe[:-1] + xe[1:]) / 2
    yc = (ye[:-1] + ye[1:]) / 2
    X, Y = np.meshgrid(xc, yc)
    U = np.where(ok, sx / np.maximum(cnt, 1), np.nan)
    V = np.where(ok, sy / np.maximum(cnt, 1), np.nan)
    mag = np.hypot(U, V)
    # 箭頭長度正規化：讓最長的箭頭約等於 1.5 個分箱寬度，否則不是看不見就是糊成一團
    binw = xc[1] - xc[0]
    # 用 95 百分位而非最大值：實測有單一分箱的平均速率衝到 400+ mm/s，
    # 用最大值當比例尺會讓其餘所有箭頭縮成看不見的小點。
    ref = np.nanpercentile(mag, 95) if np.isfinite(mag).any() else 1.0
    scale = max(ref, 1e-6) / (1.5 * binw)
    # 【箭頭的 y 分量】已經在上面累加時反過號了（影像 y 朝下 → 物理 y 朝上），
    # 這裡直接傳 V，而且圖也不再 invert_yaxis，所以負的 V 自然畫成向下。
    # 舊版註解保留在下方作為歷史紀錄：
    # vy > 0 代表影像 y 增加 = 顆粒往下掉（實測：移動中的顆粒 vy 平均 +92.5 mm/s，
    # 70.9% 為正；最長軌跡的 y 從 6.7 走到 48.8 mm，確認往下）。
    # 這張圖已經 invert_yaxis()，傳正的 V 畫出來就是向下。
    # 曾經在這裡傳 -V，結果箭頭全部指向上方 —— 等於反了兩次。
    qv = a.quiver(X, Y, U, V, mag, cmap="plasma", angles="xy",
                  scale_units="xy", pivot="mid", scale=scale,
                  width=0.004, headwidth=3.5, headlength=4)
    a.set_aspect("equal")
    a.set_xlabel(xlab); a.set_ylabel(ylab)
    cb = fig.colorbar(qv, ax=a, fraction=.040)
    cb.set_label(T("平均速率 [mm/s]", "mean speed [mm/s]"))
    a.set_title(T(f"平均速度場（{nb}×{nb} 空間分箱，每箱至少 20 筆）\n"
                  f"箭頭應指向下方並匯聚到出口（比例尺用 95 百分位，長箭頭會被截斷）",
                  f"Mean velocity field ({nb}x{nb} bins)"))

    # ---- (4) 最長的幾條軌跡，依時間上色 ----
    a = ax[1, 1]
    top = keep.head(TRAJ_N_HIGHLIGHT).index
    for tid in top:
        g = d[d["id"] == tid]
        sc = a.scatter(g["x_up_mm"], g["y_up_mm"], c=g["t_sec"], cmap="coolwarm",
                       s=3, zorder=3)
        a.plot(g["x_up_mm"], g["y_up_mm"], lw=.5, color="0.6", zorder=2)
        a.annotate(f"#{int(tid)}", (g["x_up_mm"].iloc[0], g["y_up_mm"].iloc[0]),
                   fontsize=8, color="k")
    a.set_aspect("equal")
    a.set_xlabel(xlab); a.set_ylabel(ylab)
    cb = fig.colorbar(sc, ax=a, fraction=.040)
    cb.set_label(T("時間 [s]", "time [s]"))
    a.set_title(T(f"最長的 {len(top)} 條軌跡（顏色 = 時間）\n"
                  f"檢查重點：有沒有「瞬間跳到遠處」的線段 = ID 配錯",
                  f"{len(top)} longest tracks (colour = time)"))

    fig.tight_layout()
    fig.savefig(os.path.join(outdir, "trajectories_xy.png"), dpi=130)
    plt.close(fig)
    print(f"  軌跡圖已存到 {outdir}/trajectories_xy.png")


