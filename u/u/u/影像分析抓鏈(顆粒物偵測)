# 階段 4：後處理
# ==========================================================================

def unwrap180(series):
    """沿軌跡把朝向展開成連續值。

    θ 的定義域是 [0°, 180°)，179° → 1° 實際只轉了 +2°。
    不展開的話，數值微分會噴出 ±180° 的假尖峰。
    """
    s = np.asarray(series, float)
    out = s.copy()
    for i in range(1, len(s)):
        d = out[i] - out[i - 1]
        while d > 90:
            out[i] -= 180; d = out[i] - out[i - 1]
        while d < -90:
            out[i] += 180; d = out[i] - out[i - 1]
    return out


def sg_derivative(y, window, order):
    """Savitzky-Golay 一階導數：在視窗內擬合多項式再取導數。

    兩幀差分會把量測雜訊原封不動放大成速度雜訊。SG 在 window 幀內做最小平方
    擬合再微分，等於先低通再求導。
    視窗必須明顯小於特徵時間 δt = 0.018s × FPS 幀，否則會抹掉真實訊號。
    """
    from scipy.signal import savgol_filter
    n = len(y)
    if n < window:
        if n < 2:
            return np.full(n, np.nan)
        return np.gradient(y)
    return savgol_filter(y, window, order, deriv=1, mode="interp")


def theilsen_derivative(y, window):
    """Theil-Sen 一階導數：視窗內「所有點對的斜率」取中位數。

    【公式】對視窗內的點 (t_i, y_i)：
        slope = median_{i<j}  (y_j − y_i) / (t_j − t_i)
    因為這裡的 t 就是幀號、間隔固定為 1，分母就是 j − i。

    【為什麼不用 Savitzky-Golay】
    SG 是最小平方擬合後微分，而最小平方的崩潰點（breakdown point）是 0% ——
    一個離群點就能把整條擬合線拉歪，而且權重是平方級的。Theil-Sen 取的是
    中位數，崩潰點 50%，要污染它得有超過一半的點對是壞的。
    9756 實測：靜止幀逐幀位移中位數 0.214 px，但 p95 = 3.65 px、最大 35.3 px，
    542 條軌跡有 476 條出現過 >10 px 的跳動 —— 正是最小平方最怕的那種污染。

    【NaN 的處理】含 NaN 的點對直接跳過（np.nanmedian）。這讓「壞幀的位置先
    設成 NaN」這個做法可以無痛運作：壞點不會參與任何點對。

    【參數】
      y      : 一條軌跡的某個座標序列（例如 x_px），長度 n
      window : 視窗長度（奇數幀）。視窗要明顯小於 δt = 0.018 s × FPS 幀。
    【回傳】長度 n 的導數序列，單位是「每幀」。
    """
    n = len(y)
    y = np.asarray(y, float)
    if n < 2:
        return np.full(n, np.nan)
    w = min(window, n if n % 2 else n - 1)
    if w < 3:
        w = 3
    h = w // 2                      # 視窗半徑
    # 預先算好視窗內所有點對的 (i, j)，迴圈裡就不用重算
    ii, jj = np.triu_indices(w, k=1)
    dt = (jj - ii).astype(float)    # 兩點的幀距，就是分母
    out = np.full(n, np.nan)
    for c in range(n):
        s = max(0, c - h)
        e = min(n, s + w)
        s = max(0, e - w)           # 靠近兩端時把視窗往內推，長度維持 w
        seg = y[s:e]
        if len(seg) < w:            # 序列本身比視窗短
            m = ~np.isnan(seg)
            if m.sum() < 2:
                continue
            t = np.arange(len(seg))[m]
            v = seg[m]
            a, b = np.triu_indices(len(v), k=1)
            out[c] = np.nanmedian((v[b] - v[a]) / (t[b] - t[a]))
            continue
        out[c] = np.nanmedian((seg[jj] - seg[ii]) / dt)
    return out


def velocity_derivative(y, window):
    """依 VELOCITY_METHOD 選用 Theil-Sen（穩健）或 Savitzky-Golay（舊行為）。"""
    if VELOCITY_METHOD == "theilsen":
        return theilsen_derivative(y, window)
    return sg_derivative(y, window, SG_ORDER)


def postprocess(df, geom, fps):
    """逐軌跡計算速度與朝向展開。

    【斷鏈的處理 —— 這裡曾經有 bug】
    顆粒偶爾會有幾幀偵測不到，軌跡的 frame 欄因此不連續（例如 10, 11, 14, 15）。
    如果直接把這些列當成相鄰幀做微分，10→14 的位移會被當成一幀的位移，
    速度被灌水 3 倍。實測這個 bug 讓「最大位移」出現 54.7 px/frame，
    遠超過連結時的搜尋半徑 21.6 px —— 物理上不可能，是純粹的計算錯誤。

    正確做法：把每條軌跡重新索引到連續的幀格點上，缺的幀用線性內插補上
    （標記 interpolated=True），再做微分。補出來的列不列入 σ_c 的統計。
    """
    df = df.sort_values(["id", "frame"]).reset_index(drop=True)

    df["aspect_ratio"] = df["major_px"] / df["minor_px"]
    df["r_eq_px"] = np.sqrt(df["major_px"] * df["minor_px"]) / 2.0   # 等效半徑 √(ab)/2

    # theta_raw_deg：不論是不是圓盤都保留原始角度，只給品質診斷用
    # （長軸方向集中度需要它）。物理分析請用 theta_deg，圓盤時會是 NaN。
    df["theta_raw_deg"] = df["theta_deg"]

    # 圓盤沒有朝向，fitEllipse 回傳的角度是純雜訊，不要讓它汙染後續分析
    measured_ar = df["aspect_ratio"].median()
    is_disc = measured_ar < AR_CIRCLE_THRESHOLD
    if is_disc:
        df["theta_deg"] = np.nan
        print(f"  量到的長寬比中位數 {measured_ar:.3f} < {AR_CIRCLE_THRESHOLD} "
              f"→ 判定為圓盤，朝向欄位設為 NaN")

    num_cols = ["x_px", "y_px", "major_px", "minor_px", "theta_deg",
                "theta_raw_deg", "area_px", "aspect_ratio", "r_eq_px",
                "fit_residual"]
    parts = []
    for tid, g in df.groupby("id", sort=False):
        g = g.set_index("frame")
        full = np.arange(int(g.index.min()), int(g.index.max()) + 1)
        gaps = len(full) - len(g)
        g = g.reindex(full)                       # 缺的幀變成 NaN 列
        g["interpolated"] = g["x_px"].isna()
        g[num_cols] = g[num_cols].interpolate(method="linear", limit_direction="both")
        g["id"] = tid
        g["n_measured"] = int((~g["interpolated"]).sum())
        g["n_gap"] = gaps
        g["track_length"] = len(g)

        if len(g) >= 2:
            # 【VEL_ONLY_CLEAN】算速度前先把品質不佳的那幾幀的位置換成 NaN。
            # Theil-Sen 會自動跳過含 NaN 的點對，所以壞掉的質心不會參與。
            # 判準：區域面積離理論值太遠（分割失敗），或自由擬合的形狀離 α 太遠。
            xs, ys = g["x_px"].values.copy(), g["y_px"].values.copy()
            if VEL_ONLY_CLEAN:
                ar_ = g["area_px"].values / geom.area
                bad = (ar_ < DETECT_AREA_LO) | (ar_ > DETECT_AREA_HI)
                if "aspect_ratio_free" in g.columns:
                    fr_ = g["aspect_ratio_free"].values
                    bad |= np.where(np.isnan(fr_), False,
                                    np.abs(fr_ - geom.alpha) > DETECT_AR_DEV)
                bad |= g["interpolated"].values       # 內插出來的不是量測值
                if bad.all():                         # 全壞就不篩，免得整條沒速度
                    bad = np.zeros_like(bad)
                xs[bad] = np.nan
                ys[bad] = np.nan
            g["vx_px_per_frame"] = velocity_derivative(xs, VEL_WINDOW)
            g["vy_px_per_frame"] = velocity_derivative(ys, VEL_WINDOW)
            # 給 σ_c 用的原始兩幀差分（不經平滑），只在兩端都是實測時有效
            raw = ~g["interpolated"].values
            dx = np.diff(g["x_px"].values, prepend=np.nan)
            dy = np.diff(g["y_px"].values, prepend=np.nan)
            valid = np.r_[False, raw[1:] & raw[:-1]]
            g["dx_raw"] = np.where(valid, dx, np.nan)
            g["dy_raw"] = np.where(valid, dy, np.nan)
        else:
            for c in ("vx_px_per_frame", "vy_px_per_frame", "dx_raw", "dy_raw"):
                g[c] = np.nan

        g["theta_unwrapped_deg"] = (np.nan if is_disc
                                    else unwrap180(g["theta_deg"].values))
        parts.append(g.reset_index().rename(columns={"index": "frame"}))

    df = pd.concat(parts, ignore_index=True)

    df["t_sec"] = df["frame"] / fps
    df["x_mm"] = df["x_px"] / geom.s
    df["y_mm"] = df["y_px"] / geom.s
    df["major_mm"] = df["major_px"] / geom.s
    df["minor_mm"] = df["minor_px"] / geom.s
    df["r_eq_mm"] = df["r_eq_px"] / geom.s

    # 【物理座標：原點左下角、y 朝上】
    # 影像座標的 y 朝下，是感光元件的掃描順序，不是物理。重力應指向 −y，
    # 出口在筒倉底部，y 該往上長。而且計算 θ 時本來就已經用 y 朝上的慣例
    # （link_angle 裡把 y 反號），只有畫圖還留在 y 朝下，同一份資料兩套慣例。
    # 這裡補一組物理座標，畫圖與後續力鏈分析都用它。
    #   x_up_mm = x_mm                       （x 方向兩者相同）
    #   y_up_mm = (ROI 高度 − y_px) / s      （翻轉後以 ROI 底邊為 y = 0）
    # 原本的 x_mm / y_mm 保留，方便回頭對照原始影片的像素位置。
    df["x_up_mm"] = df["x_mm"]
    df["y_up_mm"] = (ROI_HEIGHT_PX[0] - df["y_px"]) / geom.s

    # 【全圖座標】幾何標定是在整張影像上點的，顆粒座標卻是 ROI 座標，
    # 所以這裡補一組全圖座標，壁接觸與物理座標都用它。
    df["x_px_full"] = df["x_px"] + ROI_OFFSET[0]
    df["y_px_full"] = df["y_px"] + ROI_OFFSET[1]

    # 壁接觸用的朝向：圓盤的 theta_deg 已被設成 NaN（那是正確的，圓盤沒有朝向），
    # 但支撐函數需要一個值。圓盤時 A = B，給什麼都一樣，所以直接沿用原始角度。
    df["theta_for_wall_deg"] = df["theta_raw_deg"]

    # 【注意】固定形狀擬合會把 aspect_ratio 鎖成 α，所以它的偏差恆為 0，
    # 拿它算 shape_outlier 會永遠是 False —— 那是假的「品質變好」。
    # 形狀偏差一律以「自由擬合量到的長寬比」為準；沒有這一欄時才退回舊欄位。
    _ar_src = ("aspect_ratio_free"
               if ("aspect_ratio_free" in df.columns
                   and df["aspect_ratio_free"].notna().any())
               else "aspect_ratio")
    df["ar_deviation"] = (df[_ar_src] - geom.alpha).abs()
    df["shape_outlier"] = df["ar_deviation"] >= AR_DEV_THRESHOLD
    # area_ratio = 區域面積 / 理論面積（π·a_px·b_px/4）。
    # 【這一欄是標定的警報器】分母是「設計值 × 比例尺」算出來的外部常數，
    # 不隨偵測結果浮動。所以它偏離 1.0 就代表 B_MM 或 px_per_mm 有一個不對。
    # 實測 9756 舊版量到 1.21，那其實是比例尺低估 9.3% 的平方（1.093²=1.195）
    # —— 這個數字當時就已經在報警，只是沒人聽懂。
    df["area_ratio"] = df["area_px"] / geom.area
    _arm = float(df.loc[~df["interpolated"], "area_ratio"].median())
    if abs(_arm - 1.0) > AREA_RATIO_WARN:
        print(f"  ⚠ area_ratio 中位數 {_arm:.3f}，偏離 1.0 超過 "
              f"{100*AREA_RATIO_WARN:.0f}%")
        print(f"    代表 B_MM（{B_MM} mm）或比例尺（{geom.s:.4f} px/mm）"
              f"有一個不對。")
        print(f"    由面積反推的顆粒直徑 = "
              f"{2*np.sqrt(df.loc[~df['interpolated'],'area_px'].median()/np.pi)/geom.s:.2f} mm")
    else:
        print(f"  area_ratio 中位數 {_arm:.3f} ✓（標定自洽）")
    df["speed_px_per_frame"] = np.hypot(df["vx_px_per_frame"], df["vy_px_per_frame"])
    df["vx_mm_s"] = df["vx_px_per_frame"] / geom.s * fps
    df["vy_mm_s"] = df["vy_px_per_frame"] / geom.s * fps
    df["speed_mm_s"] = df["speed_px_per_frame"] / geom.s * fps
    df["short_track"] = df["track_length"] < MIN_TRACK_LENGTH
    return df


def measure_centroid_noise(df, geom):
    """從「幾乎靜止」的幀估計質心量測誤差 σ_c。

    堵塞期顆粒不動，量到的任何位移都是純量測雜訊。這是最可信的 σ_c 校正，
    不需要任何假設。

    σ_c 的用途（自行推導，非 Zhang 論文）：
        σ_φ̇,noise [deg/frame] = 2√2 · (180/π) · σ_c / L = 162 σ_c / L
    其中 L 是相鄰顆粒間距（px）。這個式子沒有 1/Δt，因為 φ̇ 本來就是每幀的量。
    """
    # 用「未經平滑、兩端都是實測」的兩幀差分，不要用 SG 速度
    # （SG 已經平滑過會低估雜訊；內插補出來的列根本沒有量測誤差）
    #
    # 【為什麼要用穩健統計】
    # 洩料時流動是局部的：出口附近在動，上方料堆靜止。即使挑「整幀中位速度
    # 接近零」的幀，裡面仍然混有少數真正在移動的顆粒。用一般的標準差，
    # 這些少數值會把 σ_c 整個拉高（實測從 0.13 被拉到 0.39 px）。
    # 改用 MAD（中位絕對偏差）：σ ≈ 1.4826 × MAD，對 <25% 的離群值免疫。
    med = df.groupby("frame")["speed_px_per_frame"].median()
    still = med[med < 0.05].index
    if len(still) < 10:
        return None
    sub = df[df["frame"].isin(still) & ~df["interpolated"]]
    dx, dy = sub["dx_raw"].dropna().values, sub["dy_raw"].dropna().values
    if len(dx) < 100:
        return None

    def robust_sd(v):
        return 1.4826 * np.median(np.abs(v - np.median(v)))

    sd = np.sqrt((robust_sd(dx) ** 2 + robust_sd(dy) ** 2) / 2)
    sigma_c = sd / np.sqrt(2)      # 兩幀各貢獻一次獨立誤差
    return dict(n_still_frames=len(still), n_pairs=len(dx), sigma_c=sigma_c,
                sd_naive=np.sqrt((dx.std()**2 + dy.std()**2) / 2) / np.sqrt(2),
                L=geom.b_px, phidot_noise=162 * sigma_c / geom.b_px)



