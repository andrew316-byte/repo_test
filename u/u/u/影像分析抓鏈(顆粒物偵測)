def robust_sd(v):
    """MAD 穩健標準差：σ ≈ 1.4826 × 中位絕對偏差。對 <25% 的離群值免疫。

    這裡一律用穩健統計而不是一般標準差，因為形狀誤差的分布有長尾
    （少數嚴重失敗的區域 AR 可以到 20 以上），一般標準差會被它們主導，
    反映不出「典型」的量測精度。
    """
    v = np.asarray(v, float)
    v = v[np.isfinite(v)]
    if len(v) < 3:
        return np.nan
    return 1.4826 * np.median(np.abs(v - np.median(v)))


def orientation_concentration(theta_deg):
    """長軸方向的集中度 |⟨exp(2iθ)⟩|，以及優勢方向。

    用 2θ 是因為橢圓的朝向有 180° 週期性（θ 和 θ+180° 是同一個方向）。

    0 = 方向完全隨機 → 殘餘的形狀誤差是隨機的
    1 = 全部朝同一方向 → 影像有系統性的幾何變形（透視、鏡頭各向異性、
        輸出縮放時的非等比插值），這是可以也應該從硬體面修掉的
    """
    t = np.asarray(theta_deg, float)
    t = t[np.isfinite(t)]
    if len(t) < 10:
        return np.nan, np.nan
    m = np.mean(np.exp(2j * np.deg2rad(t)))
    return float(abs(m)), float(np.rad2deg(np.angle(m)) / 2 % 180.0)


def per_frame_quality(df, geom, seg_diag):
    """逐幀品質指標。回傳一個 DataFrame，每幀一列。

    合併兩類資訊：
      - 分割階段的 seg_diag（Otsu 閾值、種子數、前景佔比、dist/r）
      - 偵測結果的形狀統計（半徑、長寬比、異常計數）
    """
    meas = df[~df["interpolated"]]
    rows = []
    for frame, g in meas.groupby("frame"):
        n = len(g)
        th_conc, th_dir = orientation_concentration(g["theta_raw_deg"])
        rows.append(dict(
            frame=int(frame),
            n_measured=n,
            # --- 形狀精度：中位數/MAD（穩健）與 平均/標準差（常規）都給 ---
            r_eq_median_px=g["r_eq_px"].median(),
            r_eq_mad_px=robust_sd(g["r_eq_px"]),
            r_eq_mean_px=g["r_eq_px"].mean(),
            r_eq_std_px=g["r_eq_px"].std(),
            r_eq_median_mm=g["r_eq_px"].median() / geom.s,
            r_eq_mad_mm=robust_sd(g["r_eq_px"]) / geom.s,
            r_eq_mean_mm=g["r_eq_px"].mean() / geom.s,
            r_eq_std_mm=g["r_eq_px"].std() / geom.s,
            r_eq_bias_pct=100 * (g["r_eq_px"].median() - geom.rb) / geom.rb,
            major_median_mm=g["major_px"].median() / geom.s,
            minor_median_mm=g["minor_px"].median() / geom.s,
            ar_median=g["aspect_ratio"].median(),
            ar_mad=robust_sd(g["aspect_ratio"]),
            ar_mean=g["aspect_ratio"].mean(),
            ar_std=g["aspect_ratio"].std(),
            ar_bias=g["aspect_ratio"].median() - geom.alpha,
            # --- 異常計數 ---
            n_shape_outlier=int(g["shape_outlier"].sum()),
            frac_shape_outlier=float(g["shape_outlier"].mean()),
            n_ar_gt_fixed=int((g["aspect_ratio"] > AR_FIXED_THRESHOLD).sum()),
            n_area_small=int((g["area_ratio"] < AREA_BIN_SMALL).sum()),
            n_area_large=int((g["area_ratio"] > AREA_BIN_LARGE).sum()),
            # --- 系統性變形 ---
            theta_concentration=th_conc,
            theta_dominant_deg=th_dir,
        ))
    q = pd.DataFrame(rows)
    q = q.merge(pd.DataFrame(seg_diag), on="frame", how="outer").sort_values("frame")

    # --- 面積守恆：獨立於分割演算法的檢查 ---
    # 把二值化的前景總面積換算成「相當於幾顆」，再和實際偵測到的顆數比。
    # >1 = 有前景面積沒被歸給任何顆粒（漏抓，或邊緣被多算）
    # <1 = 重複計數
    roi_px = q["roi_area_px"].iloc[0] if "roi_area_px" in q else np.nan
    q["implied_n"] = q["fg_fraction"] * roi_px / geom.area
    q["area_conservation"] = q["implied_n"] / q["n_measured"].clip(lower=1)

    # --- 顆數的幀間跳動 ---
    q["dn"] = q["n_measured"].diff().abs()
    q["dn_rel"] = q["dn"] / q["n_measured"].clip(lower=1)
    roll = q["n_measured"].rolling(31, center=True, min_periods=5).median()

    # --- 壞幀標記（只標記，不刪除）---
    # 「顆粒太少」要先判，而且其他判準在這種幀上不計分 ——
    # 否則同一件事（料放完了）會被重複算成四五個不同的「問題」。
    q["bad_too_few"] = q["n_measured"] < BAD_MIN_PARTICLES
    enough = ~q["bad_too_few"]
    q["bad_count_drop"] = enough & (q["n_measured"] < BAD_COUNT_DROP * roll)
    q["bad_count_jump"] = enough & (q["dn_rel"] > BAD_COUNT_JUMP)
    q["bad_area_cons"] = enough & ~q["area_conservation"].between(
        BAD_AREA_CONS_LO, BAD_AREA_CONS_HI)
    q["bad_shape"] = enough & (q["frac_shape_outlier"] > BAD_AR_DEV_FRAC)
    q["bad_merge"] = enough & (q["dist_over_r"] > BAD_DIST_OVER_R)
    flags = ["bad_too_few", "bad_count_drop", "bad_count_jump", "bad_area_cons",
             "bad_shape", "bad_merge"]
    q[flags] = q[flags].fillna(False)
    q["n_bad_flags"] = q[flags].sum(axis=1)
    q["bad_frame"] = q["n_bad_flags"] > 0
    q["bad_reason"] = q[flags].apply(
        lambda r: ",".join(c.replace("bad_", "") for c in flags if r[c]) or "", axis=1)
    return q


def overall_quality(df, q, geom):
    """全片總結。回傳一個 (標題, 內容字串) 的清單，方便同時印出和寫檔。"""
    meas = df[~df["interpolated"]]
    out = []

    # 【固定形狀擬合下的形狀欄位要換掉】
    # 主線把 a、b 鎖成設計值，所以 major_px / minor_px / aspect_ratio 全部是
    # 常數，拿它們做品質報告會印出「誤差 0.0%」這種假的好成績。
    # 這裡把形狀相關的欄位整批換成自由擬合（品保通道）量到的值，報告才誠實。
    # 位置相關的欄位（x、y、速度）不換，因為那些本來就是主線量的。
    _free_ok = ("aspect_ratio_free" in meas.columns
                and meas["aspect_ratio_free"].notna().any())
    if FIXED_SHAPE and _free_ok:
        # 從自由擬合的長寬比 ar 與「主線鎖定的等效直徑 d_eq」反推 a、b：
        #   a = d_eq·√ar ，b = d_eq/√ar  （保持 a·b = d_eq²，與面積一致）
        _ar = meas["aspect_ratio_free"].values
        _deq = geom.d_eq_px
        meas = meas.assign(
            aspect_ratio=_ar,
            major_px=_deq * np.sqrt(_ar),
            minor_px=_deq / np.sqrt(_ar),
        )
        out.append(("形狀欄位的來源",
                    "【注意】主線用固定形狀擬合（a、b 鎖成設計值），所以主線的\n"
                    "長軸／短軸／長寬比全是常數，不能拿來評估量測精度。\n"
                    "下面「形狀精度」一節的數字改用品保通道（自由 fitEllipse）\n"
                    "量到的 aspect_ratio_free 推算，那才是真實量到的形狀。\n"
                    "位置、速度、質心雜訊等欄位仍然來自主線，未經替換。\n"
                    "【等效半徑／等效直徑那兩行要跳過】它們是從被鎖死的 a、b\n"
                    "算出來的，系統誤差恆為 0.0%、MAD 恆為 0.000 —— 那是恆真，\n"
                    "不是量得準。要看尺寸準不準，請看「偵測完整性」一節的\n"
                    "area_ratio：它的分母是 B_MM × 比例尺 這個外部常數，\n"
                    "偏離 1.0 就代表那兩個數字有一個不對。\n"))

    # ---------- 形狀精度 ----------
    b_mm, a_mm = geom.b_mm, geom.b_mm * geom.alpha
    # 【表格排版的注意事項】
    # 等效半徑是「半」軸，長軸/短軸是「全」長，直接比絕對標準差會差一個 2 倍，
    # 不公平。所以表裡多列一行「等效直徑 √(ab)」，它和長軸/短軸同量綱，
    # 才是可以直接比較的那一行。
    meas = meas.assign(d_eq_px=np.sqrt(meas["major_px"] * meas["minor_px"]))
    items = [
        # (欄位, px真值, mm真值, 名稱, 有沒有單位)
        # 【注意】固定形狀擬合時，等效半徑/直徑是從被鎖死的 a、b 算出來的，
        # 所以它的「系統誤差」恆為 0.0%、MAD 恆為 0.000。那是恆真，不是滿分。
        # 真正能回答「尺寸量得準不準」的是下面「偵測完整性」一節的 area_ratio
        # ——它的分母是外部常數，偏離 1.0 就代表 B_MM 或比例尺不對。
        ("r_eq_px",      geom.rb,   b_mm / 2, "等效半徑 √(ab)/2", True),
        ("d_eq_px",      geom.b_px, b_mm,     "等效直徑 √(ab) *", True),
        ("major_px",     geom.a_px, a_mm,     "長軸 a   *",      True),
        ("minor_px",     geom.b_px, b_mm,     "短軸 b   *",      True),
        ("area_px",      geom.area, np.pi * (a_mm / 2) * (b_mm / 2), "面積", True),
        ("aspect_ratio", geom.alpha, geom.alpha, "長寬比（無因次）", False),
    ]
    lines = []
    for unit, div, fmt in [("px", 1.0, "{:>11.3f}"), ("mm", geom.s, "{:>11.3f}")]:
        lines.append(f"── 單位：{unit} " + "─" * 56)
        lines.append(f"{'量':<16}{'中位數':>11}{'MAD':>9}{'平均':>11}{'標準差':>9}"
                     f"{'真值':>10}{'系統誤差':>10}{'CV(MAD)':>9}")
        for col, t_px, t_mm, name, has_unit in items:
            if not has_unit and unit == "mm":
                continue
            # 面積是二維量，換算要除以 s²
            d2 = div ** 2 if col == "area_px" else (div if has_unit else 1.0)
            v = meas[col] / d2
            true = (t_px if unit == "px" else t_mm) if has_unit else geom.alpha
            med, mad, mean, sd = v.median(), robust_sd(v), v.mean(), v.std()
            lines.append(f"{name:<14}" + fmt.format(med) + f"{mad:>9.3f}"
                         + fmt.format(mean) + f"{sd:>9.3f}{true:>10.3f}"
                         + f"{100*(med-true)/true:>9.1f}%{100*mad/med:>8.1f}%")
        lines.append("")
    # --- 尺寸/形狀模態分解：解釋為什麼等效量的分散度遠小於長短軸 ---
    la = np.log(meas["major_px"].values)
    lb = np.log(meas["minor_px"].values)
    u, v = (la + lb) / 2, la - lb      # u = log(等效直徑), v = log(長寬比)
    lines.append("* 這三行同量綱，可以直接比較絕對標準差。")
    lines.append("  等效半徑是「半」軸，和長軸/短軸（全長）差一個 2 倍，不要直接比。")
    lines.append("")
    lines.append("── 為什麼等效直徑的分散度比長短軸小 " + "─" * 36)
    lines.append("把 log(a) 和 log(b) 拆成兩個正交模態：")
    lines.append("    尺寸模態 u = (log a + log b)/2 = log(等效直徑)")
    lines.append("    形狀模態 v =  log a − log b    = log(長寬比)")
    lines.append("於是  Var(log a) = Var(u) + Var(v)/4 + Cov(u,v)")
    lines.append("      Var(log b) = Var(u) + Var(v)/4 − Cov(u,v)")
    lines.append("      Var(log 等效直徑) = Var(u)                ← 不含 Var(v) 項")
    lines.append("")
    lines.append(f"    Var(u) = {u.var():.5f}   （尺寸誤差）")
    # 【除以零的防護】固定形狀擬合會讓 a·b 恆等於 d_eq²，於是 Var(u) 嚴格為 0，
    # 直接相除會印出 1e28 這種無意義的數字。Var(u) 太小就不印倍率。
    if u.var() > 1e-9:
        lines.append(f"    Var(v) = {v.var():.5f}   （形狀誤差，是尺寸誤差的 "
                     f"{v.var()/u.var():.1f} 倍）")
    else:
        lines.append(f"    Var(v) = {v.var():.5f}   （形狀誤差）")
        lines.append("    Var(u) = 0 是固定形狀擬合的必然結果（a·b 被鎖成常數），")
        lines.append("    不代表尺寸量得完美。尺寸準不準要看下面的 area_ratio。")
    lines.append("")
    lines.append(f"相對標準差： 等效直徑 {100*np.sqrt(u.var()):.1f}% ， "
                 f"長軸 {100*np.sqrt(la.var()):.1f}% ， 短軸 {100*np.sqrt(lb.var()):.1f}%")
    lines.append("")
    if FIXED_SHAPE and _free_ok:
        lines.append("成因：主線用固定形狀擬合，a·b 被鎖成 d_eq² 這個常數，")
        lines.append("      所以尺寸模態 u 完全沒有變異，全部的誤差都落在形狀模態 v。")
        lines.append("      上面這幾行是用品保通道的 aspect_ratio_free 反推出來的，")
        lines.append("      它描述的是『自由擬合看到的形狀有多分散』。")
    else:
        lines.append("成因：cv2.fitEllipse 擬合出的橢圓面積被輪廓面積綁死")
        ell = np.pi * meas["major_px"] * meas["minor_px"] / 4
        rr = (ell / meas["area_px"])
        lines.append(f"      （橢圓面積/輪廓面積 = {rr.median():.3f}，10-90 百分位 "
                     f"{rr.quantile(.1):.3f}-{rr.quantile(.9):.3f}，幾乎是定值）")
        lines.append("      而輪廓面積又被分水嶺和面積篩選約束住 → a·b 幾乎固定，")
        lines.append("      但 a 和 b 之間怎麼分配是自由的。分割失敗時 a 被拉長、b 被壓扁，")
        lines.append("      乘積幾乎不變 → 等效直徑穩定，長短軸各自劇烈震盪。")
    lines.append("")
    lines.append("【這對你的意義】")
    lines.append("  等效直徑/半徑 = 偵測「尺寸」量得準不準，對分割失敗不敏感")
    lines.append("  長軸、短軸、長寬比 = 偵測「形狀」量得準不準，對分割失敗非常敏感")
    lines.append("  你的研究主題是長寬比 α，所以真正要盯的是後者。")
    lines.append("  等效半徑漂亮不代表形狀量得準 —— 它看不見形狀誤差。")
    lines.append("")
    lines.append("中位數/MAD 是穩健統計（對 <25% 的離群值免疫），描述「典型一顆」量得多準；")
    lines.append("平均/標準差是常規統計，會把少數嚴重失敗的區域一起算進去，描述「整批資料」")
    lines.append("的實際分散程度。兩者差距越大，代表離群值越多。")
    out.append(("形狀精度（真值已知，這些是硬證據）", "\n".join(lines)))

    # ---------- 長寬比分布 ----------
    lines = []
    lines.append(f"α 設定值 = {geom.alpha}，異常判準 = |AR − α| ≥ {AR_DEV_THRESHOLD}")
    lines.append("")
    lines.append("百分位:")
    for p in (50, 75, 90, 95, 99, 99.9):
        lines.append(f"  {p:5.1f}% : {meas['aspect_ratio'].quantile(p/100):.3f}")
    lines.append(f"  最大    : {meas['aspect_ratio'].max():.3f}")
    lines.append("")
    n_out = int(meas["shape_outlier"].sum())
    lines.append(f"形狀異常 |AR − {geom.alpha}| ≥ {AR_DEV_THRESHOLD}: "
                 f"{n_out} / {len(meas)} 筆 ({100*n_out/len(meas):.2f}%)")
    n_fix = int((meas["aspect_ratio"] > AR_FIXED_THRESHOLD).sum())
    lines.append(f"固定門檻 AR > {AR_FIXED_THRESHOLD}: "
                 f"{n_fix} / {len(meas)} 筆 ({100*n_fix/len(meas):.2f}%)")
    out.append(("長寬比分布與異常計數", "\n".join(lines)))

    # ---------- 面積 × 長寬比 交叉分類 ----------
    # 「異常比例」= 該分箱內 shape_outlier 為 True 的比例
    #              = 該分箱內 |AR 量到 − α| ≥ AR_DEV_THRESHOLD 的筆數 / 該分箱總筆數
    bins = [0, AREA_BIN_SMALL, AREA_BIN_LARGE, 2.0, np.inf]
    labs = [f"偏小 <{AREA_BIN_SMALL}", f"正常 {AREA_BIN_SMALL}-{AREA_BIN_LARGE}",
            f"偏大 {AREA_BIN_LARGE}-2.0", "過大 >2.0"]
    cat = pd.cut(meas["area_ratio"], bins, labels=labs)
    tb = meas.groupby(cat, observed=True).agg(
        筆數=("aspect_ratio", "size"),
        AR中位=("aspect_ratio", "median"),
        AR最大=("aspect_ratio", "max"),
        異常比例=("shape_outlier", "mean"))
    tb["異常比例"] = (100 * tb["異常比例"]).round(1)
    body = tb.to_string() + "\n\n"
    body += (f"分箱依據：面積 / 理論面積（理論面積 = π·a·b/4 = {geom.area:.0f} px² "
             f"= {np.pi*(a_mm/2)*(b_mm/2):.1f} mm²）\n")
    body += (f"異常比例 = 該箱內 |AR − α| ≥ {AR_DEV_THRESHOLD} 的筆數 / 該箱總筆數 × 100%\n")
    body += ("注意：這裡的 0.70 / 1.30 是「分類」邊界，不是偵測的篩選門檻\n"
             f"      （篩選門檻是 {AREA_MIN_RATIO} / {AREA_MAX_RATIO}，超出的早就被丟掉了）。")
    out.append(("失敗模式分類（面積偏小+AR高=邊緣碎片；面積偏大+AR高=兩顆沒切開）", body))

    # ---------- 系統性變形 ----------
    lines = []
    # 【這一節只能用「自由擬合」量到的朝向】
    # 主線的 theta_raw_deg 在 α=1 時恆等於 0 —— 匹配濾波只有一個 0° 的模板，
    # 圓盤沒有朝向，所以每一顆的角度都被寫成 0。拿它算集中度必定得到
    # 1.000 @ 0.0°，然後報告就會印出一個根本不存在的「系統性幾何變形」警告。
    # 改用品保通道（自由 fitEllipse）量到的朝向，那才是真的。
    # 實測 9756：全部偵測 0.359 @ 135°、只看乾淨的偵測 0.424 @ 126°。
    _src = None
    if "theta_free_deg" in meas.columns and meas["theta_free_deg"].notna().any():
        _src = meas.loc[meas["aspect_ratio_free"] > geom.alpha + 0.03,
                        "theta_free_deg"]
        lines.append("（資料來源：品保通道的自由擬合朝向）")
    elif not (FIXED_SHAPE and geom.is_disc):
        _src = meas.loc[meas["aspect_ratio"] > geom.alpha + 0.03, "theta_raw_deg"]
    if _src is None or _src.notna().sum() < 10:
        lines.append("主線用固定形狀擬合、α = 1 的圓盤沒有朝向，所以主線的角度")
        lines.append("欄位恆為 0，無法用來檢查幾何變形。品保通道的朝向也不足。")
        lines.append("要看這一項，請確認 QC_INTERVAL > 0 且品保通道有輸出。")
        out.append(("系統性變形檢查", "\n".join(lines)))
        _src = None
    if _src is not None:
        conc, direc = orientation_concentration(_src)
        lines.append(f"長軸方向集中度 |⟨exp(2iθ)⟩| = {conc:.3f}  (0=隨機 ✓, 1=全部同向 ✗)")
        lines.append(f"優勢方向                   = {direc:.1f}°  (0°=水平, 90°=垂直)")
    else:
        conc = 0.0
    if _src is not None and conc > 0.15:
        lines.append("  ⚠ 集中度明顯偏離 0，形狀誤差有方向性 —— 這是系統性的幾何變形")
        lines.append("    （透視、鏡頭各向異性、或輸出時的非等比縮放），不是隨機雜訊。")
        lines.append("    可以從硬體面改善：相機對準 ROI 中心、改用望遠端、避免重新編碼。")
    if _src is not None:
        out.append(("系統性變形檢查", "\n".join(lines)))

    # ---------- 偵測完整性 ----------
    lines = []
    # 【標定自洽性】area_ratio = 區域面積 ÷ 理論面積（π·a_px·b_px/4）。
    # 分母是 B_MM × px_per_mm 算出來的外部常數，不隨偵測結果浮動，
    # 所以這個比值偏離 1.0 就是標定出錯的直接證據。
    _ar = meas["area_ratio"].median()
    _dimp = 2 * np.sqrt(meas["area_px"].median() / np.pi) / geom.s
    lines.append(f"area_ratio（區域面積 ÷ 理論面積） 中位數 {_ar:.3f}"
                 + ("  ✓ 標定自洽" if abs(_ar - 1.0) <= AREA_RATIO_WARN
                    else f"  ⚠ 偏離 1.0 超過 {100*AREA_RATIO_WARN:.0f}%"))
    lines.append(f"  由面積反推的顆粒直徑 = {_dimp:.2f} mm"
                 f"（設定的 B_MM = {geom.b_mm} mm，比例尺 {geom.s:.4f} px/mm）")
    if abs(_ar - 1.0) > AREA_RATIO_WARN:
        lines.append("  → B_MM 或 px_per_mm 有一個不對。比例尺錯 x% 會讓這個")
        lines.append("    比值錯 x²，所以 1.21 對應比例尺錯約 10%。")
    lines.append("")
    ac = q["area_conservation"].dropna()
    lines.append(f"面積守恆比  中位數 {ac.median():.3f}  "
                 f"(10-90 百分位 {ac.quantile(.1):.3f}-{ac.quantile(.9):.3f})")
    lines.append("  前景總面積換算的顆數 / 實際偵測顆數。")
    lines.append("  >1 = 有前景沒被歸給任何顆粒（漏抓，或邊緣被多算一圈）")
    lines.append("  <1 = 重複計數")
    pr = (q["n_measured"] / q["n_seeds"].clip(lower=1)).dropna()
    lines.append(f"面積篩選通過率 中位數 {100*pr.median():.1f}%")
    lines.append(f"顆數幀間跳動  中位數 {q['dn'].median():.1f} 顆, "
                 f"95 百分位 {q['dn'].quantile(.95):.1f} 顆")
    out.append(("偵測完整性（無真值，靠守恆律間接推論）", "\n".join(lines)))

    # ---------- 壞幀 ----------
    lines = []
    nb = int(q["bad_frame"].sum())
    n_few = int(q["bad_too_few"].sum())
    lines.append(f"壞幀 {nb} / {len(q)} ({100*nb/len(q):.1f}%)  "
                 f"※ 只標記，資料完整保留，未刪除任何一列")
    lines.append("")
    lines.append(f"  其中「顆粒太少（< {BAD_MIN_PARTICLES} 顆）」: {n_few} 幀 "
                 f"({100*n_few/len(q):.1f}%)")
    lines.append(f"       其他原因                     : {nb - n_few} 幀 "
                 f"({100*(nb-n_few)/len(q):.1f}%)  ← 這才是演算法層面的問題")
    lines.append("")
    lines.append("「顆粒太少」多半是片頭還沒裝料、片尾料放完、或鏡頭被遮住，")
    lines.append("不是演算法失效。這類幀上所有相對型指標的分母都太小，數值必然失真，")
    lines.append("所以其他判準在這類幀上不計分，避免同一件事被重複算成好幾個問題。")
    lines.append("")
    lines.append("各項原因（可重複）:")
    for c, desc in [("bad_too_few", f"顆粒數 < {BAD_MIN_PARTICLES}"),
                    ("bad_count_drop", f"顆數低於滾動中位數的 {BAD_COUNT_DROP:.0%}"),
                    ("bad_count_jump", f"顆數幀間跳動 > {BAD_COUNT_JUMP:.0%}"),
                    ("bad_area_cons", f"面積守恆比不在 [{BAD_AREA_CONS_LO}, {BAD_AREA_CONS_HI}]"),
                    ("bad_shape", f"形狀異常比例 > {BAD_AR_DEV_FRAC:.0%}"),
                    ("bad_merge", f"dist/r > {BAD_DIST_OVER_R}")]:
        lines.append(f"  {desc:<42} {int(q[c].sum()):5d} 幀")
    lines.append("")
    lines.append("用法：detections.csv 的 bad_frame 欄可以直接篩")
    lines.append("      df = df[~df.bad_frame]   # 排除壞幀")
    out.append(("壞幀標記", "\n".join(lines)))

    # ---------- 追蹤 ----------
    lines = []
    tl = df.groupby("id")["frame"].size()
    tot = tl.sum()
    for lo, hi, lab in [(1, 2, "只有 1 幀"), (2, 5, "2-4 幀"), (5, 20, "5-19 幀"),
                        (20, 100, "20-99 幀"), (100, 10**9, ">= 100 幀")]:
        m = (tl >= lo) & (tl < hi)
        lines.append(f"  {lab:<12} {int(m.sum()):5d} 條   承載 "
                     f"{100*tl[m].sum()/tot:5.1f}% 的資料")
    lines.append("")
    lines.append(f"「承載 X% 的資料」= 該組所有軌跡的幀數總和 / 全部軌跡的幀數總和")
    lines.append(f"  （全部軌跡的幀數總和 = {tot} = 偵測總筆數）")
    lines.append("")
    lines.append(f"ID 總數 {df['id'].nunique()}，但每幀只有 "
                 f"{q['n_measured'].median():.0f} 顆同時存在。")
    lines.append("ID 是只增不減的計數器，軌跡每斷一次就發一個新號，")
    lines.append("所以最大 ID 遠大於顆粒數是正常的。要看追蹤品質請看上面的長度分布：")
    lines.append("長軌跡承載的資料比例越高越好。")
    out.append(("追蹤品質", "\n".join(lines)))
    return out


